lo:M7009T-1 a et:LearningOutcome ;
    rdfs:label "describe the underlying theories on which the finite element method (FEM) is based"@en, "beskriva de bakomliggande teorierna som finita elementmetoden (FEM) baseras på"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7009T-2 a et:LearningOutcome ;
    rdfs:label "describe how and why non-linear mechanical phenomena affect the choice of solution method"@en, "beskriva hur och varför olinjära mekaniska fenomen påverkar val av lösningsmetod"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7009T-3 a et:LearningOutcome ;
    rdfs:label "explain the basic theory behind elasto-plastic constitutive relation"@en, "förklara grundläggande teori bakom elasto-plastiska konstitutiva samband"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7009T-4 a et:LearningOutcome ;
    rdfs:label "explain the basic principles for optimization"@en, "förklara grundläggande principer för optimering"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7009T-5 a et:LearningOutcome ;
    rdfs:label "explain basic contact formulations"@en, "förklara grundläggande kontaktformuleringar"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7009T-6 a et:LearningOutcome ;
    rdfs:label "solve mechanical problems with nonlinear properties"@en, "lösa mekaniska problem med olinjära egenskaper"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7009T-7 a et:LearningOutcome ;
    rdfs:label "identify different load and boundary conditions"@en, "identifiera olika last- och randvillkor"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7009T-8 a et:LearningOutcome ;
    rdfs:label "understand and evaluate different contact types and material parameters"@en, "förstå och utvärdera olika kontakttyper och materialparametrar"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7009T-9 a et:LearningOutcome ;
    rdfs:label "apply FE analysis of structures and components"@en, "tillämpa FE-analys för att analysera en konstruktion eller komponent"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7009T-10 a et:LearningOutcome ;
    rdfs:label "combining CAD and FEM to solve mechanical problems"@en, "kombinera optimeringsverktyg och FEM för att lösa problem"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7009T-11 a et:LearningOutcome ;
    rdfs:label "present results obtained in both written and oral form"@en, "kritiskt granska och presentera erhållna resultat i skriftlig och muntlig form"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7009T-12 a et:LearningOutcome ;
    rdfs:label "Valuation and approach evaluate how the finite element method can be used for dimensioning and product development"@en, "Värdering och förhållningssätt värdera hur finita elementmetoden kan användas för dimensionering och produktutveckling"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7009T-13 a et:LearningOutcome ;
    rdfs:label "relate the role of numerical methods in sustainable development"@en, "relatera numeriska metoders roll inom hållbar utveckling"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7009T-14 a et:LearningOutcome ;
    rdfs:label "reflect and evaluate challenges in finite element analysis"@en, "reflektera och utvärdera över utmaningar inom finita element analys"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7009T-15 a et:LearningOutcome ;
    rdfs:label "feel increased experience of engineering assessments as well as identification and formulation of problems"@en, "känna ökad erfarenhet av ingenjörsmässiga bedömningar samt identifiering och formulering av problemställningar"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

mod:M7009T-0001 a et:Assessment ;
    rdfs:label "Compulsory assignment"@en ;
    et:assessmentType et:assignment ;
    et:moduleCode "0001" ;
    et:credits 7.5 ;
    et:gradeScale "G U 3 4 5" ;
    et:assesses lo:M7009T-1, lo:M7009T-2, lo:M7009T-3, lo:M7009T-4, lo:M7009T-5, lo:M7009T-6, lo:M7009T-7, lo:M7009T-8, lo:M7009T-9, lo:M7009T-10, lo:M7009T-11, lo:M7009T-12, lo:M7009T-13, lo:M7009T-14, lo:M7009T-15 .


# --- M7018M Applied Mathematics ---

c:M7018M a et:Course ;
    schema:courseCode "M7018M" ;
    schema:name "Applied Mathematics"@en, "Tillämpad matematik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:mathematics ;
    schema:coursePrerequisites "The courses M0032M Functions of Several Variables and Computer Tools, M0018M Linear Analysis and M0014M Mathematical Physics, or equivalent courses."@en, "Kurserna M0032M Flervariabelanalys och datorverktyg, M0018M Linjär analys samt M0014M Matematisk fysik, eller motsvarande kurser."@sv ;
    et:entryRequirementNames c:M0014M, c:M0018M, c:M0032M ;
