# --- M7033T Scientific Computing with Applications in Tribology ---

c:M7033T a et:Course ;
    schema:courseCode "M7033T" ;
    schema:name "Scientific Computing with Applications in Tribology"@en, "Numeriska beräkningsmetoder med tillämpningar inom Tribologi"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:machine-elements ;
    schema:coursePrerequisites "Foundation level courses in Mathematics (30 ECTS) Physics (22,5 ECTS) Mechanics (7,5 ECTS) and Fluid Mechanics (7,5 ECTS). It is not a prerequisite to have taken the course C0004M Programming Tools for Numerical Calculations, neither C7005M Numerics for optimisation and PDE. Prior experience of programming in MATLAB is not a requirement but facilitates course work."@en, "Grundläggande kunskaper i: Matematik (30 hp), Fysik (22,5 hp), Hållfasthetslära (7,5 hp) och Strömningslära (7,5 hp). Kursen förutsätter inte att man har läst C0004M Programmeringsverktyg för numeriska beräkningar eller C7005M Numerik för optimering och PDE. Erfarenhet av programmering i MATLAB är inget krav men underlättar genomförandet."@sv ;
    et:entryRequirementNames c:C0004M, c:C7005M ;
    et:hasOutcome lo:M7033T-1, lo:M7033T-2, lo:M7033T-3, lo:M7033T-4, lo:M7033T-5, lo:M7033T-6, lo:M7033T-7, lo:M7033T-8, lo:M7033T-9, lo:M7033T-10, lo:M7033T-11, lo:M7033T-12, lo:M7033T-13, lo:M7033T-14, lo:M7033T-15, lo:M7033T-16, lo:M7033T-17, lo:M7033T-18, lo:M7033T-19, lo:M7033T-20 ;
    et:hasAssessment mod:M7033T-0001, mod:M7033T-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=M7033T> ;
    et:syllabusDecisionDate "2021-02-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M7033T&lasPeriod=221&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M7033T&lasPeriod=221> .

lo:M7033T-1 a et:LearningOutcome ;
    rdfs:label "Divided into 3 categories below, you as a student should after completing the course:"@en .

lo:M7033T-2 a et:LearningOutcome ;
    rdfs:label "Know about some selected state-of-the-art models and simulation methods in contact mechanics, lubrication theory and wear problems, including the main concepts and underlying assumptions."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7033T-3 a et:LearningOutcome ;
    rdfs:label "Understand the concept of the linear complementarity problem (LCP) and the possible application to contact mechanics."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7033T-4 a et:LearningOutcome ;
    rdfs:label "Understand the concept of fast Fourier techniques (FFT) and the application to solve the elastic deformation problem."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7033T-5 a et:LearningOutcome ;
    rdfs:label "Understand the concept of the finite difference method (FDM) and how it can be used for example to solve partial differential equations describing thin film flow problems."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7033T-6 a et:LearningOutcome ;
    rdfs:label "Understand the concepts of verification and validation in the context of scientific computations."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7033T-7 a et:LearningOutcome ;
    rdfs:label "Understand the advantage of a dimensionless model formulation for subsequent numerical analysis."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M7033T-8 a et:LearningOutcome ;
    rdfs:label "Be able to programme numerical solution methods in a structured and conceivable way facilitating simulations of physical processes, particularly in tribology."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7033T-9 a et:LearningOutcome ;
    rdfs:label "Be able to apply the LCP formulation to solve the contact mechanics problem."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7033T-10 a et:LearningOutcome ;
    rdfs:label "Be able to apply the FFT to accelerate the numerical calculation of integral equations, particularly the one describing the elastic deformation problem in contact mechanics."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7033T-11 a et:LearningOutcome ;
    rdfs:label "Be able to apply the FDM to solve partial differential equations, particularly the Reynolds equation governing the pressure build-up in the thin film flow problem in a thrust bearing."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7033T-12 a et:LearningOutcome ;
    rdfs:label "Be able to discretize Archard’s wear equation and solve it numerically."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7033T-13 a et:LearningOutcome ;
    rdfs:label "Be able to verify numerical methods and to validate mathematical models."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7033T-14 a et:LearningOutcome ;
    rdfs:label "Be able to utilize the models and simulation methods to carry out parameter studies."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7033T-15 a et:LearningOutcome ;
    rdfs:label "Have developed your abilities in writing technical reports in English and your skills in oral presentation in English."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7033T-16 a et:LearningOutcome ;
    rdfs:label "Be able to present the obtained results in a clear and comprehensible manner to other engineers."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M7033T-17 a et:LearningOutcome ;
    rdfs:label "Be able to assess accuracy and precision of the implemented simulation methods."@en ;
    et:outcomeCategory et:judgementAndApproach .

lo:M7033T-18 a et:LearningOutcome ;
    rdfs:label "Be able to assess and judge the relevance of the results obtained with the help of models and numerical simulation methods."@en ;
    et:outcomeCategory et:judgementAndApproach .

lo:M7033T-19 a et:LearningOutcome ;
    rdfs:label "Be able to adapt new models suitable to study related problems, with application in Tribology and in other fields."@en ;
    et:outcomeCategory et:judgementAndApproach .

lo:M7033T-20 a et:LearningOutcome ;
    rdfs:label "Use common models and simulation methods to facilitate the development of machine elements and other applications exhibiting tribological contacts."@en ;
    et:outcomeCategory et:judgementAndApproach .

mod:M7033T-0001 a et:Assessment ;
    rdfs:label "Assignments"@en ;
    et:assessmentType et:assignment ;
    et:moduleCode "0001" ;
    et:credits 5.0 ;
    et:gradeScale "U G#" .

mod:M7033T-0003 a et:Assessment ;
    rdfs:label "Online examination"@en ;
    et:assessmentType et:otherAssessment ;
    et:moduleCode "0003" ;
    et:credits 2.5 ;
    et:gradeScale "G U 3 4 5" .


# --- R0004E Modelling and Control ---

c:R0004E a et:Course ;
    schema:courseCode "R0004E" ;
    schema:name "Modelling and Control"@en, "Modellering och reglering"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:automatic-control ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and Basic knowledge about the Laplace transform, for example as acquired in the course M0018M Linear Analysis, 7,5 ECTS or S0004E Signals and Systems, 7,5 ECTS. Knowledge about physics corresponding to the course F0004T Physics 1, 7,5 ECTS"@en, "Grundläggande behörighet samt Grundläggande kunskaper om Laplacetransformen, exempelvis från kursen M0018M Linjär Analys, 7,5 hp eller S0004E Signaler och system 7,5 hp. Kunskaper om fysik motsvarande kursen F0004T Fysik 1, 7,5 hp"@sv ;
    et:entryRequirementNames c:F0004T, c:M0018M, c:S0004E ;
    et:hasOutcome lo:R0004E-1, lo:R0004E-2, lo:R0004E-3, lo:R0004E-4, lo:R0004E-5, lo:R0004E-6, lo:R0004E-7, lo:R0004E-8 ;
    et:hasAssessment mod:R0004E-0004, mod:R0004E-0005, mod:R0004E-0006 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=R0004E> ;
    et:syllabusDecisionDate "2026-02-13"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R0004E&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R0004E&lasPeriod=227> .

lo:R0004E-1 a et:LearningOutcome ;
    rdfs:label "be able to define basic control techniques and terminology."@en .

lo:R0004E-2 a et:LearningOutcome ;
    rdfs:label "demonstrate basic knowledge about proven methods for design of feedback controllers."@en .

lo:R0004E-3 a et:LearningOutcome ;
    rdfs:label "demonstrate the ability to model and simulate dynamic systems based on balance equations and constitutive relationships."@en .

lo:R0004E-4 a et:LearningOutcome ;
    rdfs:label "be able to analyze the static, dynamic and frequency characteristics of dynamic systems using mathematical methods."@en .

lo:R0004E-5 a et:LearningOutcome ;
    rdfs:label "be able to use common methods for dimensioning and analyzing feedback controllers."@en .

lo:R0004E-6 a et:LearningOutcome ;
    rdfs:label "demonstrate the ability to design and implement controllers in teams, and evaluate their performance for a real process."@en .

lo:R0004E-7 a et:LearningOutcome ;
    rdfs:label "demonstrate ability to teamwork and teamwork in group workings"@en .

lo:R0004E-8 a et:LearningOutcome ;
    rdfs:label "be able to Identify the usability of simple regulators and identify the need for more advanced methods"@en .

mod:R0004E-0004 a et:Assessment ;
    rdfs:label "Assignment report"@en ;
    et:assessmentType et:assignment ;
    et:moduleCode "0004" ;
    et:credits 1.5 ;
    et:gradeScale "G U 3 4 5" .

mod:R0004E-0005 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0005" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .

mod:R0004E-0006 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0006" ;
    et:credits 1.5 ;
    et:gradeScale "U G" .


# --- R7003E Automatic Control ---

c:R7003E a et:Course ;
    schema:courseCode "R7003E" ;
    schema:name "Automatic Control"@en, "Reglerteknik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:automatic-control ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and knowledge in the subject of Automatic control. Concepts such as transfer function, Bode plot, poles and zeros, impulse response and step response, feedback and PID controllers should be known. Knowledge on the Laplace transform and experience with Matlab is also presumed. These prerequisites correspond to one of the courses R0001E Basic Automatic Control, 7,5 ECTS, R0002E Modelling and Control 7.5 ECTS, R0004E Modeling and Control 7.5 ECTS or R0005E Measurement and Control 7.5 ECTS. Good knowledge in English equivalent to English 6. Alternative: Corresponding knowledge obtained through work in the process industry or the electronics industry which is proven by a certificate of professional experience."@en, "Minst 90hp avslutade kurser samt grundläggande kunskaper inom reglerteknik. Begrepp såsom överföringsfunktioner, Bodediagram, poler och nollställen, impulssvar och stegsvar, återkoppling och PID-regulatorn bör vara kända. Kunskaper om Laplacetransformen och vana med Matlab förutsätts också. Dessa förkunskaper motsvarar en av kurserna R0001E Grundläggande reglerteknik 7.5 hp, R0002E Modellbygge och reglering 7.5 hp, R0004E Modellering och reglering 7.5 hp eller R0005E Mät- och reglerteknik, 7.5 hp. Goda kunskaper i engelska, motsvarande Engelska 6. Alternativt: Motsvarande kunskap erhållen genom arbete inom processindustri eller elektronikbranschen som styrks med intyg om yrkeserfarenhet."@sv ;
    et:entryRequirementNames c:R0001E, c:R0002E, c:R0004E, c:R0005E ;
    et:hasOutcome lo:R7003E-1, lo:R7003E-2, lo:R7003E-3, lo:R7003E-4, lo:R7003E-5, lo:R7003E-6 ;
    et:hasAssessment mod:R7003E-0002, mod:R7003E-0004 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=R7003E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7003E&lasPeriod=225&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7003E&lasPeriod=225> .

lo:R7003E-1 a et:LearningOutcome ;
    rdfs:label "demonstrate broad knowledge of control engineering methods and terminology."@en, "visa bred kunskap om reglertekniska metoder och terminologi."@sv .

lo:R7003E-2 a et:LearningOutcome ;
    rdfs:label "demonstrate broad knowledge of mathematical methods to analyze dynamic systems"@en, "visa brett kunnande om matematiska metoder för att analysera dynamiska system"@sv .

lo:R7003E-3 a et:LearningOutcome ;
    rdfs:label "use standard methods for designing and analyzing controllers."@en, "använda vanliga metoder för att dimensionera och analysera regulatorer."@sv .

lo:R7003E-4 a et:LearningOutcome ;
    rdfs:label "demonstrate an ability to, in a group, simulate , analyze , evaluate and implement controllers for a real process and to report on this work, both orally and in writing"@en, "visa förmåga att i grupp dimensionera, simulera, analysera, utvärdera och implementera regulatorer för en verklig process samt att både muntligt och i skrift redogöra för detta arbete"@sv .

lo:R7003E-5 a et:LearningOutcome ;
    rdfs:label "demonstrate the ability to identify constraints of simple controllers and the need for more advanced methods."@en, "visa förmåga att identifiera enkla regulatorers begränsningar och behovet av mer avancerade metoder."@sv .

lo:R7003E-6 a et:LearningOutcome ;
    rdfs:label "show insight into how the use of automatic control can contribute to sustainable development through reduced consumption of resources ."@en, "visa insikt i hur använding av reglerteknik kan bidra till hållbar utveckling genom minskad resursförbrukning."@sv .

mod:R7003E-0002 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0002" ;
    et:credits 3.0 ;
    et:gradeScale "U G#" .

mod:R7003E-0004 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0004" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .


# --- R7008E Industrial automation ---

c:R7008E a et:Course ;
    schema:courseCode "R7008E" ;
    schema:name "Industrial automation"@en, "Industriell automation"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:automatic-control ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and basic knowledge in the subjects of automatic control (corresponding to one of the courses R0001E Basic Automatic Control 7,5 ECTS, R0002E Modelling and Control 7,5 ECTS, R0004E Modelling and Control 7,5 ECTS, or R0005E Measurement and feedback control 7,5 ECTS), basic electronics (E0003E Circuit Theory 7,5 ECTS or E0013E Fundamentals of Electrical Engineering 7,5 ECTS), mathematics (M0018M Linear Analysis 7,5 ECTS) and programming (D0009E Introduction to Programmming 7,5 ECTS or D0010E Object - oriented Programming and Design 7,5 ECTS). Good knowledge in English equivalent to English 6."@en, "Minst 90hp avslutade kurser samt grundläggande kunskaper inom ämnesområdena reglerteknik (motsvarande en av kurserna R0001E Grundläggande reglerteknik 7,5 hp, R0002E Modellbygge och reglering 7,5 hp, R0004E Modellering och reglering 7,5 hp eller R0005E Mät- och reglerteknik 7,5 hp). Grundläggande elektronik (E0003E Elkretsteori, 7,5hp eller E0013E Grundkurs i elektroteknik 7,5 hp), matematik (M0018M Linjär analys 7,5 hp) och programmering (D0009E Introduktion till programmering 7,5 hp eller D0010E Objektorienterad programmering och design 7,5hp). Goda kunskaper i engelska, motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:D0009E, c:D0010E, c:E0003E, c:E0013E, c:M0018M, c:R0001E, c:R0002E, c:R0004E, c:R0005E ;
    et:hasOutcome lo:R7008E-1, lo:R7008E-2, lo:R7008E-3, lo:R7008E-4, lo:R7008E-5, lo:R7008E-6, lo:R7008E-7, lo:R7008E-8, lo:R7008E-9 ;
    et:hasAssessment mod:R7008E-0004, mod:R7008E-0005 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=R7008E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7008E&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7008E&lasPeriod=227> .

lo:R7008E-1 a et:LearningOutcome ;
    rdfs:label "Select sensors and actuators for synthesizing solutions for Industrial Automation problems"@en, "Välj sensorer och ställdon för att utforma lösningar för industriella automationsproblem"@sv .

lo:R7008E-2 a et:LearningOutcome ;
    rdfs:label "Analyze a real life problem from an industrial automation perspective, understand what is effective, what is not, judge based on an engineering and cost oriented thinking"@en, "Analysera verkliga problem ur ett industriellt automatiseringsperspektiv, förstå vad som är effektivt, vad som inte är, bedöma utifrån ett tekniskt och kostnadsorienterat tänkande"@sv .

lo:R7008E-3 a et:LearningOutcome ;
    rdfs:label "Identify and Select proper sensory and actuation equipments for synthesizing and integrating industrial automation tasks"@en, "Identifiera och välj rätt sensor- och ställdonsutrustning för att utforma och integrera industriella automatiseringsuppgifter"@sv .

lo:R7008E-4 a et:LearningOutcome ;
    rdfs:label "Integrate and Synthesize a classical relay based industrial automation"@en, "Integrera och syntetisera en klassisk reläbaserad industriell automatisering"@sv .

lo:R7008E-5 a et:LearningOutcome ;
    rdfs:label "Integrate, Synthesize and Program a PLC based industrial automation"@en, "Integrera, syntetisera och programmera en PLC-baserad industriell automatisering"@sv .

lo:R7008E-6 a et:LearningOutcome ;
    rdfs:label "Design a PCB based Industrial Automation"@en, "Designa en PCB-baserad industriell automatisering"@sv .

lo:R7008E-7 a et:LearningOutcome ;
    rdfs:label "Analyze, Integrate and Combine Electro Pneumatic-Hydraulic Automation with relay or PLC based industrial automation"@en, "Analysera, integrera och kombinera elektro-pneumatisk-hydraulisk automatisering med relä- eller PLC- baserad industriell automatisering"@sv .

lo:R7008E-8 a et:LearningOutcome ;
    rdfs:label "Select and Utilize Industrial Networks for Industrial Automation Networks"@en, "Välj och utnyttja industriella nätverk för industriella nätverk"@sv .

lo:R7008E-9 a et:LearningOutcome ;
    rdfs:label "Tune PID controllers for the Process Control Industry"@en, "Ställ in PID-regulatorer för processindustriella tillämpningar"@sv .

mod:R7008E-0004 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0004" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .

mod:R7008E-0005 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0005" ;
    et:credits 3.0 ;
    et:gradeScale "U G" .


# --- R7010E Robotics ---

c:R7010E a et:Course ;
    schema:courseCode "R7010E" ;
    schema:name "Robotics"@en, "Robotik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:automatic-control ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and knowledge in the subject of Automatic control, specifically regarding modeling, frequency response, state-space, state feedback, control design. Knowledge in programming with Matlab, LabView and basic electonics is a plus. These prerequisites corrsepond to the courses R7003E - Automatic Control, 7,5 ECTS, R7014E - Advanced control design, 7,5 ECTS and E7012E - Mechatronics, 7,5 ECTS. Knowledge in English, equivalent to English 6."@en, "Minst 90hp avklarade kurser samt kunskaper inom reglerteknik, särskilt modellering, frekvenssvar, state-space, state feedback, och design av reglersystem. Kunskaper i programmering med Matlab, LabView och grundkunskaper i elektronik är en bra bas. Dessa förkunskaper motsvarar kurserna R7003E - Reglerteknik, 7,5 hp, R7014E - Avancerade reglersystem, 7,5 hp och E7012E - Mekatronik, 7,5 hp. Goda kunskaper i engelska, motsvarande Engelska 6"@sv ;
    et:entryRequirementNames c:E7012E, c:R7003E, c:R7014E ;
    et:hasOutcome lo:R7010E-1, lo:R7010E-2, lo:R7010E-3, lo:R7010E-4, lo:R7010E-5, lo:R7010E-6 ;
    et:hasAssessment mod:R7010E-0003, mod:R7010E-0004 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=R7010E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7010E&lasPeriod=225&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7010E&lasPeriod=225> .

lo:R7010E-1 a et:LearningOutcome ;
    rdfs:label "show knowledge of the modeling and controling approaches for mobile robots"@en, "visa kunskaper om metoder för modellering och reglering av mobila robotar"@sv .

lo:R7010E-2 a et:LearningOutcome ;
    rdfs:label "demonstrate the ability to design and implement path planning algorithms"@en, "visa förmåga att designa och implementera algoritmer för vägplanering av mobila robotar"@sv .

lo:R7010E-3 a et:LearningOutcome ;
    rdfs:label "show knowledge on basic concept in manipulator kinematics and dynamics"@en, "visa kunskap om kinematik och dynamik för robotarmar och manipulatorer"@sv .

lo:R7010E-4 a et:LearningOutcome ;
    rdfs:label "demonstrate the ability to use image processing techniques on feature extraction and visual servoing"@en, "visa förmåga att använda bildbehandlingstekniker för att feature extraction och visuell styrning"@sv .

lo:R7010E-5 a et:LearningOutcome ;
    rdfs:label "show deep knowledge with robotic platforms and their operation"@en, "visa kunskap om olika robot plattformar och deras funktion"@sv .

lo:R7010E-6 a et:LearningOutcome ;
    rdfs:label "demonstrate the ability program multiple robotic platforms in the area of vision and control and to report on this work both orally and in writing."@en, "visa förmåga att programmera funktioner för visuella sensorer och reglering av flera olika typer av robotplattformar samt att både muntligt och i skrift redogöra för detta arbete"@sv .

mod:R7010E-0003 a et:Assessment ;
    rdfs:label "Project"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0003" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .

mod:R7010E-0004 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0004" ;
    et:credits 3.0 ;
    et:gradeScale "G U 3 4 5" .


# --- R7014E Advanced Control Design ---

c:R7014E a et:Course ;
    schema:courseCode "R7014E" ;
    schema:name "Advanced Control Design"@en, "Avancerade reglersystem"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:automatic-control ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and knowledge in the subject of Automatic control, R7003E Automatic control 7,5 ECTS. Good knowledge in English equivalent to English 6."@en, "Minst 90hp avklarade kurser samt kunskaper i reglerteknik motsvarar kursen R7003E Reglerteknik, 7,5 Hp. Goda kunskaper i engelska, motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:R7003E ;
    et:hasOutcome lo:R7014E-1, lo:R7014E-2, lo:R7014E-3, lo:R7014E-4, lo:R7014E-5, lo:R7014E-6, lo:R7014E-7, lo:R7014E-8 ;
    et:hasAssessment mod:R7014E-0004, mod:R7014E-0005 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=R7014E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7014E&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7014E&lasPeriod=226> .

lo:R7014E-1 a et:LearningOutcome ;
    rdfs:label "show a deep knowledge of control engineering methods and terminology for robust and optimal control"@en, "visa djupa kunskaper om reglertekniska metoder och terminologi för robust och optimal reglering"@sv .

lo:R7014E-2 a et:LearningOutcome ;
    rdfs:label "show deep understanding of mathematical methods to design advanced control schemes for dynamic system which can be non-linear, uncertain and multivariable"@en, "visa djupa kunskaper om matematiska metoder för att dimensionera avancerade regleralgoritmer för dynamiska system som kan vara olinjära, osäkra och multivariabla"@sv .

lo:R7014E-3 a et:LearningOutcome ;
    rdfs:label "demonstrate the ability to model non-linear and multivariable dynamic systems based on empirical data and formulate descriptions of uncertainties and disturbances in dynamical systems"@en, "visa förmåga att modellera olinjära multivariabla dynamiska system baserat på empiriska data och formulera beskrivningar av osäkerheter och störningar i dynamiska system"@sv .

lo:R7014E-4 a et:LearningOutcome ;
    rdfs:label "demonstrate an ability to formulate performance requirements for control systems and determine what performance is achievable"@en, "visa förmåga att formulera prestandakrav på reglersystem och avgöra vilka prestanda som är möjliga att uppnå"@sv .

lo:R7014E-5 a et:LearningOutcome ;
    rdfs:label "use standard methods for designing and analyzing robust, optimal and predictive controllers, even in the multivariable case"@en, "använda vanliga metoder för att dimensionera och analysera robusta, optimala och modellprediktiva regulatorer och regulatorer, även för multivariabla system"@sv .

lo:R7014E-6 a et:LearningOutcome ;
    rdfs:label "demonstrate an ability to, in a group, simulate, analyze, evaluate and implement robust, optimal and predictive controllers for a real process and to report on this work, both orally and in writing"@en, "visa förmåga att i grupp dimensionera, simulera, analysera, utvärdera och implementera robusta, optimala och modellprediktiva regulatorer för en verklig process samt att både muntligt och i skrift redogöra för detta arbete"@sv .

lo:R7014E-7 a et:LearningOutcome ;
    rdfs:label "show the ability to identify constraints of simple controllers and the need for more advanced methods"@en, "visa förmåga att identifiera enkla regulatorers begränsningar och behovet av mer avancerade metoder"@sv .

lo:R7014E-8 a et:LearningOutcome ;
    rdfs:label "demonstrate an ability to analyze observability of a dynamic system, to design and implement estimators for states and non-measurable variables"@en, "visa förmåga att analysera ett dynamiskt systems observerbarhet, att utforma och implementera estimatorer för tillstånd och icke-mätbara variabler"@sv .

mod:R7014E-0004 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0004" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .

mod:R7014E-0005 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0005" ;
    et:credits 3.0 ;
    et:gradeScale "U G" .


# --- R7015E System identification ---

c:R7015E a et:Course ;
    schema:courseCode "R7015E" ;
    schema:name "System identification"@en, "Systemidentifiering"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:automatic-control ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and knowledge in the subject of Automatic control, R7003E Automatic Control 7,5 ECTS and basic level knowledge about probability and statistics, S0008M Probability Theory and Statistics 7,5 ECTS. Good knowledge in English equivalent to English 6."@en, "Minst 90hp avklarade kurser samt kunskaper inom reglerteknik, motsvararande kursen R7003E Reglerteknik, 7,5 Hp och sannolikhet och statistik, motsvarande kursen S0008M Sannolikhetslära och statistik, 7,5 Hp. Goda kunskaper i engelska, motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:R7003E, c:S0008M ;
    et:hasOutcome lo:R7015E-1, lo:R7015E-2, lo:R7015E-3, lo:R7015E-4, lo:R7015E-5 ;
    et:hasAssessment mod:R7015E-0001, mod:R7015E-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=R7015E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7015E&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7015E&lasPeriod=224> .

lo:R7015E-1 a et:LearningOutcome ;
    rdfs:label "formulate and implement algorithms for system identification, i.e. estimation of mathematical models of a dynamic system from input-output data"@en, "formulera och implementera algoritmer för systemidentifiering, dvs skattning av matematiska modeller av dynamiska system från in-/utdata"@sv .

lo:R7015E-2 a et:LearningOutcome ;
    rdfs:label "formulate and implement algorithms for state estimation, i.e. to infer the status of the internal variables of a dynamic system using measurements of other quantities and some knowledge of the system dynamics"@en, "formulera och implementera algoritmer för tillståndsskattning, dvs att dra slutsatser om värdet på interna variabler i ett dynamiskt system genom mätningar av andra storheter och kunskap om systemets dynamik"@sv .

lo:R7015E-3 a et:LearningOutcome ;
    rdfs:label "solve simple instances of system identification and estimation problems by hand"@en, "lösa enkla systemidentifierings- och tillståndsskattningsproblem för hand"@sv .

lo:R7015E-4 a et:LearningOutcome ;
    rdfs:label "analyze and prove properties of system identification and estimation algorithms"@en, "analysera och bevisa egenskaper för systemidentifierings- och tillståndsskattningsalgoritmer"@sv .

lo:R7015E-5 a et:LearningOutcome ;
    rdfs:label "apply the above described techniques on real-world processes, and report on this work both orally and in writing."@en, "tillämpa ovannämnda tekniker på verkliga processer samt att rapportera detta arbete, både muntligt och skriftligt"@sv .

mod:R7015E-0001 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0001" ;
    et:credits 3.0 ;
    et:gradeScale "U G#" .

mod:R7015E-0003 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0003" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .


# --- R7016E Dynamic Systems ---

c:R7016E a et:Course ;
    schema:courseCode "R7016E" ;
    schema:name "Dynamic Systems"@en, "Dynamiska system"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:automatic-control ;
    schema:coursePrerequisites "Basic knowledge of physics, specifically mechanics, electric circuits and thermodynamics. Knowledge of mathematics, including linear algebra, differential equations, recurrence equations and the Laplace transform. These prerequisite knowledge correspond to F0004T Physics 1, M0031M Linear Algebra and Differential Equations, and one of M0018M Linear analysis, R0001E Basic automatic control, or R0002E Modeling and control. Knowledge in English, equivalent to English 6."@en, "Grundläggande kunskaper i fysik, specifikt mekanik, elektriska kretsar och termodynamik. Kunskaper i matematik som inkluderar linjär algebra, differentialekvationer, differensekvationer och Laplacetransformen. Dessa förkunskaper motsvarar F0004T Fysik 1, M0031M Linjär algebra och differentialekvationer, samt en av M0018M Linjär analys, R0001E Grundläggande reglerteknik eller R0002E modellbygge och reglering. Goda kunskaper i engelska, motsvarande Engelska 6"@sv ;
    et:entryRequirementNames c:F0004T, c:M0018M, c:M0031M, c:R0001E, c:R0002E ;
    et:hasOutcome lo:R7016E-1, lo:R7016E-2, lo:R7016E-3, lo:R7016E-4 ;
    et:hasAssessment mod:R7016E-0002, mod:R7016E-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=R7016E> ;
    et:syllabusDecisionDate "2021-02-16"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7016E&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7016E&lasPeriod=224> .

lo:R7016E-1 a et:LearningOutcome ;
    rdfs:label "Set up first principles models for basic mechanical, electrical, thermal, and fluid flow systems"@en, "Ställa upp dynamiska modeller baserade på fysikaliska principer för enkla mekaniska, elektriska och termiska system samt flödessystem"@sv .

lo:R7016E-2 a et:LearningOutcome ;
    rdfs:label "Set up first principles models for other types of systems, such as chemical, biologic, economic, and sociologic, given a description of the system mechanisms."@en, "Ställa upp dynamiska modeller för andra typer av system, såsom kemiska, biologiska, ekonomiska, sociologiska, givet en beskrivning av mekanismerna i systemet."@sv .

lo:R7016E-3 a et:LearningOutcome ;
    rdfs:label "Analyze dynamic systems regarding properties such as equilibrium, stability, oscillations, and chaotic behavior"@en, "Analysera dynamiska system med avseende på egenskaper såsom jämvikt, stabilitet, oscillationer och kaotiskt beteende"@sv .

lo:R7016E-4 a et:LearningOutcome ;
    rdfs:label "Implement simulation models for dynamic systems of different kinds, such as ordinary differential equation, partial differential equations, discrete-time systems, differential algebraic systems"@en, "Implementera simuleringsmodeller av olika typer av dynamiska system såsom ordinära och partiella differentialekvationer, tidsdiskreta system och differentialalgebraiska system"@sv .

mod:R7016E-0002 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0002" ;
    et:credits 3.0 ;
    et:gradeScale "U G#" .

mod:R7016E-0003 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0003" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .


# --- R7017E Biorobotics ---

c:R7017E a et:Course ;
    schema:courseCode "R7017E" ;
    schema:name "Biorobotics"@en, "Biorobotik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:automatic-control ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and knowledge in the subject of Automatic Control, specifically regarding modeling, dynamics, state-space analysis and system control design. Basic knowledge in programming, particularly with MATLAB and Simulink. These prerequisites correspond to the courses Automatic Control R7003E, 7,5 ECTS and Introduction to Programming D0009E, 7,5 ECTS or Programming and electronics for cybernetics D0031E, 7,5 ECTS. Good knowledge in English equivalent to English 6."@en, "Minst 90hp avklarade kurser samt kunskaper i reglerteknik, specifikt avseende modellering, dynamiska system, tillståndsform och regulatordesign. Grundläggande kunskaper i programmering, speciellt med MATLAB och Simulink. Dessa förkunskaper motsvarar kurserna Reglerteknik R7003E, 7,5 hp samt Introduktion till programmering D0009E, 7,5 hp eller Programmering och elektronik för cybernetik D0031E, 7,5 hp. Goda färdigheter i engelska motsvarande Engelska 6"@sv ;
    et:entryRequirementNames c:D0009E, c:D0031E, c:R7003E ;
    et:hasOutcome lo:R7017E-1, lo:R7017E-2, lo:R7017E-3, lo:R7017E-4 ;
    et:hasAssessment mod:R7017E-0001 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=R7017E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7017E&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7017E&lasPeriod=226> .

lo:R7017E-1 a et:LearningOutcome ;
    rdfs:label "Identify the different levels of bioinspiration in robotics"@en, "Identifiera olika nivåer av bioinspirerad robotik"@sv .

lo:R7017E-2 a et:LearningOutcome ;
    rdfs:label "Recognize the fundamental principles of walking, flying and swimming robots"@en, "Känna igen fundamentala principer för gående, flygande och simmande robotar"@sv .

lo:R7017E-3 a et:LearningOutcome ;
    rdfs:label "Model and analyse multi-joint systems from a forward and inverse kinematic perspective"@en, "Modellera och analysera flerledssystem ur ett kinematiskt och omvänt kinematiskt perspektiv"@sv .

lo:R7017E-4 a et:LearningOutcome ;
    rdfs:label "Demonstrate the ability to, in a group, implement and evaluate motion of bioinspired robotic systems"@en, "Demonstrera förmågan att, i grupp, implementera och utvärdera rörelse- och kraftreglering för de monterade biorobotiska systemen"@sv .

mod:R7017E-0001 a et:Assessment ;
    rdfs:label "Project"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0001" ;
    et:credits 7.5 ;
    et:gradeScale "G U 3 4 5" ;
    et:assesses lo:R7017E-1, lo:R7017E-2, lo:R7017E-3, lo:R7017E-4 .


# --- R7020E Computer Vision and Image Processing ---

c:R7020E a et:Course ;
    schema:courseCode "R7020E" ;
    schema:name "Computer Vision and Image Processing"@en, "Datorseende och bildbehandling"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:automatic-control ;
    schema:coursePrerequisites "The student should have a basic level of programming skills, e.g. corresponding to courses D0009E Introduction to Programming 7.5 credits or D0017E Introduction to programmin for engineers 7.5 credits and also basic knowledge of mathematics, corresponding to courses M0030M Linear Algebra and Calculusor 7.5 credits or M0048M Linear Algebra and Calculus 7.5 credits. Good knowledge in English equivalent to English 6."@en, "Studenten ska ha grundläggande färdigheter i programmering, t.ex. motsvarande kurserna D0009E Introduktion till programmering 7.5 hp eller D0017E Introduktion till programmering för ingenjörer 7.5 hp samt grundläggande kunskaper i matematik, motsvarande kurserna M0030M Linjär algebra och integralkalkyl 7.5 hp eller M0048M Linjär algebra och integralkalkyl 7.5 hp. Goda kunskaper i engelska, motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:D0009E, c:D0017E, c:M0030M, c:M0048M ;
    et:hasOutcome lo:R7020E-1, lo:R7020E-2, lo:R7020E-3, lo:R7020E-4, lo:R7020E-5, lo:R7020E-6 ;
    et:hasAssessment mod:R7020E-0001, mod:R7020E-0002 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=R7020E> ;
    et:syllabusDecisionDate "2023-02-15"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7020E&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=R7020E&lasPeriod=224> .

lo:R7020E-1 a et:LearningOutcome ;
    rdfs:label "describe both theoretical and practical aspects on computer vision and image processing including methodology and terminology"@en, "Efter avslutad kurs kommer studenterna att kunna beskriva både teoretiska och praktiska aspekter på datorseende och bildbehandling inklusive metodik och terminologi"@sv .

lo:R7020E-2 a et:LearningOutcome ;
    rdfs:label "describe basic principles of image formation and analysis"@en, "beskriva grundläggande principer för bildskapande och analys"@sv .

lo:R7020E-3 a et:LearningOutcome ;
    rdfs:label "choose and implement methods related to image filtering, image feature extraction and image segmentation"@en, "välja och implementera metoder relaterade till bildfiltrering, extraktion av bildelement och bildsegmentering"@sv .

lo:R7020E-4 a et:LearningOutcome ;
    rdfs:label "apply the geometric relationships between 2D images and 3D world"@en, "tillämpa de geometriska förhållandena mellan 2D-bilder och 3D-världen"@sv .

lo:R7020E-5 a et:LearningOutcome ;
    rdfs:label "interpret higher level image processing tasks like object detection as well as understand the principles of related deep neural networks"@en, "tolka högre bildbehandlingsuppgifter som objektdetektering samt förstå principerna för relaterade djupa neurala nätverk"@sv .

lo:R7020E-6 a et:LearningOutcome ;
    rdfs:label "implement, analyse and evaluate simple methods in computer vision applications within the framework of service oriented architecture"@en, "implementera, analysera och utvärdera enkla metoder i tillämpningen av datorseende inom ramen för tjänsteorienterad arkitektur"@sv .

mod:R7020E-0001 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
