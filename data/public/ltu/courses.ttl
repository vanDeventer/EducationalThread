# --- S0001E Signal analysis ---

c:S0001E a et:Course ;
    schema:courseCode "S0001E" ;
    schema:name "Signal analysis"@en, "Signalanalys"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:signal-processing ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and courses of at least 60 credits at first cycle including the following knowledge/courses: M0018M Linear analysis, M0048M Linear Algebra and Calculusm, and or M0049M Linear Algebra and Differential Equations, or equivalent."@en, "Grundläggande behörighet samt kurserna M0018M Linjär analys, M0048M Linjär algebra och integralkalkyl, och M0049M Linjär algebra och differentialekvationer, eller motsvarande."@sv ;
    et:entryRequirementNames c:M0018M, c:M0048M, c:M0049M ;
    et:hasOutcome lo:S0001E-1, lo:S0001E-2, lo:S0001E-3, lo:S0001E-4, lo:S0001E-5 ;
    et:hasAssessment mod:S0001E-0002, mod:S0001E-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=S0001E> ;
    et:syllabusDecisionDate "2021-02-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S0001E&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S0001E&lasPeriod=224> .

lo:S0001E-1 a et:LearningOutcome ;
    rdfs:label "Derive and describe the frequency content of a signal"@en, "- Beräkna och beskriva frekvensinnehållet i en signal"@sv .

lo:S0001E-2 a et:LearningOutcome ;
    rdfs:label "Derive and describe how a linear and time-invariant (LTI) system affects input signal both in time and frequency"@en, "Beräkna och beskriva hur en linjärt och tidsinvariant (LTI) system påverkar insignaler i både tid och frekvens"@sv .

lo:S0001E-3 a et:LearningOutcome ;
    rdfs:label "Implement and simulate LTI systems"@en, "Implementera och simulera LTI system"@sv .

lo:S0001E-4 a et:LearningOutcome ;
    rdfs:label "Derive, describe, and simulate how the placement of poles and zeros affect the properties of a system both in time and frequency"@en, "Beräkna, beskriva och simulera hur placering av poler och nollställen påverkar ett systems egenskaper i både tid och frekvens"@sv .

lo:S0001E-5 a et:LearningOutcome ;
    rdfs:label "Determine if a certain continuous-time signal can be sampled without loss of information."@en, "Avgöra om en viss tidskontinuerlig signal kan samplas med en viss frekvens utan att förlora information"@sv .

mod:S0001E-0002 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0002" ;
    et:credits 1.5 ;
    et:gradeScale "U G#" .

mod:S0001E-0003 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0003" ;
    et:credits 6.0 ;
    et:gradeScale "G U 3 4 5" .


# --- S0008M Probability Theory and Statistics ---

c:S0008M a et:Course ;
    schema:courseCode "S0008M" ;
    schema:name "Probability Theory and Statistics"@en, "Sannolikhetslära och statistik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:mathematical-statistics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and Differential calculus M0029M, Linear algebra and integral calculus M0030M and Linear algebra M0033M or equivalent."@en, "Grundläggande behörighet samt Differentialkalkyl M0029M, Linjär algebra och integralkalkyl M0030M och Linjär algebra M0033M eller motsvarande."@sv ;
    et:entryRequirementNames c:M0029M, c:M0030M, c:M0033M ;
    et:hasOutcome lo:S0008M-1, lo:S0008M-2, lo:S0008M-3, lo:S0008M-4, lo:S0008M-5, lo:S0008M-6, lo:S0008M-7 ;
    et:hasAssessment mod:S0008M-0005, mod:S0008M-0006 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=S0008M> ;
    et:syllabusDecisionDate "2022-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S0008M&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S0008M&lasPeriod=226> .

lo:S0008M-1 a et:LearningOutcome ;
    rdfs:label "Define descriptive statistics for distributions and data, such as measures of location and dispersion"@en .

lo:S0008M-2 a et:LearningOutcome ;
    rdfs:label "Be familiar with basic concepts from probability and statistical theory as well as understand the concept of a statistical model"@en .

lo:S0008M-3 a et:LearningOutcome ;
    rdfs:label "Be able to use statistical software for processing and analyzing data"@en .

lo:S0008M-4 a et:LearningOutcome ;
    rdfs:label "Be able to formulate and use some often used statistical models"@en .

lo:S0008M-5 a et:LearningOutcome ;
    rdfs:label "Be able to apply the statistical methods for analysis that the course treats"@en .

lo:S0008M-6 a et:LearningOutcome ;
    rdfs:label "Be able to assess when statistical methods are useful"@en .

lo:S0008M-7 a et:LearningOutcome ;
    rdfs:label "Be able to estimate how uncertainty affects conclusions and quantify risks in terms of error probabilities."@en .

mod:S0008M-0005 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0005" ;
    et:credits 5.3 ;
    et:gradeScale "G U 3 4 5" .

mod:S0008M-0006 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0006" ;
    et:credits 2.2 ;
    et:gradeScale "U G" .


# --- S7001E Stochastic signals ---

c:S7001E a et:Course ;
    schema:courseCode "S7001E" ;
    schema:name "Stochastic signals"@en, "Stokastiska signaler"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:signal-processing ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and upper secondary education and documented skills in English language, including the following knowledge/courses: S0001E Signal analysis, 7,5 ECTS and S0008M Probability Theory and Statistics, 7,5 ECTS or equivalent. Good knowledge in English equivalent to English 6."@en, "Minst 90hp avslutade kurser samt kurserna S0001E Signalanalys, 7,5 hp och S0008M Sannolikhetslära och statistik, 7,5 hp eller motsvarande. Goda kunskaper i engelska, motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:S0001E, c:S0008M ;
    et:hasOutcome lo:S7001E-1 ;
    et:hasAssessment mod:S7001E-0002, mod:S7001E-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=S7001E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S7001E&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S7001E&lasPeriod=224> .

lo:S7001E-1 a et:LearningOutcome ;
    rdfs:label "Use mathematical and statistical methods to process random signals, disturbances and noise. Estimate random parameters, estimate signals and parameters in noise, separate randomly composed signals, calculate the estimation error, calculate the statistical outcome of linear systems on random signals, develop detectors for signals in noise, calculate and estimate the spectral content in random signals. The students shall be able to implement, evaluate, and analyze these concepts in Matlab, and be able to present and demonstrate their results in written group reports."@en, "Använda matematiska och statistiska metoder för att behandla slumpmässigt varierande signaler, störningar och brus. Skatta slumpmässiga parametrar, estimera signaler och parametrar ur brus, separera slumpmässigt sammansatta signaler, beräkna skattningsfel, beräkna den statistiska påverkan av linjära tidsinvarianta system på slumpmässiga signaler, utveckla detektorer för signaler i brus, beräkna och skatta det spektrala innehållet i slumpmässiga signaler. Studenterna skall kunna implementera, utvärdera, och analysera ovanstående koncept i Matlab, samt presentera och demonstrera resultaten i skriftliga grupprapporter"@sv .

mod:S7001E-0002 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0002" ;
    et:credits 1.5 ;
    et:gradeScale "U G#" .

mod:S7001E-0003 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0003" ;
    et:credits 6.0 ;
    et:gradeScale "G U 3 4 5" .


# --- S7011E Applied Signal Processing ---

c:S7011E a et:Course ;
    schema:courseCode "S7011E" ;
    schema:name "Applied Signal Processing"@en, "Tillämpad signalbehandling"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:signal-processing ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and knowledge in stochastic signals, corresponding to the course S7001E Stochastic signals, 7,5 ECTS. Good knowledge in English equivalent to English 6."@en, "Minst 90hp avklarade kurser samt kunskap om stokastiska signaler, motsvarande kursen S7001E Stokastiska signaler, 7,5 hp. Goda kunskaper i engelska, motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:S7001E ;
    et:hasOutcome lo:S7011E-1, lo:S7011E-2, lo:S7011E-3, lo:S7011E-4, lo:S7011E-5, lo:S7011E-6, lo:S7011E-7 ;
    et:hasAssessment mod:S7011E-0001, mod:S7011E-0003, mod:S7011E-0004 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=S7011E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S7011E&lasPeriod=225&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S7011E&lasPeriod=225> .

lo:S7011E-1 a et:LearningOutcome ;
    rdfs:label "Be able to implement different methods for filtering, modeling, and spectral estimation of stochastic signals."@en, "Studenten ska efter genomförd kurs: Kunna implementera olika metoder för filtrering, modellering och spektralskattning av stokastiska signaler."@sv .

lo:S7011E-2 a et:LearningOutcome ;
    rdfs:label "Explain differences between methods in the categories mentioned above."@en, "Förklara skillnader mellan de olika metoderna i kategorierna ovan och värdera vilka metoder som bör användas i olika situationer."@sv .

lo:S7011E-3 a et:LearningOutcome ;
    rdfs:label "Based on the fundamental mathematical principles of the methods, be able to develop and explain new algorithms."@en, "Utifrån de underliggande matematiska principerna för metoderna, kunna vidareutveckla och förklara nya algoritmer."@sv .

lo:S7011E-4 a et:LearningOutcome ;
    rdfs:label "Individually or in teams, plan and conduct qualified tasks relevant to the field."@en, "På egen hand eller i grupp planera och genomföra kvalificerade uppgifter inom området."@sv .

lo:S7011E-5 a et:LearningOutcome ;
    rdfs:label "Model, evaluate, and simulate practical systems, by applying the methods and principles presented in the course."@en, "Modellera, utvärdera och simulera praktiska system med hjälp av de metoder och principer som behandlas i kursen."@sv .

lo:S7011E-6 a et:LearningOutcome ;
    rdfs:label "Present results in written reports in English."@en, "Presentera resultat i skriftliga rapporter på engelska."@sv .

lo:S7011E-7 a et:LearningOutcome ;
    rdfs:label "The students should also be able to judge The applicability and limitations of the different methods regarding specific practical problems relevant to the field."@en, "Studenterna ska också kunna bedöma: De olika metodernas möjligheter och begränsningar beträffande specifika praktiska problem inom området."@sv .

mod:S7011E-0001 a et:Assessment ;
    rdfs:label "Laboratory Work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0001" ;
    et:credits 3.0 ;
    et:gradeScale "U G#" .

mod:S7011E-0003 a et:Assessment ;
    rdfs:label "Problem seminars"@en ;
    et:assessmentType et:oralExam ;
    et:moduleCode "0003" ;
    et:credits 1.5 ;
    et:gradeScale "U G#" .

