    et:outcomeCategory et:skillsAndAbilities .

lo:F0048T-5 a et:LearningOutcome ;
    rdfs:label "use numerical tool to design and scale optical components"@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0048T-6 a et:LearningOutcome ;
    rdfs:label "plan and execute experiments with optical systems and component"@en ;
    et:outcomeCategory et:skillsAndAbilities .

