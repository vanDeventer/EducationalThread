    et:assessmentType et:labWork ;
    et:moduleCode "0007" ;
    et:credits 1.0 ;
    et:gradeScale "U G" .

mod:F7045T-0008 a et:Assessment ;
    rdfs:label "Seminars"@en ;
    et:assessmentType et:oralExam ;
    et:moduleCode "0008" ;
    et:credits 1.0 ;
    et:gradeScale "U G" .


# --- F7050T Project in Engineering Physics and Electrical Engineering - Computational Methods and Physics ---

c:F7050T a et:Course ;
    schema:courseCode "F7050T" ;
    schema:name "Project in Engineering Physics and Electrical Engineering - Computational Methods and Physics"@en, "Projekt teknisk fysik och elektroteknik, inriktning beräkningsteknik och fysik"@sv ;
    et:credits 15.0 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "At least 210 hp completed of the degree requirements as well as the following specialisation courses, M7018M Applied Mathematics, C7005M Numerics for Optimisation and PDE, F7024T Multiphysics, simulation and computation, and F7035T Statistical Physics and Thermodynamics."@en, "Minst 210 hp avklarade kurser av examensfordringarna samt följande inriktningskurser krävs för behörighet till projekt med denna inriktning, M7018M Tillämpad matematik, C7005M Numerik för optimering och PDE, F7024T Multifysik, simulering och beräkning, och F7035T Statistisk fysik och termodynamik."@sv ;
    et:entryRequirementNames c:C7005M, c:F7024T, c:F7035T, c:M7018M ;
    et:hasOutcome lo:F7050T-1, lo:F7050T-2, lo:F7050T-3, lo:F7050T-4, lo:F7050T-5 ;
    et:hasAssessment mod:F7050T-0001 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F7050T> ;
    et:syllabusDecisionDate "2021-02-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7050T&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7050T&lasPeriod=224> .

lo:F7050T-1 a et:LearningOutcome ;
    rdfs:label "In the course, the student solves an unstructured problem of a research and development nature by e.g. modelling, programming and use scripting tools. The student learns to use basic principles from previous courses to solve a practical problem within the specialization computational physics and technology. The course includes practical training in terms of presentation techniques and the ability to collaborate in groups. After completing the course, the student should be able to perform: Practical application of simulation tools."@en, "Praktiskt tillämpa simuleringsverktyg."@sv .

lo:F7050T-2 a et:LearningOutcome ;
    rdfs:label "Present their results orally and in a report."@en, "Presentera sina resultat muntligen och i rapport."@sv .

lo:F7050T-3 a et:LearningOutcome ;
    rdfs:label "Assessment of the possibilities and limitations of technology, its role in society and people's responsibility for how it is used, including social and economic aspects as well as environmental, work environment and gender equality aspects."@en, "Bedöma teknikens möjligheter och begränsningar, dess roll i samhället och människors ansvar för hur den används, inbegripet sociala och ekonomiska aspekter samt miljö-, arbetsmiljö- och jämställdhetsaspekter."@sv .

lo:F7050T-4 a et:LearningOutcome ;
    rdfs:label "Give constructive criticism of others' work and presentations."@en, "Ge konstruktiv kritik till andras arbeten och presentationer."@sv .

lo:F7050T-5 a et:LearningOutcome ;
    rdfs:label "Orally present technical report and reflect on one's own and others' presentation techniques."@en, "Muntligt presentera tekniska rapport och reflektera över sin egen och andras presentationstekniker."@sv .

mod:F7050T-0001 a et:Assessment ;
    rdfs:label "Project Work"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0001" ;
    et:credits 15.0 ;
    et:gradeScale "U G#" ;
    et:assesses lo:F7050T-1, lo:F7050T-2, lo:F7050T-3, lo:F7050T-4, lo:F7050T-5 .


# --- F7051T Computational Methods for Nanomaterials ---

c:F7051T a et:Course ;
    schema:courseCode "F7051T" ;
    schema:name "Computational Methods for Nanomaterials"@en, "Beräkningsmetoder för nanomaterial"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "M0047M Differential Calculus, M0048M Linear algebra and integral calculus, M0049M Linear algebra and differential calculus; F0047T Quantum physics; F7045T Solid state physics or equivalent. Be able to write simple computer programs (e.g. D0009E). Good knowledge in English, equivalent to English 6. It is beneficial to be able to use Matlab or Gnuplot for data analysis, and have studied F7035T Statistical Physics and Thermodynamics as well as M0014M Mathematical Physics, or equivalent."@en, "M0047M Differentialkalkyl, M0048M Linjär algebra och integralkalkyl samt M0049M Linjär algebra och differential kalkyl; F0047T Kvantfysik; F7045T Fasta tillståndets fysik eller motsvarande. Kunna skriva enkla dataprogram (t.ex. D0009E). Goda kunskaper i engelska motsvarande Engelska 6. Det är fördelaktigt att kunna använda Matlab eller Gnuplot för data-analys, och ha läst F7035T Statistisk fysik och termodynamik samt M0014M Matematisk fysik, eller motsvarande."@sv ;
    et:entryRequirementNames c:D0009E, c:F0047T, c:F7035T, c:F7045T, c:M0014M, c:M0047M, c:M0048M, c:M0049M ;
    et:hasOutcome lo:F7051T-1, lo:F7051T-2, lo:F7051T-3, lo:F7051T-4, lo:F7051T-5, lo:F7051T-6, lo:F7051T-7, lo:F7051T-8, lo:F7051T-9, lo:F7051T-10, lo:F7051T-11, lo:F7051T-12, lo:F7051T-13, lo:F7051T-14, lo:F7051T-15 ;
    et:hasAssessment mod:F7051T-0005 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F7051T> ;
    et:syllabusDecisionDate "2023-02-15"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7051T&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7051T&lasPeriod=224> .

lo:F7051T-1 a et:LearningOutcome ;
    rdfs:label "Explain the physical background of different electronic structure and dynamics computational methods."@en, "Förklara den fysikaliska bakgrunden och implementeringen för modellering i elektronstruktur- och dynamik- simuleringar."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7051T-2 a et:LearningOutcome ;
    rdfs:label "Describe the implementation methods used in different electronic structure and dynamics simulations techniques."@en, "Förklara principen för olika beräkningsmetoder."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7051T-3 a et:LearningOutcome ;
    rdfs:label "Exemplify what electronic structure and dynamics computational methods are used for and what kind of questions can be answered."@en, "Exemplifiera vad elektronstruktur- och dynamiksimuleringar kan användas för och beskriva vilken typ av frågeställningar som kan besvaras."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7051T-4 a et:LearningOutcome ;
    rdfs:label "Evaluate how computational physics fits into today's research in material and product development"@en, "Värdera hur beräkningsfysik passar in i dagens forskning inom material- och produktutveckling."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7051T-5 a et:LearningOutcome ;
    rdfs:label "Name different experimental methods that provide information about the properties of interest for different systems"@en, "Tillämpa olika beräkningsmetoder."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7051T-6 a et:LearningOutcome ;
    rdfs:label "Apply and use different computational techniques"@en, "Studenterna skall kunna designa elektronstrukturberäkningar och dynamiksimuleringar för ökad förståelse av materialrelaterade tillämpningar."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7051T-7 a et:LearningOutcome ;
    rdfs:label "Design electronic structure calculations as well as dynamics simulations for model systems and real materials, in order to simulate their properties and predict technological applications"@en, "Planera, genomföra, analysera och redovisa elektronstruktur- och dynamiksimuleringar"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7051T-8 a et:LearningOutcome ;
    rdfs:label "Plan, execute, assess and present electronic structure and dynamics simulations"@en, "Identifiera och korrigera vanliga felkällor i beräkningar"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7051T-9 a et:LearningOutcome ;
    rdfs:label "Identify and correct the most common sources of error in calculations."@en, "Kunna välja lämpligt metod att använda för att beskriva olika system och egenskaper"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7051T-10 a et:LearningOutcome ;
    rdfs:label "Identify the appropriate method needed to describe different systems and properties."@en, "Kunna värdera och bedöma beräkningsresultat"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7051T-11 a et:LearningOutcome ;
    rdfs:label "Analyze (evaluate and assess) results from simulations."@en, "Kunna nämna olika experimentella metoder som ger information om egenskaper av intresse"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7051T-12 a et:LearningOutcome ;
    rdfs:label "Determine which models and which approximations can be used in simulations, in order to generate meaningful results."@en, "Kunna avgöra vilka metodförenklingar och modellantaganden som kan göras för att utföra meningsfulla simuleringar."@sv ;
    et:outcomeCategory et:judgementAndApproach .

lo:F7051T-13 a et:LearningOutcome ;
    rdfs:label "Make a critical assessment of the used model and approximations, as well as of the results of simulations."@en, "Ska kunna kritiskt utvärdera resultat, modell och förenklingar."@sv ;
    et:outcomeCategory et:judgementAndApproach .

lo:F7051T-14 a et:LearningOutcome ;
    rdfs:label "Give a physical interpretation of the outcome of simulations."@en, "Kunna göra fysikaliska förklaringar av data."@sv ;
    et:outcomeCategory et:judgementAndApproach .

lo:F7051T-15 a et:LearningOutcome ;
    rdfs:label "Relate and compare results computational simulations to experimental data."@en, "Kunna relatera och jämföra beräkningsresultaten med experimentella data."@sv ;
    et:outcomeCategory et:judgementAndApproach .

mod:F7051T-0005 a et:Assessment ;
    rdfs:label "Practical sessions and written reports"@en ;
    et:assessmentType et:report ;
    et:moduleCode "0005" ;
    et:credits 7.5 ;
    et:gradeScale "U G#" ;
    et:assesses lo:F7051T-1, lo:F7051T-2, lo:F7051T-3, lo:F7051T-4, lo:F7051T-5, lo:F7051T-6, lo:F7051T-7, lo:F7051T-8, lo:F7051T-9, lo:F7051T-10, lo:F7051T-11, lo:F7051T-12, lo:F7051T-13, lo:F7051T-14, lo:F7051T-15 .


# --- G0010N Industrial Management with a Sustainability Perspective ---

c:G0010N a et:Course ;
    schema:courseCode "G0010N" ;
    schema:name "Industrial Management with a Sustainability Perspective"@en, "Industriell ekonomi med ett hållbarhetsperspektiv"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:industrial-economics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language"@en, "Grundläggande behörighet"@sv ;
    et:hasOutcome lo:G0010N-1, lo:G0010N-2, lo:G0010N-3, lo:G0010N-4, lo:G0010N-5, lo:G0010N-6, lo:G0010N-7, lo:G0010N-8, lo:G0010N-9, lo:G0010N-10, lo:G0010N-11, lo:G0010N-12 ;
    et:hasAssessment mod:G0010N-0009, mod:G0010N-0010, mod:G0010N-0011 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=G0010N> ;
    et:syllabusDecisionDate "2024-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=G0010N&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=G0010N&lasPeriod=226> .

lo:G0010N-1 a et:LearningOutcome ;
    rdfs:label "After completing the course, the student must be able to demonstrate knowledge and understanding of:"@en, "Studenten ska efter genomgången kurs kunna visa kunskap och förståelse för:"@sv .

lo:G0010N-2 a et:LearningOutcome ;
    rdfs:label "How value-creating systems for industrial companies are structured and intended to function."@en, "Hur värdeskapande system för industriella företag är uppbyggda och avsedda att fungera."@sv .

lo:G0010N-3 a et:LearningOutcome ;
    rdfs:label "How management, organization and business management models can be applied within industrial companies."@en, "Hur ledning, organisering och modeller för verksamhetsstyrning kan tillämpas inom industriella företag."@sv .

lo:G0010N-4 a et:LearningOutcome ;
    rdfs:label "The basics of and central terminology in the field of sustainable development."@en, "Grunder och terminologi inom området hållbar utveckling."@sv .

lo:G0010N-5 a et:LearningOutcome ;
    rdfs:label "The basics of and central terminology in the field of gender equality. After completing the course, the student must have the following skills and abilities:"@en, "Grunder och terminologi inom området jämställdhet. Studenten ska efter genomgången kurs ha följande färdigheter och förmågor :"@sv .

lo:G0010N-6 a et:LearningOutcome ;
    rdfs:label "Be able to prepare relevant investment and product calculations as a basis for planning, analyzes, and financially sustainable decisions for and within industrial companies."@en, "Kunna upprätta relevanta investerings- och produktkalkyler som underlag för planering, analyser och ekonomiskt hållbara beslut för och inom industriella företag."@sv .

lo:G0010N-7 a et:LearningOutcome ;
    rdfs:label "Be able to calculate, analyze and draw conclusions about the financial performance and financial position of industrial companies based on accounting-based information."@en, "Kunna beräkna, analysera och dra slutsatser om industriella företags finansiella prestationer och ekonomiska ställning med utgångspunkt från redovisningsbaserad information."@sv .

lo:G0010N-8 a et:LearningOutcome ;
    rdfs:label "Be able to analyze and draw conclusions about various aspects of managing and conducting industrial business in relation to sustainable development."@en, "Kunna analysera och dra slutsatser om olika aspekter av att leda och bedriva industriellt företagande i relation till hållbar utveckling."@sv .

lo:G0010N-9 a et:LearningOutcome ;
    rdfs:label "Be able to analyze and draw conclusions about how gender equality can affect operations, working methods, goods, services and results for industrial companies."@en, "Kunna analysera och dra slutsatser om hur jämställdhet kan påverka verksamheter, arbetssätt, varor, tjänster och resultat för industriella företag."@sv .

lo:G0010N-10 a et:LearningOutcome ;
    rdfs:label "Be able to present assigned course work orally as well as in writing in a well-structured and linguistically correct manner. After completing the course, the student must be able to demonstrate the following assessment skills and approach:"@en, "Kunna muntligt såväl som skriftligt presentera tilldelade kursuppgifter på ett välstrukturerat och språkligt korrekt sätt. Studenten ska efter genomgången kurs kunna uppvisa följande värderingsförmåga och förhållningssätt :"@sv .

lo:G0010N-11 a et:LearningOutcome ;
    rdfs:label "Be able to evaluate the credibility and relevance of financial calculations and other calculations that form the basis of analysis and decision-making for and within industrial companies."@en, "Kunna värdera rimlighet och relevans i ekonomiska kalkyler och andra beräkningsunderlag som ligger till grund för analys och beslutsfattande för och inom industriella företag."@sv .

lo:G0010N-12 a et:LearningOutcome ;
    rdfs:label "Be able to reason about how industrial management is relevant for the engineer in his/her professional role."@en, "Kunna föra resonemang om hur industriell ekonomi är relevant för ingenjören i dennes yrkesroll."@sv .

mod:G0010N-0009 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0009" ;
    et:credits 5.0 ;
    et:gradeScale "G U 3 4 5" .

mod:G0010N-0010 a et:Assessment ;
    rdfs:label "Sustainable development - Seminars/assignments"@en ;
    et:assessmentType et:assignment ;
    et:moduleCode "0010" ;
    et:credits 1.0 ;
    et:gradeScale "U G" .

mod:G0010N-0011 a et:Assessment ;
    rdfs:label "Gender equality - Seminars/assignments"@en ;
    et:assessmentType et:assignment ;
    et:moduleCode "0011" ;
    et:credits 1.5 ;
    et:gradeScale "U G" .


# --- M0014M Mathematical Physics ---

c:M0014M a et:Course ;
    schema:courseCode "M0014M" ;
    schema:name "Mathematical Physics"@en, "Matematisk Fysik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:mathematics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and M0047M Differential calculus, M0048M Linear Algebra and Calculus, M0049M Linear Algebra and Differential Equations, M0055M Multivariable calculus or corresponding. Linear Analysis M0018M, or corresponding."@en, "Grundläggande behörighet samt M0047M Differentialkalkyl, M0048M Linjär algebra och integralkalkyl, M0049M Linjär algebra och differentialekvationer M0055M Flervariabelanalys eller motsvarande. Linjär analys M0018M eller motsvarande."@sv ;
    et:entryRequirementNames c:M0018M, c:M0047M, c:M0048M, c:M0049M, c:M0055M ;
    et:hasOutcome lo:M0014M-1, lo:M0014M-2, lo:M0014M-3, lo:M0014M-4 ;
    et:hasAssessment mod:M0014M-0001 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=M0014M> ;
    et:syllabusDecisionDate "2022-11-07"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M0014M&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M0014M&lasPeriod=226> .

lo:M0014M-1 a et:LearningOutcome ;
    rdfs:label "be able to formulate partial differential equations, boundary- and initial conditions, starting with problems from physics and also be able to solve partial differential equations with different methods, for example by expansion in different orthogonal systems or by transform methods and also be able to give a physical intepretation of the solution."@en .

lo:M0014M-2 a et:LearningOutcome ;
    rdfs:label "acquire basic knowledge about the theory of Hilbert spaces including symmetric operators, specially Sturm- Liouville operators."@en .

lo:M0014M-3 a et:LearningOutcome ;
    rdfs:label "acquire basic knowledge of some special functions as orthogonal polynomials and Bessel functions."@en .

lo:M0014M-4 a et:LearningOutcome ;
    rdfs:label "acquire basic knowledge of the theory of distributions and be able to use distributions as the Delta function to describe various physical situations."@en .

mod:M0014M-0001 a et:Assessment ;
    rdfs:label "Written exam and/or compulsory assignments"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0001" ;
    et:credits 7.5 ;
    et:gradeScale "G U 3 4 5" ;
    et:assesses lo:M0014M-1, lo:M0014M-2, lo:M0014M-3, lo:M0014M-4 .


# --- M0018M Linear Analysis ---

c:M0018M a et:Course ;
    schema:courseCode "M0018M" ;
    schema:name "Linear Analysis"@en, "Linjär analys"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:mathematics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and The courses M0047M, M0048M, M0049M, or equivalent."@en, "Grundläggande behörighet samt kurserna M0047M Differentialkalkyl, M0048M Linjär algebra och integralkalkyl och M0049M Linjär algebra och differentialekvationer, eller motsvarande."@sv ;
    et:entryRequirementNames c:M0047M, c:M0048M, c:M0049M ;
    et:hasOutcome lo:M0018M-1, lo:M0018M-2, lo:M0018M-3, lo:M0018M-4, lo:M0018M-5, lo:M0018M-6, lo:M0018M-7 ;
    et:hasAssessment mod:M0018M-0002 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=M0018M> ;
    et:syllabusDecisionDate "2024-02-15"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M0018M&lasPeriod=225&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M0018M&lasPeriod=225> .

lo:M0018M-1 a et:LearningOutcome ;
    rdfs:label "Explain, exemplify, and illustrate the concepts of: Convergent and divergent series; Power series; Fourier series; Series solutions of differential equations; Generalised functions (distributions); Integral transforms; The fundamental matrix and exponentials of matrices"@en, "Örklara, exemplifiera och illustrera begreppen: konvergent och divergent serier; potensserier; Fourierserier; serielösningar av differentialekvationer; gereraliserade funktioner (distributioner); Integraltransformer; fundamentalmatris och exponentialmatris"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M0018M-2 a et:LearningOutcome ;
    rdfs:label "Determine formulas for common integral transforms"@en, "Bestäm formler för vanliga integraltransformer"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M0018M-3 a et:LearningOutcome ;
    rdfs:label "Assess which tools are most suitable for solving a given system of ordinary differential equations"@en, "Bedöm vilka verktyg som är mest lämpliga för att lösa ett givet system av ordinär differentialekvationer"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M0018M-4 a et:LearningOutcome ;
    rdfs:label "Compute, for a variety of elementary functions: Power series and Fourier series; Fourier transforms; Laplace transforms"@en, "Beräkna, för en mängd olika elementära funktioner: potensserie och fourierserie; Fouriertransform; Laplacetransform"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0018M-5 a et:LearningOutcome ;
    rdfs:label "Apply formulas to calculate integral transform of combinations of functions"@en, "Tillämpa formler för att beräkna transformationer av kombinationer av funktioner"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0018M-6 a et:LearningOutcome ;
    rdfs:label "Work with distributions"@en, "Räkna med distributioner"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0018M-7 a et:LearningOutcome ;
    rdfs:label "Solve ordinary differential equations using a variety of tools, including: integral transforms; series; the eigenvalue/eigenvector method; variation of parameters"@en, "Lös ordinara differentialekvationer med en mängd olika verktyg, inklusive: transformer; serier; egenvärdes/egenvektormetoden; variation av parametrarna"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

mod:M0018M-0002 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0002" ;
    et:credits 7.5 ;
    et:gradeScale "G U 3 4 5" ;
    et:assesses lo:M0018M-1, lo:M0018M-2, lo:M0018M-3, lo:M0018M-4, lo:M0018M-5, lo:M0018M-6, lo:M0018M-7 .


# --- M0065M Single Variable Calculus 1 ---

c:M0065M a et:Course ;
    schema:courseCode "M0065M" ;
    schema:name "Single Variable Calculus 1"@en, "Envariabelanalys 1"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:mathematics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language + Swedish upper secondary school courses Physics 2, Chemistry 1, Mathematics 4 or Mathematics E. Or: Physics level 2, Chemistry level 1, Mathematics Further level 2 or Mathematics E."@en, "Grundläggande behörighet + Fysik 2, Kemi 1, Matematik 4 eller Matematik E. Eller: Fysik nivå 2, Kemi nivå 1, Matematik fortsättning nivå 2 (äldre kurs Matematik E)."@sv ;
    et:hasOutcome lo:M0065M-1, lo:M0065M-2, lo:M0065M-3, lo:M0065M-4, lo:M0065M-5, lo:M0065M-6 ;
    et:hasAssessment mod:M0065M-0001 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=M0065M> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M0065M&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M0065M&lasPeriod=226> .

lo:M0065M-1 a et:LearningOutcome ;
    rdfs:label "describe and explain fundamental principles of differential calculus."@en, "beskriva och förklara grundläggande principer inom differentialkalkyl."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M0065M-2 a et:LearningOutcome ;
    rdfs:label "Explain and use mathematical reasoning and writing."@en, "förklara och använda matematiska resonemang och skrivsätt."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0065M-3 a et:LearningOutcome ;
    rdfs:label "Use sets and logic in mathematical proofs."@en, "använda mängder och logik i matematisk bevisföring."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0065M-4 a et:LearningOutcome ;
    rdfs:label "Use and prove fundamental properties of elementary functions and their inverses."@en, "hantera och bevisa fundamentala egenskaper hos elementära funktioner och deras inverser."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0065M-5 a et:LearningOutcome ;
    rdfs:label "Use central concepts and methods within single variable differential calculus on extreme value problems, graph sketching, limit calculations, analysis of functions and expressions as well as other applied problems."@en, "använda centrala begrepp och metoder inom differentialkalkyl i en variabel på extremvärdesberäkningar, kurvritning, gränsvärdesberäkningar, analys av funktioner och uttryck samt andra tillämpade problem."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0065M-6 a et:LearningOutcome ;
    rdfs:label "select an appropriate method of solution for given problems within the scope of the course."@en, "välja rimlig lösningsmetod för givna problem inom ramen för kursen."@sv ;
    et:outcomeCategory et:judgementAndApproach .

mod:M0065M-0001 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0001" ;
    et:credits 7.5 ;
    et:gradeScale "G U 3 4 5" ;
    et:assesses lo:M0065M-1, lo:M0065M-2, lo:M0065M-3, lo:M0065M-4, lo:M0065M-5, lo:M0065M-6 .


# --- M0066M Single Variable Calculus 2 ---

c:M0066M a et:Course ;
    schema:courseCode "M0066M" ;
    schema:name "Single Variable Calculus 2"@en, "Envariabelanalys 2"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:mathematics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and the course M0065M Single Variable Calculus 1, 7,5 ECTC or equivalent."@en, "Grundläggande behörighet samt kursen M0065M Envariabelanalys 1, 7,5 hp eller motsvarande."@sv ;
    et:entryRequirementNames c:M0065M ;
    et:hasOutcome lo:M0066M-1, lo:M0066M-2, lo:M0066M-3, lo:M0066M-4, lo:M0066M-5, lo:M0066M-6, lo:M0066M-7, lo:M0066M-8, lo:M0066M-9 ;
    et:hasAssessment mod:M0066M-0001 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=M0066M> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M0066M&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M0066M&lasPeriod=227> .

lo:M0066M-1 a et:LearningOutcome ;
    rdfs:label "describe and explain fundamental concepts, theories, and methods within integral calculus, complex numbers, and differential equations."@en, "beskriva och förklara grundläggande begrepp, teori och metoder inom integralkalkyl, komplexa tal och differentialekvationer."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M0066M-2 a et:LearningOutcome ;
    rdfs:label "calculate arithmetic and geometric sums"@en, "kunna beräkna aritmetiska och geometriska summor"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0066M-3 a et:LearningOutcome ;
    rdfs:label "prove a given statement within the scope of the course using mathematical induction"@en, "kunna bevisa ett givet påstående inom kursens ramar med matematisk induktion"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0066M-4 a et:LearningOutcome ;
    rdfs:label "compute definite and indefinite integrals using primitive functions and standard methods such as integration by parts, partial fractions and substitution"@en, "kunna beräkna bestämda och obestämda integraler via primitiva funktioner samt standardmetoder som partiell integration, partialbråksuppdelning och variabelbyte."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0066M-5 a et:LearningOutcome ;
    rdfs:label "use integrals for common immediate applications like calculating curve lengths, areas between curves, surfaces of revolution, and volumes of revolution"@en, "använda integraler för vanliga omedelbara tillämpningar som att beräkna kurvlängd, area mellan kurvor, rotationsytor och rotationsareor."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0066M-6 a et:LearningOutcome ;
    rdfs:label "apply central concepts, computational rules, and methods for complex numbers, algebraic equations, and the complex exponential function"@en, "kunna använda centrala begrepp, räkneregler och metoder för komplexa tal, algebraiska ekvationer och den komplexa exponentialfunktionen."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0066M-7 a et:LearningOutcome ;
    rdfs:label "solve simple differential equations such as first-order separable and linear equations, as well as higher-order linear differential equations"@en, "kunna lösa enkla differentialekvationer som första ordningens separabla och linjära ekvationer samt linjära högre ordningens differentialekvationer."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0066M-8 a et:LearningOutcome ;
    rdfs:label "present your calculations in a comprehensible manner"@en, "redovisa dina beräkningar på ett begripligt sätt"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0066M-9 a et:LearningOutcome ;
    rdfs:label "select appropriate solution methods for given problems within the scope of the course."@en, "välja rimlig lösningsmetod för givna problem inom ramen för kursen."@sv ;
    et:outcomeCategory et:judgementAndApproach .

mod:M0066M-0001 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0001" ;
    et:credits 7.5 ;
    et:gradeScale "G U 3 4 5" ;
    et:assesses lo:M0066M-1, lo:M0066M-2, lo:M0066M-3, lo:M0066M-4, lo:M0066M-5, lo:M0066M-6, lo:M0066M-7, lo:M0066M-8, lo:M0066M-9 .


# --- M0067M Linear Algebra ---

c:M0067M a et:Course ;
    schema:courseCode "M0067M" ;
    schema:name "Linear Algebra"@en, "Linjär algebra"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:mathematics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and the courses M0065M Single Variable Calculus 1, 7,5 ECTS and M0066M Single Cariable Calculus 2, 7,5 ECTS or equivalents."@en, "Grundläggande behörighet samt kurserna M0065M Envariabelanalys 1, 7,5 hp och M0066M Envariabelanalys 2, 7,5 hp eller motsvarande."@sv ;
    et:entryRequirementNames c:M0065M, c:M0066M ;
    et:hasOutcome lo:M0067M-1, lo:M0067M-2, lo:M0067M-3, lo:M0067M-4, lo:M0067M-5, lo:M0067M-6, lo:M0067M-7, lo:M0067M-8, lo:M0067M-9 ;
    et:hasAssessment mod:M0067M-0001 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=M0067M> ;
