    et:assessmentType et:writtenExam ;
    et:moduleCode "0004" ;
    et:credits 3.0 ;
    et:gradeScale "G U 3 4 5" .


# --- S7012E Digital communications ---

c:S7012E a et:Course ;
    schema:courseCode "S7012E" ;
    schema:name "Digital communications"@en, "Digital kommunikation"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:signal-processing ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and M0031M Linear Algera and Differential Equations, 7,5 ECTS or M0049M Linear Algebra and Differential Equations, 7,5 ECTS, M0018M Linear Analysis, 7,5 ECTS and S0001E Signal Analysis, 7,5 ECTS or equivalent. Good knowledge in English equivalent to English 6."@en, "Minst 90hp avslutade kurser samt matematik M0031M Linjär algebra och differentialekvationer, 7,5 hp eller M0049M Linjär algebra och differentialekvationer, 7,5 hp, M0018M Linjär analys, 7,5 hp samt S0001E Signalanalys, 7,5 hp eller motsvarande. Goda kunskaper i engelska, motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:M0018M, c:M0031M, c:M0049M, c:S0001E ;
    et:hasOutcome lo:S7012E-1, lo:S7012E-2, lo:S7012E-3, lo:S7012E-4, lo:S7012E-5, lo:S7012E-6, lo:S7012E-7, lo:S7012E-8, lo:S7012E-9, lo:S7012E-10, lo:S7012E-11, lo:S7012E-12, lo:S7012E-13, lo:S7012E-14 ;
    et:hasAssessment mod:S7012E-0003, mod:S7012E-0004 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=S7012E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S7012E&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S7012E&lasPeriod=226> .

lo:S7012E-1 a et:LearningOutcome ;
    rdfs:label "Describe, explain, linear modulation"@en, "Beskriva, förklara linjär modulation"@sv .

lo:S7012E-2 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate communications signals' spectrum and bandwidth"@en, "Beskriva, förklara, beräkna kommunikationssignalers spektrum och bandbredd"@sv .

lo:S7012E-3 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate baseband representation of signals with passband nature"@en, "Beskriva, förklara, beräkna basbandsrepresentation av signaler med passband karaktär"@sv .

lo:S7012E-4 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate signal constellations, their energy, and distance properties"@en, "Beskriva, förklara, beräkna signalkonstellationer, dess energi, och distansegenskaper"@sv .

lo:S7012E-5 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate Nyquist-pulses for communication and their properties"@en, "Beskriva, förklara, beräkna Nyquist-pulser för kommunikation och dess egenskaper"@sv .

lo:S7012E-6 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate how signals can be represented sas vectors"@en, "Beskriva, förklara, beräkna hur signaler kan representeras som vektorer"@sv .

lo:S7012E-7 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate the matched filter"@en, "Beskriva, förklara, beräkna det matchade filtret"@sv .

lo:S7012E-8 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate additive Gaussian noise and its power"@en, "Beskriva, förklara, beräkna det additiva Gaussiska bruset och dess effekt"@sv .

lo:S7012E-9 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate hypothesis tests and detection"@en, "Beskriva, förklara, beräkna hypotestester och detektering"@sv .

lo:S7012E-10 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate MAP- och ML-detector"@en, "Beskriva, förklara, beräkna Map- och ML-detektorn"@sv .

lo:S7012E-11 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate Q-function"@en, "Beskriva, förklara, beräkna Q-funktionen"@sv .

lo:S7012E-12 a et:LearningOutcome ;
    rdfs:label "Describe, explain, calculate detectors’ error probabilities"@en, "Beskriva, förklara, beräkna detektorers felsannolikheter"@sv .

lo:S7012E-13 a et:LearningOutcome ;
    rdfs:label "Describe, explain OFDM"@en, "Beskriva, förklara OFDM"@sv .

lo:S7012E-14 a et:LearningOutcome ;
    rdfs:label "Evaluate and simulate simple digital communications systems in MATLAB."@en, "Utvärdera och simulera enkla digitala kommunikationssystem i MATLAB."@sv .

mod:S7012E-0003 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0003" ;
    et:credits 6.0 ;
    et:gradeScale "G U 3 4 5" .

mod:S7012E-0004 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0004" ;
    et:credits 1.5 ;
    et:gradeScale "U G" .


# --- S7013E Measurement systems: design, modeling and computational methods ---

c:S7013E a et:Course ;
    schema:courseCode "S7013E" ;
    schema:name "Measurement systems: design, modeling and computational methods"@en, "Mätsystem: design, modellering och beräkningsmetoder"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:computer-engineering ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and upper secondary education and documented skills in English language Basic circuit theory, E0003E Circuit Theory, 7,5 ECTS; Mathematical statistics, including probability density functions, expectation and variance, S0001M Mathematical Statistics, 7,5 ECTS; Mathematical analysis, linear algebra, multivariable analysis, Laplace- and Fourier transforms, M0018M Linear Analysis, 7,5 ECTS. Good knowledge in English equivalent to English 6."@en, "Minst 90hp avslutade kurser samt grundläggande elkretsteori inkl. RLC kretsar, E0003E Elkretsteori, 7,5 hp. Matematisk statistik inkluderande täthetsfunktioner, väntevärden och varians, S0001M Matematisk statistik, 7,5 hp samt matematisk analys, linjär algebra, flervariabelanalys, Laplace- och Fouriertransformer, M0018M Linjär analys, 7,5 hp. Goda kunskaper i engelska, motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:E0003E, c:M0018M, c:S0001M ;
    et:hasOutcome lo:S7013E-1, lo:S7013E-2, lo:S7013E-3, lo:S7013E-4, lo:S7013E-5, lo:S7013E-6 ;
    et:hasAssessment mod:S7013E-0003, mod:S7013E-0004, mod:S7013E-0006 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=S7013E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S7013E&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S7013E&lasPeriod=227> .

lo:S7013E-1 a et:LearningOutcome ;
    rdfs:label "Construct basic circuits for measurement of electrical quantities."@en .

lo:S7013E-2 a et:LearningOutcome ;
    rdfs:label "Use and evaluate numerical computational methods for linear and non-linear systems of equations, and to apply these methods for estimating parameters of models of measurement systems."@en .

lo:S7013E-3 a et:LearningOutcome ;
    rdfs:label "Build empirical models of a system and estimate parameters of these."@en .

lo:S7013E-4 a et:LearningOutcome ;
    rdfs:label "Evaluate models with respect to functionality, reliability, and computational complexity."@en .

lo:S7013E-5 a et:LearningOutcome ;
    rdfs:label "Motivate and present the results orally and in written reports."@en .

lo:S7013E-6 a et:LearningOutcome ;
    rdfs:label "The students should also be able to judge: The possibilities and limitations of a given measurement system."@en .

