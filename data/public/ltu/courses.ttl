# --- F7028T Technical wave physics ---

c:F7028T a et:Course ;
    schema:courseCode "F7028T" ;
    schema:name "Technical wave physics"@en, "Teknisk vågfysik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "Bachelor in Engineering Physics. Required previous knowledge: - Basic wave physics corresponding to F0005T, Physics 2 - Deepened knowledge about wave phenomena corresponding to F0048T, Optics and Photonics - Basic understanding of linear systems and signal processing corresponding to S0001E, Signal Analysis - Basic understanding of Electro-magnetism corresponding to F0007T, Electromagnetic Field Theory - Basic understanding of Continuum mechanics corresponding to F0030T, Continuum Mechanics - Skills in Matlab programming corresponding to M0032M, Functions of Several Variables and Computer Tools - Good knowledge in English, equivalent to English 6."@en, "Kandidat i Teknisk fysik där följande ingår: - Grundläggande vågfysik motsvarande F0005T, Fysik 2 - Viss fördjupning kring vågfenomen motsvarande F0048T, Optik och Fotonik - Grundläggande förståelse för linjära system och signalbehandling motsvarande S0001E, Signalanalys - Grundläggande förståelse för elektromagnetism motsvarande F0007T, Elektromagnetisk fältteori - Grundläggande förståelse för kontinuumsmekanik motsvarande F0030T, Kontinuumsmekanik - Färdighet i Matlab motsvarande M0032M, Flervariabelanalys och datorverktyg - Goda kunskaper i engelska motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:F0005T, c:F0007T, c:F0030T, c:F0048T, c:M0032M, c:S0001E ;
    et:hasOutcome lo:F7028T-1, lo:F7028T-2, lo:F7028T-3, lo:F7028T-4, lo:F7028T-5, lo:F7028T-6, lo:F7028T-7, lo:F7028T-8, lo:F7028T-9, lo:F7028T-10, lo:F7028T-11, lo:F7028T-12 ;
    et:hasAssessment mod:F7028T-0002 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F7028T> ;
    et:syllabusDecisionDate "2022-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7028T&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7028T&lasPeriod=226> .

lo:F7028T-1 a et:LearningOutcome ;
    rdfs:label "The overall objectives of the course are to provide students with a fundamental understanding of the origin of waves in many of the branches of physics together with an ability to address, model and solve such problems using different analytical and numerical tools. The course gravitates around optical waves and various metrological applications. After passing the course the student should have the ability to:"@en .

lo:F7028T-2 a et:LearningOutcome ;
    rdfs:label "Describe physical material models based on basic wave phenomena."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7028T-3 a et:LearningOutcome ;
    rdfs:label "Motivate solution strategies in classical wave theory utilizing the general diffraction integral."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7028T-4 a et:LearningOutcome ;
    rdfs:label "Evaluate effects of randomness in wave theory."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7028T-5 a et:LearningOutcome ;
    rdfs:label "Relate the origin of non-linear effects to different physical phenomena."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7028T-6 a et:LearningOutcome ;
    rdfs:label "Make quantitative conclusions about different types of measurement methods."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7028T-7 a et:LearningOutcome ;
    rdfs:label "Formulate solutions to different wave technical problems."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7028T-8 a et:LearningOutcome ;
    rdfs:label "Adapt and modify numerical tools to solve wave technical problems."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7028T-9 a et:LearningOutcome ;
    rdfs:label "Demonstrate an ability to present problems and solutions orally."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7028T-10 a et:LearningOutcome ;
    rdfs:label "Demonstrate an ability to summarize in writing a problem and its solution in a structured and convincing manner."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7028T-11 a et:LearningOutcome ;
    rdfs:label "Defend the model and approach chosen for a given problem."@en ;
    et:outcomeCategory et:judgementAndApproach .

lo:F7028T-12 a et:LearningOutcome ;
    rdfs:label "Relate the results obtained to the problem and models chosen."@en ;
    et:outcomeCategory et:judgementAndApproach .

mod:F7028T-0002 a et:Assessment ;
    rdfs:label "Seminars"@en ;
    et:assessmentType et:oralExam ;
    et:moduleCode "0002" ;
    et:credits 7.5 ;
    et:gradeScale "G U 3 4 5" ;
    et:assesses lo:F7028T-1, lo:F7028T-2, lo:F7028T-3, lo:F7028T-4, lo:F7028T-5, lo:F7028T-6, lo:F7028T-7, lo:F7028T-8, lo:F7028T-9, lo:F7028T-10, lo:F7028T-11, lo:F7028T-12 .


# --- F7030T Chaos and Nonlinear Physics ---

c:F7030T a et:Course ;
    schema:courseCode "F7030T" ;
    schema:name "Chaos and Nonlinear Physics"@en, "Kaos och Ickelinjär Fysik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "Physics 30hp and Linear Algebra."@en, "Fysik 30 hp samt grundläggande linjär algebra och analys."@sv ;
    et:hasOutcome lo:F7030T-1 ;
    et:hasAssessment mod:F7030T-0002 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F7030T> ;
    et:syllabusDecisionDate "2021-02-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7030T&lasPeriod=225&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7030T&lasPeriod=225> .

lo:F7030T-1 a et:LearningOutcome ;
    rdfs:label "It is well known that all physical systems (except in quantum mechanics) are nonlinear. Former limitations to linear systems was of practical nature, as they generally were the only ones which could be exactly solved. By working with user-friendly computer software like Maple the knowledge gained can be applied to problems that would be impossible to study by \"paper and pen alone\". To teach basic methods of nonlinear physics, which the student can use in his/her continued education, reserch of future work."@en, "Du har som student fått en inblick i att ickelinjär fysik är ett vetenskapsfält under mycket stark frammarsch samt att alla fysikaliska system (förutom inom kvantmekanik) är ickelinjära, samt att tidigare begränsningar till approximativa linjära system var av praktisk natur, eftersom de generellt var de enda som kunde lösas. Du har kunskap om grundläggande metoder för ickelinjär fysik, som du kan använda i din fortsatta utbildning, forskning eller inom industrin/näringslivet."@sv .

mod:F7030T-0002 a et:Assessment ;
    rdfs:label "Assignments"@en ;
    et:assessmentType et:assignment ;
    et:moduleCode "0002" ;
    et:credits 7.5 ;
    et:gradeScale "G U 3 4 5" ;
    et:assesses lo:F7030T-1 .


# --- F7035T Statistical Physics and Thermodynamics ---

c:F7035T a et:Course ;
    schema:courseCode "F7035T" ;
    schema:name "Statistical Physics and Thermodynamics"@en, "Statistisk fysik och termodynamik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "Quantum physics (F0047T) or equivalent, as well as basic programming skills. Proficiency in English equivalent to Swedish upper secondary course English 6/level 2."@en, "Kvantfysik (F0047T) eller motsvarande samt kunskaper i programmering. Goda kunskaper i engelska motsvarande Engelska 6/nivå 2."@sv ;
    et:entryRequirementNames c:F0047T ;
    et:hasOutcome lo:F7035T-1, lo:F7035T-2, lo:F7035T-3, lo:F7035T-4, lo:F7035T-5, lo:F7035T-6, lo:F7035T-7, lo:F7035T-8, lo:F7035T-9, lo:F7035T-10, lo:F7035T-11, lo:F7035T-12 ;
    et:hasAssessment mod:F7035T-0001, mod:F7035T-0004 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F7035T> ;
    et:syllabusDecisionDate "2011-02-07"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7035T&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7035T&lasPeriod=226> .

lo:F7035T-1 a et:LearningOutcome ;
    rdfs:label "Define the fundamental assumptions of statistical physics."@en, "Definiera grundläggande antaganden inom statistisk fysiken."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7035T-2 a et:LearningOutcome ;
    rdfs:label "Explain the meaning of the microcanonical, canonical and grand canonical ensembles."@en, "Förklara innebörden av mikrokannoniska, kannoniska och storkannoniska ensemblen."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7035T-3 a et:LearningOutcome ;
    rdfs:label "Describe the macroscopic and microscopic interpretations of temperature, entropy and free energy."@en, "Redogöra för den makroskopiska respektive den mikroskopiska beskrivningen av temperatur, entropi och frienergi"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7035T-4 a et:LearningOutcome ;
    rdfs:label "Describe the Bose–Einstein and Fermi–Dirac distribution functions, as well as the classical limit."@en, "Beskriva Bose-Einstein och Fermi-Dirac fördelningsfunktioner och den klassiska gränsen."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7035T-5 a et:LearningOutcome ;
    rdfs:label "Define and apply concepts such as Helmholtz free energy, Gibbs free energy and entropy."@en, "Kunna definiera och använda begrepp som fria energin, Gibbs fria energi och entropi."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7035T-6 a et:LearningOutcome ;
    rdfs:label "Apply the fundamental assumptions of statistical physics."@en, "Tillämpa grundläggande antaganden inom statistisk fysiken"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7035T-7 a et:LearningOutcome ;
    rdfs:label "Apply the Bose–Einstein and Fermi–Dirac distribution functions."@en, "Tillämpa Bose-Einstein och Fermi-Dirac fördelningsfunktioner"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7035T-8 a et:LearningOutcome ;
    rdfs:label "Perform basic mean-field calculations."@en, "Göra enklare medelfälts beräkningar."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7035T-9 a et:LearningOutcome ;
    rdfs:label "Design and implement basic Monte Carlo simulations."@en, "Planera och utföra enklare Monte-Carlo program"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7035T-10 a et:LearningOutcome ;
    rdfs:label "Solve practical problems within the subject areas covered by the course."@en, "Kunna lösa praktiska problem inom kursens relevanta områdena"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7035T-11 a et:LearningOutcome ;
    rdfs:label "Analyze, present and discuss results obtained from Monte Carlo simulations."@en, "Analysera, presentera och diskutera resultat från Monte-Carlo simuleringar"@sv ;
    et:outcomeCategory et:judgementAndApproach .

lo:F7035T-12 a et:LearningOutcome ;
    rdfs:label "Provide scientific feedback on, and critically discuss, own project as well as others’ project outcomes."@en, "På ett vetenskapligt sätt, ge återkoppling på och diskutera egna och andras projektredovisningar"@sv ;
    et:outcomeCategory et:judgementAndApproach .

mod:F7035T-0001 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0001" ;
    et:credits 5.0 ;
    et:gradeScale "G U 3 4 5" .

mod:F7035T-0004 a et:Assessment ;
    rdfs:label "Project and oral presentation"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0004" ;
    et:credits 2.5 ;
    et:gradeScale "U G" .


# --- F7037T Modern Experimental Metrology ---

c:F7037T a et:Course ;
    schema:courseCode "F7037T" ;
    schema:name "Modern Experimental Metrology"@en, "Modern experimentell mätteknik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:experimental-mechanics ;
    schema:coursePrerequisites "Bachelor or equivalent degree with the subject physics and/or Electrical Engineering, Mechanical Engineering, Electronics , Microcomputer Systems and Control Engineering, Computational Science and Engineering Physics, including the course E7021E Measurement Technology and Uncertainty Analysis, or corresponding courses."@en, "Kandidatexamen eller motsvarande inom ämnesområdet Teknisk fysik, Maskinteknik eller Elektroteknik inklusive kursen E7021E Mätteknik och felanalys eller motsvarande."@sv ;
    et:entryRequirementNames c:E7021E ;
    et:hasOutcome lo:F7037T-1, lo:F7037T-2, lo:F7037T-3, lo:F7037T-4, lo:F7037T-5, lo:F7037T-6, lo:F7037T-7 ;
    et:hasAssessment mod:F7037T-0005, mod:F7037T-0006 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F7037T> ;
    et:syllabusDecisionDate "2021-02-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7037T&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7037T&lasPeriod=227> .

lo:F7037T-1 a et:LearningOutcome ;
    rdfs:label "After completion of the course the student will have acquired: the ability to plan and perform experimental work through the experience and the knowledge given by the experimental methods treated and experienced in the course"@en, "planera och utföra experimentellt arbete samt ha en förmåga att sätta sig in i likartade experimentella metoder som ligger utanför kursens ram."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7037T-2 a et:LearningOutcome ;
    rdfs:label "knowledge to adapt similar experimental methods outside of the scope of this course"@en, "uppvisa djupgående förståelse om rapport/artikelskrivning och muntlig framställning."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7037T-3 a et:LearningOutcome ;
    rdfs:label "Skill and ability After accomplishing this course the student should be able to choose an appropriate experimental method for a given measurement challenge"@en, "välja lämplig experimentell metod för ett givet mätproblem,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7037T-4 a et:LearningOutcome ;
    rdfs:label "plan, design and perform an experiment"@en, "planera, ställa upp och genomföra ett experiment,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7037T-5 a et:LearningOutcome ;
    rdfs:label "evaluate the quality of the experimental result"@en, "värdera kvalitén på resultaten från experimentet,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7037T-6 a et:LearningOutcome ;
    rdfs:label "evaluate experimental results in relation to physics"@en, "värdera resultaten från experimenten i relation till fysiken,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7037T-7 a et:LearningOutcome ;
    rdfs:label "present the results orally to an audience"@en, "presentera resultaten både skriftligt och muntligt."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

mod:F7037T-0005 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0005" ;
    et:credits 3.5 ;
    et:gradeScale "U G" .

mod:F7037T-0006 a et:Assessment ;
    rdfs:label "Report/Oral Presentation"@en ;
    et:assessmentType et:oralExam ;
    et:moduleCode "0006" ;
    et:credits 4.0 ;
    et:gradeScale "U G" .


# --- F7041T Theory of Relativity ---

c:F7041T a et:Course ;
    schema:courseCode "F7041T" ;
    schema:name "Theory of Relativity"@en, "Relativitetsteori"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "Calculus M0029M, Linear Algebra and Differential Equations M0031M or equivalent."@en, "M0029M Differentialkalkyl, M0030M Linjär algebra och integralkalkyl, M0031M Linjär algebra och differentialekvationer, M0032M Flervariabelanalys och datorverktyg eller motsvarande samt F0004T Fysik1, F0005T Fysik2, F0006T Fysik3 eller motsvarande."@sv ;
    et:entryRequirementNames c:M0029M, c:M0031M ;
    et:hasOutcome lo:F7041T-1 ;
    et:hasAssessment mod:F7041T-0001 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F7041T> ;
    et:syllabusDecisionDate "2022-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7041T&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7041T&lasPeriod=226> .

lo:F7041T-1 a et:LearningOutcome ;
    rdfs:label "This course introduces Einstein´s theory of relativity. The course covers general relativity, gravitation and cosmology."@en, "Efter genomgången kurs har du som student fått en inblick i Einsteins relativitetsteori. Speciellt områdena allmän relativitet, gravitationsteori och kosmologi."@sv .

mod:F7041T-0001 a et:Assessment ;
    rdfs:label "Home Assignments"@en ;
    et:assessmentType et:assignment ;
    et:moduleCode "0001" ;
    et:credits 7.5 ;
    et:gradeScale "G U 3 4 5" ;
    et:assesses lo:F7041T-1 .


# --- F7045T Solid State Physics ---

c:F7045T a et:Course ;
    schema:courseCode "F7045T" ;
    schema:name "Solid State Physics"@en, "Fasta tillståndets fysik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "Quantum physics corresponding F0047T, how to write simple computer programs such D0009E, Mathematical physics corresponding M0014M, Linear analysis corresponding M0018M"@en, "Kvantfysik motsvarande F0047T, kunna skriva enklare datorprogram tex D0009E, Matematisk fysik motsvarande M0014M, Linjär analys motsvarande M0018M"@sv ;
    et:entryRequirementNames c:D0009E, c:F0047T, c:M0014M, c:M0018M ;
    et:hasOutcome lo:F7045T-1, lo:F7045T-2, lo:F7045T-3, lo:F7045T-4, lo:F7045T-5 ;
    et:hasAssessment mod:F7045T-0005, mod:F7045T-0007, mod:F7045T-0008 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F7045T> ;
    et:syllabusDecisionDate "2023-01-16"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7045T&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7045T&lasPeriod=227> .

lo:F7045T-1 a et:LearningOutcome ;
    rdfs:label "explain the basic concepts that are used to describe the structure and physical properties of crystalline substances,"@en, "förklara de grundläggande begrepp och modeller som används för att beskriva kristallina ämnens uppbyggnad och fysikaliska egenskaper,"@sv .

lo:F7045T-2 a et:LearningOutcome ;
    rdfs:label "use physical models to perform calculations of the properties of solids,"@en, "använda fysikaliska modeller för att utföra beräkningar av kristallina ämnens egenskaper,"@sv .

lo:F7045T-3 a et:LearningOutcome ;
    rdfs:label "analyze and discuss measurement data based on theoretical models,"@en, "analysera och diskutera mätdata utifrån teoretiska modeller,"@sv .

lo:F7045T-4 a et:LearningOutcome ;
    rdfs:label "summarize, present and communicate results from experiments,"@en, "sammanfatta, presentera och kommunicera resultat från experiment,"@sv .

lo:F7045T-5 a et:LearningOutcome ;
    rdfs:label "give an overview of an application related to the physical phenomena treated in the course"@en, "översiktligt redogöra för något tillämpningsområde av de fenomen som behandlas i kursen."@sv .

