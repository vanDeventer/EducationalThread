    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7024T&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7024T&lasPeriod=227> .

lo:F7024T-1 a et:LearningOutcome ;
    rdfs:label "At the end of the course the student should have basic knowledge about"@en .

lo:F7024T-2 a et:LearningOutcome ;
    rdfs:label "The finite element method"@en .

lo:F7024T-3 a et:LearningOutcome ;
    rdfs:label "How to formulate mathematical models describing physical and technical problems in a suitable form appropriate for the finite element method."@en .

lo:F7024T-4 a et:LearningOutcome ;
    rdfs:label "How to use the simulation software Comsol Multiphysics to simulate physical and technical processes in which several disciplines in science and engineering are coupled. -Orientation of how the software and simulation tool is used in actual research in university and industry."@en .

