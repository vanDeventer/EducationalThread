    et:assessmentType et:writtenExam ;
    et:moduleCode "0006" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .


# --- F0051T Engineering science ---

c:F0051T a et:Course ;
    schema:courseCode "F0051T" ;
    schema:name "Engineering science"@en, "Ingenjörsvetenskap"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:engineering-mechanics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language + Swedish upper secondary school courses Physics 2, Chemistry 1, Mathematics 4 or Mathematics E. Or: Physics level 2, Chemistry level 1, Mathematics Further level 2 or Mathematics E."@en, "Grundläggande behörighet + Fysik 2, Kemi 1, Matematik 4 eller Matematik E. Eller: Fysik nivå 2, Kemi nivå 1, Matematik fortsättning nivå 2 (äldre kurs Matematik E)."@sv ;
    et:hasOutcome lo:F0051T-1, lo:F0051T-2, lo:F0051T-3, lo:F0051T-4, lo:F0051T-5, lo:F0051T-6, lo:F0051T-7, lo:F0051T-8 ;
