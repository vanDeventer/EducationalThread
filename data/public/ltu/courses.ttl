# --- C7005M Numerics for Optimization and PDE ---

c:C7005M a et:Course ;
    schema:courseCode "C7005M" ;
    schema:name "Numerics for Optimization and PDE"@en, "Numerik för optimering och PDE"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:scientific-computing ;
    schema:coursePrerequisites "Mathematics including linear algebra and multivariable calculus (e.g. M0029M-M0032M at LTU). Programming skills in Matlab or in some other programming language. Knowledge of basic Numerics ( e.g., C0004M or S7013E at LTU)"@en, "Matematik innehållande linjär algebra och analys i en och flera variabler (t.e.x M0029M-M0032M vid LTU) . Programmering i Matlab eller annat programmeringsspråk samt grundläggande numerik ( t.ex. C0004M, eller S7013E vid LTU)"@sv ;
    et:entryRequirementNames c:C0004M, c:M0029M, c:M0032M, c:S7013E ;
    et:hasOutcome lo:C7005M-1, lo:C7005M-2, lo:C7005M-3, lo:C7005M-4, lo:C7005M-5, lo:C7005M-6, lo:C7005M-7 ;
    et:hasAssessment mod:C7005M-0001, mod:C7005M-0002 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=C7005M> ;
    et:syllabusDecisionDate "2021-02-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=C7005M&lasPeriod=225&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=C7005M&lasPeriod=225> .

lo:C7005M-1 a et:LearningOutcome ;
    rdfs:label "explain how different sources of errors affect the accuracy in computations."@en, "förklara hur olika felkällor påverkar noggrannheten vid datorberäkningar"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:C7005M-2 a et:LearningOutcome ;
    rdfs:label "derive computational algorithms based on fundamental techniques such as linearisation, iteration, and discretisation"@en, "härleda beräkningsalgoritmer baserade på grundläggande tekniker, såsom t.ex. linjarisering, iterering och diskretisering"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:C7005M-3 a et:LearningOutcome ;
    rdfs:label "use numerical methods and existing software for solving advanced computational problems, such as e.g. optimization problems and partial differential equations"@en, "använda numeriska metoder och befintlig programvara för att lösa avancerade beräkningsproblem inom optimering och partiella differentialekvationer"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:C7005M-4 a et:LearningOutcome ;
    rdfs:label "implement different methods on a computer"@en, "implementera olika beräkningsalgoritmer på dator"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:C7005M-5 a et:LearningOutcome ;
    rdfs:label "formulate and communicate issues regarding computational problems"@en, "formulera och kommunicera beräkningstekniska frågeställningar och hur dessa löses"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:C7005M-6 a et:LearningOutcome ;
    rdfs:label "Assessment and attitudes judge different methods regarding strengths, weaknesses and usability."@en, "Värdering och förhållningssätt bedöma olika metoders styrka, svagheter och tillämpbarhet"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:C7005M-7 a et:LearningOutcome ;
    rdfs:label "judge the reliability of computed results."@en, "värdera tillförlitligheten i beräknade resultat."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

mod:C7005M-0001 a et:Assessment ;
    rdfs:label "Exam"@en ;
    et:assessmentType et:otherAssessment ;
    et:moduleCode "0001" ;
    et:credits 4.0 ;
    et:gradeScale "G U 3 4 5" .

mod:C7005M-0002 a et:Assessment ;
    rdfs:label "Assignments"@en ;
    et:assessmentType et:assignment ;
    et:moduleCode "0002" ;
    et:credits 3.5 ;
    et:gradeScale "U G#" .


# --- D0009E Introduction to Programming ---

c:D0009E a et:Course ;
    schema:courseCode "D0009E" ;
    schema:name "Introduction to Programming"@en, "Introduktion till programmering"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:computer-science ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language + Swedish upper secondary school courses Mathematics 3c or Mathematics D. Or: Mathematics Further level 1c."@en, "Grundläggande behörighet + Matematik 3c eller Matematik D. Eller: Matematik fortsättning nivå 1c."@sv ;
    et:hasOutcome lo:D0009E-1, lo:D0009E-2, lo:D0009E-3 ;
    et:hasAssessment mod:D0009E-0003, mod:D0009E-0004 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=D0009E> ;
    et:syllabusDecisionDate "2023-02-15"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D0009E&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D0009E&lasPeriod=226> .

lo:D0009E-1 a et:LearningOutcome ;
    rdfs:label "Demonstrate knowledge of proven experience in design and construction of imperative programs and capacity to plan and carry out advanced tasks in the form of implementation of imperative programs designed to solve specific technical problems."@en, "Visa kunskap om beprövad erfarenhet i grundläggande design och konstruktion av imperativa program samt förmåga att planera och genomföra kvalificerade uppgifter i form av implementation av imperativa program som syftar till att lösa grundläggande specifika tekniska problem."@sv .

lo:D0009E-2 a et:LearningOutcome ;
    rdfs:label "Demonstrate the ability to model problems and to identify and formulate solutions in a modern imperative language."@en, "Visa förmåga att med en helhetssyn för relevanta problemställningar, modellera problemet samt självständigt identifiera och formulera lösningar i ett modernt imperativt programspråk."@sv .

lo:D0009E-3 a et:LearningOutcome ;
    rdfs:label "Demonstrate the ability to critically analyze and evaluate technical solutions in the form of existing programs in imperative languages , as well as predict and evaluate sequences of events in these."@en, "Visa förmåga att kritiskt utvärdera och analysera tekniska lösningar i form av befintliga program i imperativa språk på en grundläggande nivå samt förutsäga och utvärdera skeenden dessa."@sv .

mod:D0009E-0003 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0003" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .

mod:D0009E-0004 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0004" ;
    et:credits 3.0 ;
    et:gradeScale "U G" .


# --- D0013E Microcomputer engineering ---

c:D0013E a et:Course ;
    schema:courseCode "D0013E" ;
    schema:name "Microcomputer engineering"@en, "Mikrodatorteknik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:embedded-systems ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and basic programming skills (D0009E Introduction to Programming)."@en, "Grundläggande behörighet samt grundläggande kunskaper i programmering (motsvarande D0009E Introduktion till programmering)."@sv ;
    et:entryRequirementNames c:D0009E ;
    et:hasOutcome lo:D0013E-1, lo:D0013E-2, lo:D0013E-3, lo:D0013E-4, lo:D0013E-5 ;
    et:hasAssessment mod:D0013E-0002, mod:D0013E-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=D0013E> ;
    et:syllabusDecisionDate "2021-02-12"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D0013E&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D0013E&lasPeriod=224> .

lo:D0013E-1 a et:LearningOutcome ;
    rdfs:label "Demonstrate knowledge of the disciplinary foundation of and proven experience in the field of micro- computer engineering as well as insight into current research and development work. This is shown in laboratory and theoretical assignments."@en, "Studentent skall: Inom området Mikrodatorteknik visa kunskap om beprövad erfarenhet samt dess vetenskapliga grund. Detta; visas vid laborationer samt teoretiska frågor vid skriftlig examination."@sv .

lo:D0013E-2 a et:LearningOutcome ;
    rdfs:label "Demonstrate the ability to identify, formulate and deal with issues autonomously and creatively and to analyse and evaluate technological solutions. This is shown through designing and analyzing embedded software for a modern pipelined processor)"@en, "Visa förmåga att skapa, utvärdera och analysera tekniska lösningar mha inbyggd mjukvara . Detta visas genom att laborativt konstruera och analysera mjukvara för en modern pipelinad processor."@sv .

lo:D0013E-3 a et:LearningOutcome ;
    rdfs:label "Demonstrate the ability to integrate knowledge critically and systematically as well as the ability to model, simulate, predict and evaluate sequences of events even with limited information. This is shown through designing and analyzing a multi-threaded scheduler."@en, "Visa förmåga att kritiskt, självständigt analysera, modellera komplexa problemställningar och med adekvata metoder planera och lösa problem mha inbyggd mjukvara. Detta visas genom att laborativt konstruera och analysera en multitrådad schemaläggare ."@sv .

lo:D0013E-4 a et:LearningOutcome ;
    rdfs:label "Demonstrate the ability to identify the need for further knowledge and undertake ongoing development of his or her skills. This is shown in laboratory and project assignments which require gathering of information and critical evaluation."@en, "Visa förmåga att identifiera sitt behov av och inhämta ytterligare kunskap genom att lösa problem som kräver inhämtning av avsevärd kunskapsmängd på egen hand. Detta visas genom kursens laborativa moment vilka kräver egen kunskapsinhämtning samt flektion."@sv .

lo:D0013E-5 a et:LearningOutcome ;
    rdfs:label "Demonstrate insight into research and development though understanding the possibilities and limitations of embedded systems technology. This is shown through laboratory and project assignments, highlighting the trade-offs between hard- and software."@en, "Visa insikt i forsknings- och utvecklingsarbete genom att förstå begränsningar och möjligheter med mikroprocessorbaserade system. Detta visas genom kursens laborativa moment, vilka visar på trade-off mellan hård och mjukvara."@sv .

mod:D0013E-0002 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0002" ;
    et:credits 3.0 ;
    et:gradeScale "U G#" .

mod:D0013E-0003 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0003" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .


# --- D0042E AI and Machine Learning for Engineering Studies ---

c:D0042E a et:Course ;
    schema:courseCode "D0042E" ;
    schema:name "AI and Machine Learning for Engineering Studies"@en, "AI och maskininlärning för civilingenjörer"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:computer-science ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and Differential calculus (e.g. M0065M, M0047M, or equivalent), linear algebra (e.g., M0067M Linear Algebra, 7,5 ECTS, M0048M Linear Algebra and Integral Calculus, 7,5 ECTS, or equivalent), basic imperative programming (e.g., D0009E Introduction to Programming, 7,5 ECTS, D0028E Programming and Digitalisation, 7,5 ECTS, D0036E Programming for Machine Learning, 7,5 ECTS, or similar), basic statistics (e.g., S0001M Mathematical Statistics, 7,5 ECTS, S0008M Probability Theory and Statistics, 7,5 ECTS, or equivalent)."@en, "Grundläggande behörighet samt Differentialkalkyl (t.ex. M0065M Envariabelanalys 1, 7,5 hp eller M0047M Differentialkalkyl, 7,5 hp eller motsvarande), linjär algebra (t.ex. M0067M Linjär algebra, 7,5 hp, M0048M Linjär algebra och integralkalkyl, 7,5 hp eller motsvarande), grundläggande imperativ programmering (t.ex. D0009E Introduktion till programmering, 7,5 hp, D0028E Introduktion till programmering, 7,5 hp, D0036E Programmering för maskininlärning, 7,5 hp eller motsvarande), grundläggande statistik (t.ex. S0001M Matematisk statistik, 7,5 hp, S0008M Sannolikhetslära och statistik, 7,5 hp eller motsvarande)."@sv ;
    et:entryRequirementNames c:D0009E, c:D0028E, c:D0036E, c:M0047M, c:M0048M, c:M0065M, c:M0067M, c:S0001M, c:S0008M ;
    et:hasOutcome lo:D0042E-1, lo:D0042E-2, lo:D0042E-3, lo:D0042E-4, lo:D0042E-5, lo:D0042E-6 ;
    et:hasAssessment mod:D0042E-0004, mod:D0042E-0005, mod:D0042E-0006, mod:D0042E-0007 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=D0042E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D0042E&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D0042E&lasPeriod=227> .

lo:D0042E-1 a et:LearningOutcome ;
    rdfs:label "Describe the definition, role, and history of AI"@en, "Beskriva definitionen, betydelsen och historien för AI."@sv .

lo:D0042E-2 a et:LearningOutcome ;
    rdfs:label "Efficiently and effectively use AI methods in engineering studies"@en, "Effektivt och ändamålsenligt använda AI-metoder i ingenjörsstudier."@sv .

lo:D0042E-3 a et:LearningOutcome ;
    rdfs:label "Describe standard machine learning and data analytics theories and methods used in engineering applications."@en, "Beskriva standardteorier och metoder inom maskininlärning och dataanalys som används i ingenjörstillämpningar."@sv .

lo:D0042E-4 a et:LearningOutcome ;
    rdfs:label "Implement and apply variations of the basic data analytics, machine learning and AI concepts introduced in the course material and assess the validity of the results"@en, "Implementera och tillämpa variationer av de grundläggande dataanalys-, maskininlärnings- och AI-koncepten som introducerats i kursmaterialet och bedöma resultatens giltighet."@sv .

lo:D0042E-5 a et:LearningOutcome ;
    rdfs:label "Present project work orally and in written form and give constructive feedback on other presentations."@en, "Presentera projektarbete muntligt och skriftligt samt ge konstruktiv feedback på andras presentationer."@sv .

lo:D0042E-6 a et:LearningOutcome ;
    rdfs:label "Assessment of the possibilities and limitations of AI, its role in society and people's responsibility for how it is used, including social and economic aspects as well as environmental, work environment and gender equality aspects."@en, "Bedöma möjligheterna och begränsningarna med AI, dess roll i samhället och människors ansvar för hur den används, inklusive sociala och ekonomiska aspekter samt miljö-, arbetsmiljö- och jämställdhetsaspekter."@sv .

mod:D0042E-0004 a et:Assessment ;
    rdfs:label "Project"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0004" ;
    et:credits 3.0 ;
    et:gradeScale "G U 3 4 5" .

mod:D0042E-0005 a et:Assessment ;
    rdfs:label "Deepening module"@en ;
    et:assessmentType et:otherAssessment ;
    et:moduleCode "0005" ;
    et:credits 1.5 ;
    et:gradeScale "U G" .

mod:D0042E-0006 a et:Assessment ;
    rdfs:label "Machine learning and data analytics in engineering"@en ;
    et:assessmentType et:otherAssessment ;
    et:moduleCode "0006" ;
    et:credits 1.5 ;
    et:gradeScale "U G" .

mod:D0042E-0007 a et:Assessment ;
    rdfs:label "Introduction to AI for engineering studies"@en ;
    et:assessmentType et:otherAssessment ;
    et:moduleCode "0007" ;
    et:credits 1.5 ;
    et:gradeScale "U G" .


# --- D7046E Neural networks and learning machines ---

c:D7046E a et:Course ;
    schema:courseCode "D7046E" ;
    schema:name "Neural networks and learning machines"@en, "Neuronnät och lärande maskiner"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:computer-engineering ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and understanding of mathematical analysis and linear algebra; ability to develop and apply computer programs to solve mathematically formulated problems, eg D0009E Introduction to Programming, 7,5 ECTS or D0017E Introduction to Programming for Engineers, 7,5 ECTS. understanding of basic mathematical statistics including probability distributions, expectation and variance, such as S0001M Mathematical Statistics, 7,5 ECTS or S0008M Probability Theory and Statistics, 7,T ECTS; understanding of basic signal processing including sampling, time-discrete processing of time-continuous signals, linear and time-invariant systems, such as S0001E Signal Analysis, 7,5 ECTS or S0004E Signals and Systems, 7,5 ECTS; understanding of basic electrical theory including RC circuits, eg E0003E Electric Circuit Theory, 7,5 ECTS or E0013E Fundamentals of Electrical Engineering, 7,5 ECTS. Good knowledge in English equivalent to English 6. More information about English language requirements [http://www.ltu.se/edu/bli-student/Application- process/English-language-requirements-1.109316?l=en].\""@en, "Minst 90hp avklarade kurser samt förståelse för matematisk analys och linjär algebra; förmåga att utveckla och tillämpa datorprogram för att lösa matematiskt formulerade problem, tex D0009E Introduktion till programmering, 7,5 hp eller D0017E Introduktion till programmering för ingenjörer, 7,5 hp förståelse för grundläggande matematisk statistik inklusive sannolikhetsfördelningar, väntevärde och varians, tex S0001M Matematisk statistik, 7,5 hp eller S0008M Sannolikhetslära och statistik, 7,5 hp förståelse för grundläggande signalbehandling inklusive sampling, tidsdiskret behandling av tidskontinuerliga signaler, linjära och tidsinvarianta system, tex S0001E Signalanalys, 7,5 hp eller S0004E Signaler och system, 7,5 hp. Förståelse för grundläggande elkretsteori inklusive RC kretsar, tex E0003E Elkretsteori, 7,5 hp eller E0013E Grundkurs i elektroteknik, 7,5 hp. Goda kunskaper i engelska, motsvarande Engelska 6"@sv ;
    et:entryRequirementNames c:D0009E, c:D0017E, c:E0003E, c:E0013E, c:S0001E, c:S0001M, c:S0004E, c:S0008M ;
    et:hasOutcome lo:D7046E-1, lo:D7046E-2, lo:D7046E-3, lo:D7046E-4, lo:D7046E-5, lo:D7046E-6, lo:D7046E-7 ;
    et:hasAssessment mod:D7046E-0005, mod:D7046E-0006, mod:D7046E-0007 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=D7046E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D7046E&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D7046E&lasPeriod=226> .

lo:D7046E-1 a et:LearningOutcome ;
    rdfs:label "Describe and differentiate artificial intelligence, machine learning, artificial neural networks, and neuromorphic engineering."@en, "Beskriva och differentiera begreppen artificiell intelligens, maskininlärning, artificiella neurala nätverk och neuromorf teknik."@sv .

lo:D7046E-2 a et:LearningOutcome ;
    rdfs:label "Describe the function of formal neuron models and neural network architectures, including spiking neural networks, feedforward networks, convolutional networks and recurrent networks."@en, "Beskriva formella neuronmodeller och neurala nätverksarkitekturer, inklusive spikande neurala nätverk, feedforward nätverk, faltningsnätverk och återkopplade nätverk."@sv .

lo:D7046E-3 a et:LearningOutcome ;
    rdfs:label "Demonstrate how neural networks can be trained, validated and tested with supervised and unsupervised methods and analyse how different hyperparameters and regularization affect model generalisation."@en, "Demonstrera hur neurala nätverk kan tränas, valideras och testas med övervakade och oövervakade träningsmetoder samt analysera hur olika hyperparametrar och regularisering påverkar modellers generaliseringsegenskaper."@sv .

lo:D7046E-4 a et:LearningOutcome ;
    rdfs:label "Evaluate strengths and weaknesses of neural network models and make comparisons with other machine learning methods like linear and logistic regression, including the aspects of computing requirements, data requirements, bias, variability, sensitivity and generalisation."@en, "Utvärdera styrkor och svagheter för neurala nätverksmodeller och jämföra dessa med andra maskininlärningsmetoder som linjär och logistisk regression, i avseendena nödvändig datavolym, beräkningsbehov, bias, varians, känslighet och generalisering."@sv .

lo:D7046E-5 a et:LearningOutcome ;
    rdfs:label "Give examples of learning machines involving neural network processors and neuromorphic systems and describe their properties and motivation, including ethical considerations."@en, "Ge exempel på lärande maskiner med neurala nätverksprocessorer och neuromorfa system samt beskriva systemens egenskaper och motivering, inklusive etiska överväganden."@sv .

lo:D7046E-6 a et:LearningOutcome ;
    rdfs:label "Develop and evaluate a neural network model that address a particular engineering problem, which involves for example pattern recognition, clustering, regression, anomaly detection, recommender systems, or reinforcement learning."@en, "Utveckla och utvärdera en neural nätverksmodell som löser ett ingenjörsmässigt problem, som till exempel innefattar mönsterigenkänning, klusteranalys, regression, anomalidetektering, rekommendationssystem, reinforcement learning."@sv .

lo:D7046E-7 a et:LearningOutcome ;
    rdfs:label "Formulate and implement derivations of basic neural network concepts introduced in the course material and assess the validity of the results."@en, "Formulera och implementera vidareutvecklade varianter av grundläggande koncept som introduceras i kursmaterialet och bedöma resultatens giltighet."@sv .

mod:D7046E-0005 a et:Assessment ;
    rdfs:label "Self-assessment and oral exam"@en ;
    et:assessmentType et:oralExam ;
    et:moduleCode "0005" ;
    et:credits 3.5 ;
    et:gradeScale "G U 3 4 5" .

mod:D7046E-0006 a et:Assessment ;
    rdfs:label "Computer exercises"@en ;
    et:assessmentType et:otherAssessment ;
    et:moduleCode "0006" ;
    et:credits 2.0 ;
    et:gradeScale "U G" .

mod:D7046E-0007 a et:Assessment ;
    rdfs:label "Project work"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0007" ;
    et:credits 2.0 ;
    et:gradeScale "U G" .


# --- D7047E Advanced deep learning ---

c:D7047E a et:Course ;
    schema:courseCode "D7047E" ;
    schema:name "Advanced deep learning"@en, "Avancerad djupinlärning"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:computer-science ;
    schema:coursePrerequisites "Bachelor's degree of at least 180 credits in a relevant area such as Computer Science, Engineering Physics, Electrical Engineering, Information Systems, Systems Science, or a closely related area. The studies shall have included Introductory Programming (for example D0009E Intruoduction to Programming or D0007N Objectoriented programming) and a fundamental Machine Learning course such as D7046E Neural networks and learning machines, or equivalent. Knowledge in English equivalent to English 6."@en, "Kandidatexamen om minst 180 högskolepoäng inom ett relevant område som datavetenskap, teknisk fysik, elektroteknik, informationssystem, systemvetenskap eller ett närbesläktat område. Studierna skall ha inkluderat introduktion i programmering (exempelvis D0009E Introduktion till programmering eller D0007N Objektorienterat programutveckling) och en grundläggande maskininlärningskurs, som till exempel D7046E Neurala nätverk och lärande maskiner eller motsvarande. Kunskaper i engelska motsvarande Engelska 6"@sv ;
    et:entryRequirementNames c:D0007N, c:D0009E, c:D7046E ;
    et:hasOutcome lo:D7047E-1 ;
    et:hasAssessment mod:D7047E-0004, mod:D7047E-0005, mod:D7047E-0006 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=D7047E> ;
    et:syllabusDecisionDate "2026-02-13"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D7047E&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D7047E&lasPeriod=227> .

lo:D7047E-1 a et:LearningOutcome ;
    rdfs:label "[1]. Explain and use the advanced deep learning concepts & techniques [2]. Describe how those advanced techniques work [3]. Explain how the advanced techniques are, or should be, used in organizations [4]. Evaluate results of applying the advanced analytics techniques [5]. Analyze and reflect on the relationship between the techniques, the dataset, the problem or opportunity in hand, and the tools and technology used"@en, "[1]. Förklara och använd avancerade begrepp och metoder för djupinlärning [2]. Beskriva hur de avancerade metoderna fungerar [3]. Förklara hur avancerade metoder för djupinlärning används och bör användas i organisationer [4]. Utvärdera resultat i tillämpningar av avancerade analysmetoder [5]. Analysera och reflektera över förhållandet mellan metoderna, datasetet, problemet/möjligheten som undersöks samt de verktyg och metoder som används"@sv .

mod:D7047E-0004 a et:Assessment ;
    rdfs:label "Written exam/Individual exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0004" ;
    et:credits 4.0 ;
    et:gradeScale "G U 3 4 5" .

mod:D7047E-0005 a et:Assessment ;
    rdfs:label "Individual tasks"@en ;
    et:assessmentType et:otherAssessment ;
    et:moduleCode "0005" ;
    et:credits 1.5 ;
    et:gradeScale "U G VG" .

mod:D7047E-0006 a et:Assessment ;
    rdfs:label "Group/Project work"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0006" ;
    et:credits 2.0 ;
    et:gradeScale "U G VG" .


# --- D7066E Programming for Scientific Computing ---

c:D7066E a et:Course ;
    schema:courseCode "D7066E" ;
    schema:name "Programming for Scientific Computing"@en, "Programmering för tekniskt vetenskapliga beräkningar"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:computer-engineering ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and 30 credits in completed courses in Mathematics including linear algebra and analysis in one and more variables, corresponding to following courses: M0047M Differential Calculus, 7.5 credits, M0048M Linear algebra and calculus, 7.5 credits, M0049M Linear algebra and Differential Equations, 7.5 credits and M0055M Multivariable Calculus, 7.5 credits. Programming in Python or another programming language and basic statistics, e.g. D0009E Introduction to programming, 7.5 credits, S0008M Probability Theory and Statistics eller motsvarande 7.5 credits or equivalent. Good knowledge of English, equivalent to English 6."@en, "Minst 90hp avklarade kurser samt 30 hp avklarade kurser i matematik innehållande linjär algebra och analys i en och flera variabler, motsvarande kurserna: M0047M Differentialkalkyl, 7.5 hp, M0048M Linjär algebra och integralkalkyl, 7.5 hp, M0049M Linjär algebra och differentialekvationer,7.5 hp och M0055M Flervariabelanalys, 7.5 hp. Programmering i Python eller annat programmeringsspråk samt grundläggande statistik t.ex. D0009E Introduktion till programmering, 7.5 hp, S0008M Sannolikhetslära och statistik 7,5 Hp eller motsvarande. Goda kunskaper i engelska, motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:D0009E, c:M0047M, c:M0048M, c:M0049M, c:M0055M, c:S0008M ;
    et:hasOutcome lo:D7066E-1, lo:D7066E-2, lo:D7066E-3, lo:D7066E-4, lo:D7066E-5, lo:D7066E-6, lo:D7066E-7, lo:D7066E-8 ;
    et:hasAssessment mod:D7066E-0001, mod:D7066E-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=D7066E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D7066E&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=D7066E&lasPeriod=226> .

lo:D7066E-1 a et:LearningOutcome ;
    rdfs:label "Understand advanced software engineering concepts, including object-oriented and data-oriented software design, modeling class diagrams and relations, debugging, code profiling, and code refactoring"@en, "Förstå avancerade mjukvarukoncept, inklusive objektorienterad och dataorienterad mjukvarudesign, modellering av klassdiagram och relationer, felsökning, kodprofilering och kodrefaktorering"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:D7066E-2 a et:LearningOutcome ;
    rdfs:label "Have knowledge about discretisation techniques for solving continuous problems, and iterative methods for solving nonlinear problems"@en, "Ha kunskap om diskretiseringstekniker för att lösa kontinuerliga problem, och iterativa metoder för att lösa olinjära problem"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:D7066E-3 a et:LearningOutcome ;
    rdfs:label "Have knowledge about high-performance computing concepts, and the importance of using efficient methods and tools"@en, "Ha kunskap om högpresterande datorsystem och vikten av att använda effektiva metoder och verktyg"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:D7066E-4 a et:LearningOutcome ;
    rdfs:label "Skills and Abilities Be able to implement selected mathematical theory, physical models and machine learning models using numerical software libraries in a structured and conceivable way"@en, "Kunna implementera utvald matematisk teori, fysiska modeller och maskininlärningsmodeller med hjälp av numeriska mjukvarubibliotek på ett strukturerat och tydligt sätt"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:D7066E-5 a et:LearningOutcome ;
    rdfs:label "Be able to design and implement modular software solutions for scientific computing using object-oriented programming and re-usable libraries"@en, "Kunna designa och implementera modulära mjukvarulösningar för vetenskapliga beräkningar med hjälp av objektorienterad programmering och återanvändbara bibliotek"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:D7066E-6 a et:LearningOutcome ;
    rdfs:label "Be able to select and use efficient library implementations of methods for scientific computing"@en, "Kunna välja ut och använda effektiva implementationer av metoder för vetenskaplig beräkning"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:D7066E-7 a et:LearningOutcome ;
    rdfs:label "Be able to systematically evaluate the efficacy of software solutions for scientific computing, including execution speed, computing requirements, and accuracy"@en, "Kunna systematiskt utvärdera effektiviteten av mjukvarulösningar för vetenskaplig beräkning, inklusive exekveringstid, beräkningskrav och noggrannhet"@sv ;
    et:outcomeCategory et:judgementAndApproach .

lo:D7066E-8 a et:LearningOutcome ;
    rdfs:label "Be able to describe ethical and sustainability aspects of computing"@en, "Kunna beskriva etiska och hållbarhetsaspekter av datoranvändning"@sv ;
    et:outcomeCategory et:judgementAndApproach .

mod:D7066E-0001 a et:Assessment ;
    rdfs:label "Oral exam and self-assessment"@en ;
    et:assessmentType et:oralExam ;
    et:moduleCode "0001" ;
    et:credits 4.0 ;
    et:gradeScale "G U 3 4 5" .

mod:D7066E-0003 a et:Assessment ;
    rdfs:label "Exercises"@en ;
    et:assessmentType et:otherAssessment ;
    et:moduleCode "0003" ;
    et:credits 3.5 ;
    et:gradeScale "U G" .


# --- E0003E Circuit Theory ---

c:E0003E a et:Course ;
    schema:courseCode "E0003E" ;
    schema:name "Circuit Theory"@en, "Elkretsteori"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:electrical-engineering ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and knowledge in Mathematics; linear algebra, ordinary linear differential equations, complex numbers (M0049M Linear Algebra and Differential Equations)."@en, "Grundläggande behörighet samt kunskaper i matematik; linjär algebra, ordinära linjära differentialekvationer, komplexa tal (motsvarar M0049M Linjär algebra och differentialekvationer)."@sv ;
    et:entryRequirementNames c:M0049M ;
    et:hasOutcome lo:E0003E-1, lo:E0003E-2, lo:E0003E-3 ;
    et:hasAssessment mod:E0003E-0002, mod:E0003E-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=E0003E> ;
    et:syllabusDecisionDate "2023-02-15"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E0003E&lasPeriod=225&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E0003E&lasPeriod=225> .

lo:E0003E-1 a et:LearningOutcome ;
    rdfs:label "After the course, the student will be able to analyse analog linear circuits. This includes the basic knowledge of components and their constitutive relations, as well as different methods for the analysis of DC and AC circuits. After the course the student should possess knowledge of constitutive relations for basic electrical components and, based on that knowledge, be able to apply knowledge of mathematics to analytically solve electric circuit problems.."@en, "Studenten skall efter avslutad kurs kunna analysera analoga linjära elektriska kretsar. I detta ingår grundläggande komponentkännedom och dess konstitutiva samband samt olika analysmetoder för lik- och växelspänningsmatade kretsar. Studenten ska efter avslutad kurs inneha kunskap om konstitutiva samband för grundläggande elektriska komponenter och utifrån den kunskapen tillämpa kunskaper inom matematik för att analytiskt lösa frågeställningar rörande elektriska kretsar."@sv .

lo:E0003E-2 a et:LearningOutcome ;
    rdfs:label "The student should independently be able to analyse and evaluate analog linear circuits. This is demonstrated by laboratory experiments, simulation exercises, and through homework assignments and a written exam."@en, "Studenten ska självständigt kunna analysera och utvärdera analoga linjära elektriska kretsar. Detta visas genom laboration- och simuleringsövningar, samt genom räkneuppgifter och tentamen."@sv .

lo:E0003E-3 a et:LearningOutcome ;
    rdfs:label "The student should independently be able to analyse and minimise transmission losses, in particular in linear AC circuits with inductive loads, and to be able to describe the link to environmentally sound electrical power distribution and sustainable development."@en, "Studenten ska självständigt kunna analysera och minimera överföringsförluster, speciellt i växelspänningsmatade kretsar med laster av induktiv karaktär, samt kunna beskriva sambandet till miljövänlig elkraftdistribution och hållbar utveckling."@sv .

mod:E0003E-0002 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0002" ;
    et:credits 3.0 ;
    et:gradeScale "U G#" .

mod:E0003E-0003 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0003" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .


# --- E0007E Electronics ---

c:E0007E a et:Course ;
    schema:courseCode "E0007E" ;
    schema:name "Electronics"@en, "Elektronik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:electrical-engineering ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and Basic circuit theory; analysis of linear circuits in frequency and time domains, deal operational amplifiers, simulations using PSpice (E0003E Circuit Theory or E0012E General Introduction to Electrical Engineering or E0013E Fundamentals of Electrical Engineering). Knowledge in English, equivalent to English 6."@en, "Grundläggande behörighet samt grundläggande elkretsteori; analys av linjära kretsar i frekvens samt tidsdomänIdeala operationsförstärkarkretsar, simulering med Pspice (E0003E Elkretsteori alternativt E0012E Introduktion till elektroteknik eller E0013E Grundkurs i elektroteknik). Kunskaper i engelska, motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:E0003E, c:E0012E, c:E0013E ;
    et:hasOutcome lo:E0007E-1, lo:E0007E-2, lo:E0007E-3, lo:E0007E-4, lo:E0007E-5, lo:E0007E-6, lo:E0007E-7, lo:E0007E-8, lo:E0007E-9 ;
    et:hasAssessment mod:E0007E-0005, mod:E0007E-0006 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=E0007E> ;
    et:syllabusDecisionDate "2021-11-04"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E0007E&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E0007E&lasPeriod=226> .

lo:E0007E-1 a et:LearningOutcome ;
    rdfs:label "To be able to design basic electronic circuits based on operational amplifiers, transistors, diodes, and passive components. Be able to measure on and describe the properties of these circuits. Be able to plan and conduct practical laboratory work on electronics. Learn to handle measurement equipment. The student will after the course: Have some knowledge about the developments in electronics that has occurred over the past 50 years, and thus the scientific foundation upon which the field rests."@en .

lo:E0007E-2 a et:LearningOutcome ;
    rdfs:label "The student will also, through knowledge from exercises and tasks for design and calculation: based on proven experience in the field be able to construct simple electronic circuits based on operational; amplifiers, transistors, diodes and passive components"@en .

lo:E0007E-3 a et:LearningOutcome ;
    rdfs:label "based on broad knowledge in the field be able to analyze the electronic circuits with mathematical analysis as well as based on an understanding of the science / physical laws that govern the operation of individual components,"@en .

lo:E0007E-4 a et:LearningOutcome ;
    rdfs:label "through deeper knowledge be able to describe the limitations electronic components such as operational amplifiers have in practical applications."@en .

lo:E0007E-5 a et:LearningOutcome ;
    rdfs:label "independently and with a holistic approach be able to perform experiments, where the task includes theoretical analysis, preparation of the experiments, as well as performing experiments,"@en .

lo:E0007E-6 a et:LearningOutcome ;
    rdfs:label "in practical laboratory exercises create, analyze and evaluate solutions to a problem within certain limits,"@en .

lo:E0007E-7 a et:LearningOutcome ;
    rdfs:label "plan and carry out laboratory tasks within specified parameters, and integrate knowledge of simulation tools with knowledge of circuits and component limitations,"@en .

lo:E0007E-8 a et:LearningOutcome ;
    rdfs:label "simulate and evaluate the behavior of electronic circuits using own knowledge, and using simulation tools for electronic design and have good knowledge of the approximations and assumptions that must often be made in the design of electronic circuits,"@en .

lo:E0007E-9 a et:LearningOutcome ;
    rdfs:label "interact in groups of two or three people in connection with the duties of experimental nature understand the need for additional knowledge in an area, and take responsibility to acquire that knowledge through such means as for example data sheets for components used in design and laboratory work."@en .

mod:E0007E-0005 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0005" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .

mod:E0007E-0006 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0006" ;
    et:credits 3.0 ;
    et:gradeScale "U G" .


# --- E7009E Electronic Design ---

c:E7009E a et:Course ;
    schema:courseCode "E7009E" ;
    schema:name "Electronic Design"@en, "Elektronikkonstruktion"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:electrical-engineering ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses ant the course E7014E Electronics II, 7.5 ECTS or equivalent. Good knowledge in English equivalent to English 6. Alternative: Corresponding knowledge obtained through work in the electronics industry which is supported by a certificate of professional experience."@en, "Minst 90hp avslutade kurser samt kursen E7014E Elektronik II, 7.5 hp, eller motsvarande. Goda kunskaper i engelska, motsvarande Engelska 6. Alternativt: Motsvarande kunskap erhållen genom arbete inom elektronikbranschen som styrks med intyg om yrkeserfarenhet."@sv ;
    et:entryRequirementNames c:E7014E ;
    et:hasOutcome lo:E7009E-1, lo:E7009E-2, lo:E7009E-3, lo:E7009E-4, lo:E7009E-5, lo:E7009E-6, lo:E7009E-7 ;
    et:hasAssessment mod:E7009E-0001, mod:E7009E-0002 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=E7009E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7009E&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7009E&lasPeriod=224> .

lo:E7009E-1 a et:LearningOutcome ;
    rdfs:label "The aim of this course is to teach the student a systematic way of designing, analyzing, building, and verifying advanced electronic circuits. This is done by exposing them to a variety of challenges related to an advanced electronic project. The main learning outcome is to teach the student how to systematically create advanced electronic circuits from a given specification. More specifically, the student is expected to be able to successfully complete the following workflow: independently design and analyse advanced electronic circuits given a specification,"@en, "Syftet med denna kurs är att lära studenten ett systematiskt tillvägagångssätt för design, analys, konstruktion och verifikation av elektroniska kretsar. Detta genomförs genom att belysa en mängd utmaningar som relaterar till ett avancerat elektronikprojekt. Det huvudsakliga läromålet är att lära studenten hur man på ett systematisk sätt skapar avancerade elektroniska kretsar givet en specifikation. Mer specifikt förväntas studenten att kunna genomföra följande arbetsflöde: självständigt designa och analysera avancerade elektroniska kretsar givet en specifikation,"@sv .

lo:E7009E-2 a et:LearningOutcome ;
    rdfs:label "simulate and optimize said circuits while making sure they adhere to the specification,"@en, "simulera och optimera nämnda kretsar, samt verifiera att de möter specifikationen,"@sv .

lo:E7009E-3 a et:LearningOutcome ;
    rdfs:label "realizing the circuits on a bread board and/or printed circuit board,"@en, "realisera kretsar på ett kopplingsdäck och/eller kretskort,"@sv .

lo:E7009E-4 a et:LearningOutcome ;
    rdfs:label "measure the parameters given in the specification and be aware of the measurement accuracy,"@en, "mäta parametrarna som ges i specifikationen samt kunna uppskatta vilken mätnoggranhet som uppnås,"@sv .

lo:E7009E-5 a et:LearningOutcome ;
    rdfs:label "explain discrepancies between simulation results and measurement results from practical circuits as well as their causes, and"@en, "förklara skillnader mellan simuleringsresultat och mätresultat från verkliga kretsar samt deras orsaker och"@sv .

lo:E7009E-6 a et:LearningOutcome ;
    rdfs:label "present a final “product prototype” in front of an audience."@en, "presentera en slutgiltig produktprototyp inför publik."@sv .

lo:E7009E-7 a et:LearningOutcome ;
    rdfs:label "The workflow resembles the process by which a company would design a product from specification to working prototype, and is designed to prepare the students for a job in industry. Relating to the stairs of independence, this course aims to take to students onto the final floor on the stairs—“independent professional actor”."@en, "Arbetsflödet liknar processen genom vilken ett företag skulle designa en produkt utifrån specifikation till fungerande prototyp, och är utformad för att förbereda eleverna inför ett jobb inom industrin. Vad gäller självständighetstrappan, syftar denna kurs till att ta studenterna till sista våningen i trappan—”självständig professionell aktör”."@sv .

mod:E7009E-0001 a et:Assessment ;
    rdfs:label "Project work"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0001" ;
    et:credits 6.0 ;
    et:gradeScale "U G#" .

mod:E7009E-0002 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0002" ;
    et:credits 1.5 ;
    et:gradeScale "U G#" .


# --- E7012E Mechatronics ---

c:E7012E a et:Course ;
    schema:courseCode "E7012E" ;
    schema:name "Mechatronics"@en, "Mekatronik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:automatic-control ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and beeing able to program in a high-level language, analyse simple electronic circuits and furthermore be familiar with basic control theory. This corresponds to the courses D0009E Introduction to programming, 7,5 ECTS, E0013E Basic course in electrical engineering, 7,5 ECTS (alternatively E0003E Circuit Theory, 7,5 ECTS and E0007E Electronics, 7,5 ECTS) and R0004E Modeling and Control, 7,5 ECTS or equvivalent. Good knowledge in English equivalent to English 6. Alternative: Alternative to completed courses can be corresponding knowledge acquired through work with the electronics sector which is proven with a certificate of professional experience."@en, "Minst 90hp avslutade kurser samt kunskap i att programmera i ett högnivåspråk, analysera enkla elektroniska kretsar och dessutom vara bekant med reglertekniska begrepp, ta fram och simulera dynamiska modeller av fysikaliska system, ta fram och analysera återkopplade system i tids- och frekvensplan samt implementera regulatorer. Detta motsvarar kurserna D0009E Introduktion till programmering, 7,5 hp, E0013E Grundkurs i elektroteknik, 7,5 hp, (alternativt E0003E Elkretsteori, 7,5 hp och E0007E Elektronik, 7,5 hp) samt R0004E Modellering och reglering, 7,5 hp eller motsvarande. Goda kunskaper i engelska, motsvarande Engelska 6. Alternativt: Alternativ till godkända kurser kan vara motsvarande kunskap erhållen genom arbete inom elektronikbranschen som styrks med intyg om yrkeserfarenhet."@sv ;
    et:entryRequirementNames c:D0009E, c:E0003E, c:E0007E, c:E0013E, c:R0004E ;
    et:hasOutcome lo:E7012E-1, lo:E7012E-2, lo:E7012E-3, lo:E7012E-4 ;
    et:hasAssessment mod:E7012E-0005, mod:E7012E-0006 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=E7012E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7012E&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7012E&lasPeriod=227> .

lo:E7012E-1 a et:LearningOutcome ;
    rdfs:label "The student will after the course be able to design and program a mechatronic system including mechanics, electronic sensors, simple electronics, a control circuit (microcomputer) and electrical motors. After the course the student should be able to construct and analyze a mechatronic system."@en, "Studenten skall efter avslutad kurs kunna konstruera och programmera ett mekatroniskt system innefattande mekanik, elektroniska givare, enkel anpassningselektronik, en styrkrets (mikrodator) samt elektriska motorer. Efter avslutad kurs ska studenten kunna konstruera och analysera ett mekatroniskt system."@sv .

lo:E7012E-2 a et:LearningOutcome ;
    rdfs:label "The student should be able to critical and creative deal with issues and technology solutions, plan and execute a skilled task, and work in teams with different compositions."@en, "Studenten ska kritiskt och kreativt kunna hantera frågeställningar och tekniska lösningar, planera och genomföra en kvalificerad uppgift, samt samverka i grupp med olika sammansättning."@sv .

lo:E7012E-3 a et:LearningOutcome ;
    rdfs:label "The student should be able to identify the need for further knowledge and to continuously upgrade their skills."@en, "Studenten ska kunna identifiera sitt behov av ytterligare kunskap och att fortlöpande utveckla sin kompetens."@sv .

lo:E7012E-4 a et:LearningOutcome ;
    rdfs:label "The student should be able to integrate knowledge, model, simulate, and anticipate a process. This is shown during the execution of the project that is a part of the examination in the course."@en, "Studenten ska kritiskt och systematiskt integrera kunskap samt visa förmåga att modellera, simulera samt förutsäga och utvärdera skeenden. Detta visas i laborationer och i det projektarbete som är en del av examinationen i kursen."@sv .

mod:E7012E-0005 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0005" ;
    et:credits 1.5 ;
    et:gradeScale "U G" .

mod:E7012E-0006 a et:Assessment ;
    rdfs:label "Project work"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0006" ;
    et:credits 6.0 ;
    et:gradeScale "U G" .


# --- E7015E Integrated Circuits ---

c:E7015E a et:Course ;
    schema:courseCode "E7015E" ;
    schema:name "Integrated Circuits"@en, "Integrerade kretsar"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:electrical-engineering ;
    schema:coursePrerequisites "Courses of at least 90 credits at first cycle including the following knowledge/course: E7014E Electronics II or similar, which means spoken and written technical English. Be able to work with circuit simulation tools. Good knowledge of the MOS transistor in its various modes of operation. Be able to understand and design basic electronic circuit blocks such as differential amplifier and current mirror. Be able to understand and do calculations on feedback systems, frequency dependence, and stability appliedto basic electronic circuit blocks. Alternative: Alternative to completed course can be corresponding knowledge acquired through work within the electronics sector."@en, "Kurser om minst 90 hp på grundnivå varav följande kunskaper/kurs ingår: E7014E Elektronik II eller motsvarande, vilket innebär att studenten ska kunna tillgodogöra sig teknisk engelska i tal och skrift. Kunna arbeta i något verktyg för kretssimulering. God förståelse för funktionen hos en MOS transistor i dess olika arbetsområden. Förstå och kunna designa grundläggande elektroniska byggblock såsom differentialförstärkarsteg och strömspeglar. Förståelse för, samt kunskap för att räkna på, återkopplade system, frekvensberoende, och stabilitet map grundläggande elektroniska byggblock. Alternativt: Alternativ till godkänd kurs kan vara motsvarande kunskap erhållen genom arbete inom elektronikbranschen."@sv ;
    et:entryRequirementNames c:E7014E ;
    et:hasOutcome lo:E7015E-1 ;
    et:hasAssessment mod:E7015E-0001, mod:E7015E-0002, mod:E7015E-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=E7015E> ;
    et:syllabusDecisionDate "2023-02-15"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7015E&lasPeriod=225&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7015E&lasPeriod=225> .

lo:E7015E-1 a et:LearningOutcome ;
    rdfs:label "To be able to design analog electronic integrated circuits in a CMOS process, both regarding schematics and layout. Be able to work with simulation and layout tools for analog integrated circuits. Be able to connect and co-simulate analog and digital integrated circuits (mixed-mode), Be able to describe basic steps in CMOS fabrication, and be able to understand and use process documentation and design rules. The student shall be able to describe the environmental effects of a CMOS process, and its role in a sustainable development of the technology."@en, "Studenten skall efter genomförd kurs kunna konstruera analoga elektroniska integrerade kretsar i en CMOS process, map både schema och layout. Kunna arbeta med simulerings- och layoutverktyg för analoga integrerade kretsar. Kunna koppla samman samt samsimulera analoga och digitala integrerade kretsar (mixed-mode). Kunna beskriva grundläggande steg i en CMOS tillverkningsprocess, samt kunna tillgodogöra sig innehållet i processdokumentation och tillverkarens design regler. Studenten skall kunna beskriva miljöpåverkan av processen för CMOS tillverkning och dess roll i hållbar utveckling av tekniken."@sv .

mod:E7015E-0001 a et:Assessment ;
    rdfs:label "Mid-term exam"@en ;
    et:assessmentType et:otherAssessment ;
    et:moduleCode "0001" ;
    et:credits 3.0 ;
    et:gradeScale "G U 3 4 5" .

mod:E7015E-0002 a et:Assessment ;
    rdfs:label "Project"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0002" ;
    et:credits 3.0 ;
    et:gradeScale "G U 3 4 5" .

mod:E7015E-0003 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0003" ;
    et:credits 1.5 ;
    et:gradeScale "U G#" .


# --- E7019T Master Thesis Engineering Physics and Electrical Engineering - Computational Methods and Physics ---

c:E7019T a et:Course ;
    schema:courseCode "E7019T" ;
    schema:name "Master Thesis Engineering Physics and Electrical Engineering - Computational Methods and Physics"@en, "Examensarbete Teknisk fysik och elektroteknik, inriktning Beräkningsteknik och Fysik, civilingenjör"@sv ;
    et:credits 30.0 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "At least 240 credits completed courses as required for the degree. A maximum of two 7.5 credits courses (or one 15 credits course) may be unfinished from base and core courses. Of the completed courses at least 30 credits shall be of advanced level. In addition to the above, the examiner decides whether the proposed degree project is within the subject area and student has the depth of knowledge required."@en, "Minst 240 hp avklarade kurser av examensfordringarna. Av bas- och kärnkurserna får högst två 7,5 hp kurser (alt. en 15 hp kurs) vara oavklarade. Av avklarade kurser ska minst 30 hp vara på avancerad nivå. Utöver ovanstående avgör examinator om det föreslagna examensarbetet ligger inom ämnesområdet och om studenten har den fördjupning som krävs."@sv ;
    et:hasOutcome lo:E7019T-1, lo:E7019T-2, lo:E7019T-3, lo:E7019T-4, lo:E7019T-5, lo:E7019T-6, lo:E7019T-7, lo:E7019T-8, lo:E7019T-9, lo:E7019T-10, lo:E7019T-11, lo:E7019T-12, lo:E7019T-13 ;
    et:hasAssessment mod:E7019T-0005, mod:E7019T-0006, mod:E7019T-0007, mod:E7019T-0008 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=E7019T> ;
    et:syllabusDecisionDate "2021-02-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7019T&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7019T&lasPeriod=226> .

lo:E7019T-1 a et:LearningOutcome ;
    rdfs:label "Apply theory and methods to solve unstructured problems relevant to a profession as Master Programme in Engineering Physics and Electrical Engineering within the field Engineering Physics. This means that on completion of the course the student is able to: – Formulate a relevant problem for investigation from a chosen subject within the subject area xxxxx."@en .

lo:E7019T-2 a et:LearningOutcome ;
    rdfs:label "– Apply knowledge and proficiency that has been acquired during the period of study to a complex development"@en .

lo:E7019T-3 a et:LearningOutcome ;
    rdfs:label "Project or a smaller research project in an independent and systematic manner."@en .

lo:E7019T-4 a et:LearningOutcome ;
    rdfs:label "– Choose and justify the study method for an investigation."@en .

lo:E7019T-5 a et:LearningOutcome ;
    rdfs:label "– Analyse and defend the problem formulated in a correct manner with respect to science and engineering, without"@en .

lo:E7019T-6 a et:LearningOutcome ;
    rdfs:label "Complete information."@en .

lo:E7019T-7 a et:LearningOutcome ;
    rdfs:label "– Locate and critically review information and summarise this in a scientific manner."@en .

lo:E7019T-8 a et:LearningOutcome ;
    rdfs:label "– Plan, structure and execute a project within research, development or investigation."@en .

lo:E7019T-9 a et:LearningOutcome ;
    rdfs:label "– Judge the scientific and practical relevance of the results obtained."@en .

lo:E7019T-10 a et:LearningOutcome ;
    rdfs:label "– Work to a timetable."@en .

lo:E7019T-11 a et:LearningOutcome ;
    rdfs:label "– Express themselves well in writing in a verbally and scientifically correct manner."@en .

lo:E7019T-12 a et:LearningOutcome ;
    rdfs:label "– Create and execute a presentation of the results of the project, defending the conclusions."@en .

lo:E7019T-13 a et:LearningOutcome ;
    rdfs:label "– Critically review the work of others in a constructive and scientific manner."@en .

