    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M0067M&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=M0067M&lasPeriod=226> .

lo:M0067M-1 a et:LearningOutcome ;
    rdfs:label "describe and explain fundamental principles of linear algebra."@en, "beskriva och förklara grundläggande principer inom linjär algebran."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:M0067M-2 a et:LearningOutcome ;
    rdfs:label "solve linear systems of equations."@en, "lösa ekvationssystem."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0067M-3 a et:LearningOutcome ;
    rdfs:label "work with matrices and determinants."@en, "hantera matriser och determinanter."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0067M-4 a et:LearningOutcome ;
    rdfs:label "describe linear transformations using matrices."@en, "beskriva linjära avbildningar med matriser."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0067M-5 a et:LearningOutcome ;
    rdfs:label "set up equations for lines and planes in space and determine distances, via orthogonal projection, between points, lines, and planes."@en, "ställa upp ekvationer för linjer och plan i rummet och bestämma avstånd, via ortogonal projektion, mellan punkter, linjer och plan."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0067M-6 a et:LearningOutcome ;
    rdfs:label "deal with the concepts of basis and dimension and determine bases in a few typical cases."@en, "hantera begreppen bas och dimension. Bestämma baser i några typiska fall."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0067M-7 a et:LearningOutcome ;
    rdfs:label "perform the Gram-Schmidt orthogonalization process."@en, "utföra Gram-Schmidts ortogonaliseringsprocess."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0067M-8 a et:LearningOutcome ;
    rdfs:label "use the least squares method to fit a model to data points."@en, "använda minstakvadratmetoden för att anpassa en modell till datapunkter."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:M0067M-9 a et:LearningOutcome ;
    rdfs:label "select an appropriate method of solution for given problems within the scope of the course."@en, "välja rimlig lösningsmetod för givna problem inom ramen för kursen."@sv ;
    et:outcomeCategory et:judgementAndApproach .

