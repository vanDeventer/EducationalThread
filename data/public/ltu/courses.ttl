# --- F7016T Advanced Fluid Mechanics ---

c:F7016T a et:Course ;
    schema:courseCode "F7016T" ;
    schema:name "Advanced Fluid Mechanics"@en, "Strömningsmekanik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:fluid-mechanics ;
    schema:coursePrerequisites "Basic courses in mathematics such as M0047M Differential Calculus, M0048M Linear Algebra and Integral Calculus, M0049M Linear Algebra and Differential Equations , or equivalent. Basic courses in physics such as F0004T Physics 1, F0006T Physics 3, or equivalent. Proficiency in English equivalent to Swedish upper secondary course English 6/level 2."@en, "M0047M Differentialkalkyl, M0048M Linjär algebra och integralkalkyl, M0049M Linjär algebra och differentialekvationer, F0004T Fysik 1, F0006T Fysik 3, eller motsvarande. Rekommendation F0031T Hydromekanik eller F0030T Kontinuumsmekanik. Goda kunskaper i engelska motsvarande Engelska 6/nivå 2."@sv ;
    et:entryRequirementNames c:F0004T, c:F0006T, c:M0047M, c:M0048M, c:M0049M ;
    et:hasOutcome lo:F7016T-1, lo:F7016T-2, lo:F7016T-3, lo:F7016T-4, lo:F7016T-5, lo:F7016T-6, lo:F7016T-7, lo:F7016T-8 ;
    et:hasAssessment mod:F7016T-0004, mod:F7016T-0005 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F7016T> ;
    et:syllabusDecisionDate "2022-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7016T&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7016T&lasPeriod=224> .

lo:F7016T-1 a et:LearningOutcome ;
    rdfs:label "Describe what happens in a flow process during laminar and turbulent flows"@en, "Beskriva vad som händer i ett strömningsförlopp vid laminär och turbulent strömning."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7016T-2 a et:LearningOutcome ;
    rdfs:label "Use tensor notation to set up problems in fluid mechanics"@en, "Använda tensornotation för att sätta upp problem inom strömningsmekaniken"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7016T-3 a et:LearningOutcome ;
    rdfs:label "Make appropriate approximations for a given problem in fluid mechanics"@en, "Göra lämpliga approximationer för ett givet problem inom strömningsmekaniken"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7016T-4 a et:LearningOutcome ;
    rdfs:label "Apply appropriate mathematical methods to given problems in fluid mechanics"@en, "Tillämpa lämpliga matematiska metoder på givna problem inom strömningsmekanike"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7016T-5 a et:LearningOutcome ;
    rdfs:label "Make estimates of interesting variables in a flow process."@en, "Göra uppskattningar av intressanta variabler i ett strömningsförlopp."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7016T-6 a et:LearningOutcome ;
    rdfs:label "Valuation and approach Verify and critizise results from commercial flow simulation programs."@en, "Värdering och förhållningssätt Verifiera och kritisera resultat från kommersiella simuleringsprogram för beräkning av strömningsförlopp."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7016T-7 a et:LearningOutcome ;
    rdfs:label "Determine when advanced simulations or experiments need to be performed."@en, "Avgöra när avancerade simuleringar eller experiment behöver genomföras."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7016T-8 a et:LearningOutcome ;
    rdfs:label "The course will develop basic knowledge in fluid mechanics with the gouverning equations formulated in differential equation form. You will apply mathematical methods covered in the basic courses and experience some applied flow problems. This will enable you to familiarize with various problems within fluid mechanics, in the future, important for industry and society. You also get an insight into scientific issues in fluid mechanics and learn a couple of advanced tools that are used to study flow processes."@en, "Kursen ska utveckla baskunskaper i strömningsmekanik med grundsambanden formulerade på differentialekvationsform. Du får därvid tillämpning på de matematiska metoder som behandlas i grundkurserna, och erfarenhet av några tillämpade strömningsförlopp som leder till att du kan sätta dig in i olika strömningstekniska problem i framtiden viktiga för industri och samhälle. Du får också en inblick i vetenskapliga frågeställningar inom strömningsmekaniken och får tillämpa ett par avancerade verktyg som används för att studera strömningsförlopp."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

mod:F7016T-0004 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0004" ;
    et:credits 0.5 ;
    et:gradeScale "U G#" .

mod:F7016T-0005 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0005" ;
    et:credits 7.0 ;
    et:gradeScale "G U 3 4 5" .


# --- F7018T Computational fluid dynamics ---

c:F7018T a et:Course ;
    schema:courseCode "F7018T" ;
    schema:name "Computational fluid dynamics"@en, "Strömningsmekanikens beräkningsmetoder"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:fluid-mechanics ;
    schema:coursePrerequisites "M0047M Calculus, M0048M Linear algebra and integrals, M0049M Linear algebra and differential equations, F0004T Physics1, F0006T Physics 3, or equivalent courses. F7016T Advanced Ffuid mechanics. Vector analysis as in M0032M Functions of several variables and computer tools. Good knowledge in English, equivalent to English 6/level 2."@en, "M0047M Differentialkalkyl, M0048M Linjär algebra och integralkalkyl, M0049M Linjär algebra och differentialekvationer, F0004T Fysik 1, F0006T Fysik 3, eller motsvarande. Strömningsmekanik F7016T. Vektor analys som i M0032M Funktioner av flera variabler och datorverktyg. Goda kunskaper i engelska motsvarande Engelska 6/nivå 2."@sv ;
    et:entryRequirementNames c:F0004T, c:F0006T, c:F7016T, c:M0032M, c:M0047M, c:M0048M, c:M0049M ;
    et:hasOutcome lo:F7018T-1, lo:F7018T-2, lo:F7018T-3, lo:F7018T-4, lo:F7018T-5, lo:F7018T-6, lo:F7018T-7, lo:F7018T-8, lo:F7018T-9, lo:F7018T-10 ;
    et:hasAssessment mod:F7018T-0003, mod:F7018T-0004 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F7018T> ;
    et:syllabusDecisionDate "2022-08-22"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7018T&lasPeriod=225&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F7018T&lasPeriod=225> .

lo:F7018T-1 a et:LearningOutcome ;
    rdfs:label "After the course the student should know"@en .

lo:F7018T-2 a et:LearningOutcome ;
    rdfs:label "Have knowledge of approximate methods, analytical and numerical methods developed for fluid mechanics."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7018T-3 a et:LearningOutcome ;
    rdfs:label "Have understanding of these methods with their prons and cons"@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7018T-4 a et:LearningOutcome ;
    rdfs:label "Have knowledge of turbulence modeling and the simplest turbulence models and their prons and cons."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7018T-5 a et:LearningOutcome ;
    rdfs:label "Have knowledge about some commercial CFD software programs."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F7018T-6 a et:LearningOutcome ;
    rdfs:label "To formulate a fluid mechanical problem in terms of partial differential equations and boundary conditions in a form suitable for a numerical method."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7018T-7 a et:LearningOutcome ;
    rdfs:label "To formulate the fluid flow problem numerically in terms of a finite difference method and a finite volume method."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7018T-8 a et:LearningOutcome ;
    rdfs:label "To be able to solve a fluid mechanical problem with the use of a commercial CFD software."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7018T-9 a et:LearningOutcome ;
    rdfs:label "Evaluation and approach Verify and criticize results from a numerical solution and solution using a commercial CFD software."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F7018T-10 a et:LearningOutcome ;
    rdfs:label "Decide when more advanced simulations and experiments need to be considered."@en ;
    et:outcomeCategory et:skillsAndAbilities .

mod:F7018T-0003 a et:Assessment ;
    rdfs:label "Assignment"@en ;
    et:assessmentType et:assignment ;
    et:moduleCode "0003" ;
    et:credits 5.0 ;
    et:gradeScale "G U 3 4 5" .

mod:F7018T-0004 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0004" ;
    et:credits 2.5 ;
    et:gradeScale "G U 3 4 5" .


# --- F7024T Multiphysics, simulation and computation ---

c:F7024T a et:Course ;
    schema:courseCode "F7024T" ;
    schema:name "Multiphysics, simulation and computation"@en, "Multifysik, simulering och beräkning"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
