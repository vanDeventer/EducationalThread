    et:syllabusDecisionDate "2020-02-21"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S7014E&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=S7014E&lasPeriod=224> .

lo:S7014E-1 a et:LearningOutcome ;
    rdfs:label "Within the frame of the course the student will develop his/her ability to model and solve an arbitrary engineering problem. With the previously read courses as a basis the student will pursue a deeper understanding of fundamental knowledge as well as a better overview of a specific field. The broadening and deepening follows within the framework of the specialization. The course will also further develop the participants' presentation skills and ability to work in groups."@en, "I kursen utvecklar studenten sin förmåga att modellera och lösa ett ostrukturerat problem. Med de tidigare lästa kurserna som grund eftersträvas dels en fördjupning av kunskaper och förståelse gällande grundläggande principer, dels en breddning i form av en samlad överblick över inriktningen. Kursen ska dessutom utveckla studentens färdigheter vad avser presentationsteknik och förmåga att samarbeta i grupp."@sv .

mod:S7014E-0001 a et:Assessment ;
    rdfs:label "Project"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0001" ;
    et:credits 15.0 ;
    et:gradeScale "U G#" ;
    et:assesses lo:S7014E-1 .


# --- X7010E Master Thesis Engineering Physics and Electrical Engineering - Electronic Systems and Control Engineering ---

c:X7010E a et:Course ;
    schema:courseCode "X7010E" ;
    schema:name "Master Thesis Engineering Physics and Electrical Engineering - Electronic Systems and Control Engineering"@en, "Examensarbete teknisk fysik och elektroteknik, inriktning elektroniksystem och reglerteknik, civilingenjör"@sv ;
    et:credits 30.0 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:electrical-engineering ;
    schema:coursePrerequisites "At least 240 credits completed courses as required for the degree. A maximum of two 7.5 credits courses (or one 15 credits course) may be unfinished from base and core courses. Of the completed courses at least 30 credits shall be of advanced level. In addition to the above, the examiner decides whether the proposed degree project is within the subject area and student has the depth of knowledge required."@en, "Minst 240 hp avklarade kurser av examensfordringarna. Av bas- och kärnkurserna får högst två 7,5 hp kurser (alt. en 15 hp kurs) vara oavklarade. Av avklarade kurser ska minst 30 hp vara på avancerad nivå. Utöver ovanstående avgör examinator om det föreslagna examensarbetet ligger inom ämnesområdet och om studenten har den fördjupning som krävs."@sv ;
    et:hasOutcome lo:X7010E-1, lo:X7010E-2, lo:X7010E-3, lo:X7010E-4, lo:X7010E-5, lo:X7010E-6, lo:X7010E-7, lo:X7010E-8, lo:X7010E-9 ;
    et:hasAssessment mod:X7010E-0005, mod:X7010E-0006, mod:X7010E-0007, mod:X7010E-0008 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=X7010E> ;
    et:syllabusDecisionDate "2021-02-16"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=X7010E&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=X7010E&lasPeriod=226> .

lo:X7010E-1 a et:LearningOutcome ;
    rdfs:label "The overall goal of the course is that the student practices, develops and is able to apply theory and methods to solve unstructured problems relevant to a profession as Master of Science in Engineering Physics and Electrical Engineering, Electronic Systems and Control Engineering. This means that on completion of the course the student is able to: Formulate a relevant problem for investigation from a chosen subject within the subject area Electronic; Systems and Control Engineering."@en, "Formulera en relevant problemställning utifrån ett valt ämne inom ämnesområdet Elektroniksystem och reglerteknik."@sv .

lo:X7010E-2 a et:LearningOutcome ;
    rdfs:label "Apply knowledge and proficiency that has been acquired during the period of study to a complex development project or a smaller research project in an independent and systematic manner."@en, "Tillämpa kunskaper och färdigheter som har förvärvats under studietiden i ett komplext utrednings-, utvecklings- eller mindre forskningsprojekt på ett självständigt och systematiskt sätt."@sv .

lo:X7010E-3 a et:LearningOutcome ;
    rdfs:label "Choose and justify the study method for an investigation.Analyse and defend the problem formulated in a correct manner with respect to science and engineering, without complete information."@en, "Välja och motivera metod för studien. Utan fullständig information på ett ingenjörsmässigt och vetenskapligt sätt analysera och besvara formulerad problemställning."@sv .

lo:X7010E-4 a et:LearningOutcome ;
    rdfs:label "Locate and critically review information and summarise this in a scientific manner."@en, "Finna och kritiskt värdera information och sammanfatta denna på ett vetenskapligt sätt."@sv .

lo:X7010E-5 a et:LearningOutcome ;
    rdfs:label "Plan, structure and execute a project within research, development or investigation."@en, "Planera, strukturera och genomföra ett forsknings-, utvecklings- eller utredningsarbete."@sv .

lo:X7010E-6 a et:LearningOutcome ;
    rdfs:label "Judge the scientific and practical relevance of the results obtained.Work according to a timetable."@en, "Bedöma den vetenskapliga och praktiska relevansen av erhållna resultat. Arbeta efter tidplan."@sv .

lo:X7010E-7 a et:LearningOutcome ;
    rdfs:label "Syllabus Master Thesis Engineering Physics and Electrical Engineering - Electronic Systems and Control Engineering 30 cr Spring 2027, Sp 3 2021-02- 16 2 (5) Express oneself well in writing in a verbally and scientifically correct manner."@en, "Uttrycka sig väl i skrift på ett språkligt och vetenskapligt korrekt sätt."@sv .

lo:X7010E-8 a et:LearningOutcome ;
    rdfs:label "Create and execute a presentation of the results of the project, defending the conclusions."@en, "Utforma och genomföra en presentation där arbetets resultat och slutsatser redovisas och försvaras."@sv .

lo:X7010E-9 a et:LearningOutcome ;
    rdfs:label "Critically review the work of others in a constructive and scientific manner."@en, "Kritiskt granska andra studier på ett konstruktivt och vetenskapligt sätt."@sv .

mod:X7010E-0005 a et:Assessment ;
    rdfs:label "Accepted report"@en ;
    et:assessmentType et:report ;
    et:moduleCode "0005" ;
    et:credits 30.0 ;
    et:gradeScale "U G" .

mod:X7010E-0006 a et:Assessment ;
    rdfs:label "Oral presentation"@en ;
    et:assessmentType et:oralExam ;
    et:moduleCode "0006" ;
    et:credits 0.0 ;
    et:gradeScale "U G" .

mod:X7010E-0007 a et:Assessment ;
    rdfs:label "Public discussion of others degree project"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0007" ;
    et:credits 0.0 ;
    et:gradeScale "U G" .

mod:X7010E-0008 a et:Assessment ;
    rdfs:label "Start of degree project"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0008" ;
    et:credits 0.0 ;
    et:gradeScale "U G" .


