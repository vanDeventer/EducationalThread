    et:gradeScale "U G" .


# --- E7030E Electronic systems ---

c:E7030E a et:Course ;
    schema:courseCode "E7030E" ;
    schema:name "Electronic systems"@en, "Elektroniksystem"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:electrical-engineering ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and knowledge of amplifier models, operational amplifiers, diodes, MOS and BJT amplifier circuits including small-signal models equivalent to the course E0007E Electronics 7,5 ECTS. Good knowledge in English equivalent to English 6/level 2"@en, "Minst 90hp avslutade kurser samt kunskap om förstärkarmodeller, operationsförstärkare, dioder, MOS och BJT transistorer inkluderande småsignalmodeller motsvarande kursen E0007E Elektronik 7.5 hp. Goda kunskaper i engelska, motsvarande Engelska 6/nivå 2"@sv ;
    et:entryRequirementNames c:E0007E ;
    et:hasOutcome lo:E7030E-1 ;
    et:hasAssessment mod:E7030E-0001, mod:E7030E-0002 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=E7030E> ;
    et:syllabusDecisionDate "2026-02-13"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7030E&lasPeriod=225&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7030E&lasPeriod=225> .

lo:E7030E-1 a et:LearningOutcome ;
    rdfs:label "The student shall after the course have knowledge of a number of common circuits and their theoretical fundamenta, including feedback systems, oscillators and filters. The student shall be able to describe the function of a number of electronic components such as AD converters, DA converters and regulators . The student shall be able to design, build, verify and document discrete circuits for electronic systems useful in areas such as metrology and communications."@en, "Studenten skall efter genomgången kurs ha kunskap om ett antal vanliga kretslösningar och dess teoretiska fundamenta, innefattande återkopplade system, oscillatorer samt filter. Studenten skall vidare kunna beskriva funktionen hos elektroniska komponenter såsom AD omvandlare, DA omvandlare och regulatorer. Studenten skall kunna konstruera, bygga, mäta upp och beskriva diskreta kretsar för elektroniska system användbara inom exempelvis mätteknik och kommunikation."@sv .

mod:E7030E-0001 a et:Assessment ;
    rdfs:label "Written Exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0001" ;
    et:credits 4.5 ;
    et:gradeScale "G U 3 4 5" .

mod:E7030E-0002 a et:Assessment ;
    rdfs:label "Laboratory Work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0002" ;
    et:credits 3.0 ;
    et:gradeScale "U G#" .


# --- E7031E EMC technology ---

c:E7031E a et:Course ;
    schema:courseCode "E7031E" ;
    schema:name "EMC technology"@en, "EMC-teknologi"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:electrical-engineering ;
    schema:coursePrerequisites "At least 90 ECTS of completed courses and Basic circuit theory: E0003E Circuit Theory, 7,5 ECTS. Analysis of linear circuits in the time- and frequency- domain. Inductance and capacitance. Analysis of first- and second- order circuits. Laplace transform. Simulations using PSpice: E0007E, Electronics, 7,5 ECTS. Mathematical analysis and multi-variable analysis, F0007T Electromagnetic field theory, 7,5 ECTS. Knowledge in English equivalent to English 6."@en, "Minst 90hp avslutade kurser samt E0003E Grundläggande elkretsteori, 7,5 hp. Analys av linjära kretsar i frekvens samt tidsdomän. Induktans (själv och ömsesidig) och kapacitans. Analys av första- och andra- ordningens kretsar. Laplace transform. Simulering med PSpice, E0007E Elektronik, 7,5 hp. Matematisk analys och flervariabelanalys, F0007T Elektromagnetisk fältteori, 7,5 hp. Kunskaper i engelska motsvarande Engelska 6."@sv ;
    et:entryRequirementNames c:E0003E, c:E0007E, c:F0007T ;
    et:hasOutcome lo:E7031E-1 ;
    et:hasAssessment mod:E7031E-0001, mod:E7031E-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=E7031E> ;
    et:syllabusDecisionDate "2025-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7031E&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7031E&lasPeriod=226> .

lo:E7031E-1 a et:LearningOutcome ;
    rdfs:label "To be able to plan and execute measurements according to standards describing EMC testing. To be able to calculate and describe transmission lines in the time- and frequency- domain. To be able to describe antenna effects for systems and/or parts of a systems. To be able to plan for preventive measures and execute calculations supporting EMC proper design. To be able to choose and adapt filter components. To be able to describe principles for radiated and conducted emission and immunity. To be able to work with shielding of electromagnetic fields. To be able to work with preventive measures for electrostatic discharge (ESD). Be able to plan, execute and report practical laboratory work."@en, "Studenten skall efter avslutad kurs kunna planera och genomföra mätningar enligt standarder som beskriver EMC testning. Att kunna beräkna och beskriva funktion för transmissionsledningar i tids- och frekvens- domän. Att kunna beskriva antennverkan för delar av system. Att kunna genomföra förebyggande åtgärder och beräkningar för EMC- riktig design. Kunna välja och anpassa avstörningskomponenter. Att kunna beskriva principer för strålad och ledningsbunden emission och immunitet. Kunna arbeta med skärmning av elektromagnetiska fält. Kunna arbeta med skydd mot elektrostatiska urladdningar. Kunna planera, genomföra och rapportera praktiskt laborativt arbete."@sv .

mod:E7031E-0001 a et:Assessment ;
    rdfs:label "Partials"@en ;
    et:assessmentType et:otherAssessment ;
    et:moduleCode "0001" ;
    et:credits 4.0 ;
    et:gradeScale "G U 3 4 5" .

mod:E7031E-0003 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0003" ;
    et:credits 3.5 ;
    et:gradeScale "U G" .


# --- E7032E Project in Engineering Physics and Electrical Engineering - Electronic Systems and Control Engineering ---

c:E7032E a et:Course ;
    schema:courseCode "E7032E" ;
    schema:name "Project in Engineering Physics and Electrical Engineering - Electronic Systems and Control Engineering"@en, "Projekt teknisk fysik och elektroteknik, inriktning elektroniksystem och reglerteknik"@sv ;
    et:credits 15.0 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:secondCycle ;
    et:subject subj:electrical-engineering ;
    schema:coursePrerequisites "At least 210 hp completed of the degree requirements from the Master Programme in Engineering Physics and Electrical Engineering, as well as the following completed specialisation courses: D0013E Microcomputer Engineering 7,5 hp, E7030E Electronic systems 7,5 hp, R7003E Automatic Control 7,5 hp, and R7014E Advanced Control Design 7,5 hp. Good knowledge in English equivalent to English 6."@en, "Minst 210 hp avklarade kurser av examensfordringarna för programmet civilingenjör i Teknisk fysik och elektroteknik, samt följande avklarade inriktningskurser: D0013E Mikrodatorteknik 7,5 hp, E7030E Elektroniksystem 7,5 hp, R7003E Reglerteknik 7,5 hp, och R7014E Avancerade reglersystem 7,5 hp. Goda kunskaper i Engelska 6."@sv ;
    et:entryRequirementNames c:D0013E, c:E7030E, c:R7003E, c:R7014E ;
    et:hasOutcome lo:E7032E-1, lo:E7032E-2, lo:E7032E-3, lo:E7032E-4, lo:E7032E-5, lo:E7032E-6 ;
    et:hasAssessment mod:E7032E-0001 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=E7032E> ;
    et:syllabusDecisionDate "2023-02-15"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7032E&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=E7032E&lasPeriod=224> .

lo:E7032E-1 a et:LearningOutcome ;
    rdfs:label "1. Plan and manage a project and its associated risks 2. Engineer and construct functional industrial systems 3. present results publicly 4. author extensive reports."@en .

lo:E7032E-2 a et:LearningOutcome ;
    rdfs:label "Within this course, the participants must apply the skills they have learned in all previous courses, which might have been at an abstract level, to tangible systems. The students shall further develop skills such as Project breakdown, planning with weekly reassessment and risk analysis"@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:E7032E-3 a et:LearningOutcome ;
    rdfs:label "Team cooperation and communication"@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:E7032E-4 a et:LearningOutcome ;
    rdfs:label "Extensive report writing in English."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:E7032E-5 a et:LearningOutcome ;
    rdfs:label "The course makes use of all previously learned engineering skills and reinforces them in a manner that enhances the participants' individual aspirations and specialization."@en ;
    et:outcomeCategory et:skillsAndAbilities .

lo:E7032E-6 a et:LearningOutcome ;
    rdfs:label "Since it is a new set of projects each year, the students have to conceptualize and engineer solutions to new problems and then implement them while tracking the risks within the whole project."@en ;
    et:outcomeCategory et:judgementAndApproach .

mod:E7032E-0001 a et:Assessment ;
    rdfs:label "Project"@en ;
    et:assessmentType et:projectWork ;
    et:moduleCode "0001" ;
    et:credits 15.0 ;
    et:gradeScale "U G#" ;
    et:assesses lo:E7032E-1, lo:E7032E-2, lo:E7032E-3, lo:E7032E-4, lo:E7032E-5, lo:E7032E-6 .


# --- F0004T Physics 1 ---

c:F0004T a et:Course ;
    schema:courseCode "F0004T" ;
    schema:name "Physics 1"@en, "Fysik 1"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language + Swedish upper secondary school courses Physics 2, Chemistry 1, Mathematics 3c or Mathematics D. Or: Physics level 2, Chemistry level 1, Matematics Further level 1c."@en, "Grundläggande behörighet + Fysik 2, Kemi 1, Matematik 3c eller Matematik D. Eller: Fysik nivå 2, Kemi nivå 1, Matematik fortsättning nivå 1c."@sv ;
    et:hasOutcome lo:F0004T-1, lo:F0004T-2, lo:F0004T-3, lo:F0004T-4, lo:F0004T-5, lo:F0004T-6, lo:F0004T-7 ;
    et:hasAssessment mod:F0004T-0004, mod:F0004T-0007, mod:F0004T-0008 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F0004T> ;
    et:syllabusDecisionDate "2022-02-14"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0004T&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0004T&lasPeriod=226> .

lo:F0004T-1 a et:LearningOutcome ;
    rdfs:label "define fundamental concepts and relationships in mechanics and thermodynamics and explain their relationships."@en .

lo:F0004T-2 a et:LearningOutcome ;
    rdfs:label "make free-body diagrams, analyze and calculate forces and torques of two-dimensional rigid bodies at rest, equilibrium."@en .

lo:F0004T-3 a et:LearningOutcome ;
    rdfs:label "To formulate and solve mechanical problems involving particle motion in two dimensions, i.e. kinematics and kinetics."@en .

lo:F0004T-4 a et:LearningOutcome ;
    rdfs:label "perform calorimetric calculations in solid, liquid and gas phase."@en .

lo:F0004T-5 a et:LearningOutcome ;
    rdfs:label "understand and apply the first and second laws of thermodynamics for calculations with ideal gases in closed systems and idealized processes; calculate the thermal efficiency of simple cycles; knowledge of a few technical applications and relate them to the concept of sustainable development."@en .

lo:F0004T-6 a et:LearningOutcome ;
    rdfs:label "understand the physical principles for heat transfer by conduction, radiation and convection, and solve simple problems."@en .

lo:F0004T-7 a et:LearningOutcome ;
    rdfs:label "plan, implement and evaluate physics experiments and present the results in a written report."@en .

mod:F0004T-0004 a et:Assessment ;
    rdfs:label "Written exam/Alternativ Examination"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0004" ;
    et:credits 6.0 ;
    et:gradeScale "G U 3 4 5" .

mod:F0004T-0007 a et:Assessment ;
    rdfs:label "Laboratory work Experimental methodology"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0007" ;
    et:credits 1.0 ;
    et:gradeScale "U G" .

mod:F0004T-0008 a et:Assessment ;
    rdfs:label "Laboratory work Thermodynamics"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0008" ;
    et:credits 0.5 ;
    et:gradeScale "U G" .


# --- F0005T Physics 2 ---

c:F0005T a et:Course ;
    schema:courseCode "F0005T" ;
    schema:name "Physics 2"@en, "Fysik 2"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and F0004T Physics 1, Calculus M0029M, Linear Algebra and Calculus M0030M or equivalent."@en, "Grundläggande behörighet samt Mekanik, Termodynamik, Experimentell metodik exempelvis Fysik 1 F0004T samt grundläggande matematik exempelvis Differentialkalkyl M0029M och Linjär algebra och integralkalkyl M0030M eller motsvarande."@sv ;
    et:entryRequirementNames c:F0004T, c:M0029M, c:M0030M ;
    et:hasOutcome lo:F0005T-1, lo:F0005T-2, lo:F0005T-3, lo:F0005T-4, lo:F0005T-5, lo:F0005T-6, lo:F0005T-7, lo:F0005T-8, lo:F0005T-9, lo:F0005T-10, lo:F0005T-11, lo:F0005T-12, lo:F0005T-13, lo:F0005T-14, lo:F0005T-15, lo:F0005T-16, lo:F0005T-17, lo:F0005T-18, lo:F0005T-19, lo:F0005T-20, lo:F0005T-21, lo:F0005T-22, lo:F0005T-23, lo:F0005T-24, lo:F0005T-25 ;
    et:hasAssessment mod:F0005T-0004, mod:F0005T-0005 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F0005T> ;
    et:syllabusDecisionDate "2024-02-15"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0005T&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0005T&lasPeriod=226> .

lo:F0005T-1 a et:LearningOutcome ;
    rdfs:label "Give an account of wave properties,"@en, "Redogöra för vågors egenskaper,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-2 a et:LearningOutcome ;
    rdfs:label "Give an account for propagating waves,"@en, "Redogöra för propagerande vågor,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-3 a et:LearningOutcome ;
    rdfs:label "Give an account for standing waves on a string and in pipes,"@en, "Redogöra för stående vågor på en sträng och i pipor,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-4 a et:LearningOutcome ;
    rdfs:label "Give an account for the treatment of waves as vectors in the complex plane,"@en, "Redogöra för behandling av vågor som vektorer i komplexa talplanet,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-5 a et:LearningOutcome ;
    rdfs:label "Give an account for phenomena as beats and the doppler effect,"@en, "Redogöra för fenomen som svävning och dopplereffekt,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-6 a et:LearningOutcome ;
    rdfs:label "Give an account polarization of waves,"@en, "Redogöra för polarisation hos vågor,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-7 a et:LearningOutcome ;
    rdfs:label "Give an account for interference and diffraction,"@en, "Redogöra för interferens och diffraktion,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-8 a et:LearningOutcome ;
    rdfs:label "Give an account for Bohr’s hydrogen model,"@en, "Redogöra för Bohrs vätemodell,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-9 a et:LearningOutcome ;
    rdfs:label "Give an account for the origin of line spectra and continuous spectra,"@en, "Redogöra för uppkomsten av linjespektra samt kontinuerligt spektra,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-10 a et:LearningOutcome ;
    rdfs:label "Give an account for photoelectric effect, the origin of x-ray radiation and to explain the physical principles behind the properties of the x-ray spectra,"@en, "Redogöra för fotoelektrisk effekt samt uppkomsten av röntgenstrålning och förklara de fysikaliska principerna bakom egenskaperna hos ett röntgenspektrum,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-11 a et:LearningOutcome ;
    rdfs:label "Explain the background of the Schrödinger equation,"@en, "Förklara bakgrunden till Schrödingerekvationen,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-12 a et:LearningOutcome ;
    rdfs:label "Give an account for the quantum numbers of the electron and relate those to the electron configurations of the atoms,"@en, "Redogöra för elektronens kvanttal och relatera dessa till atomernas elektronkonfiguration,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-13 a et:LearningOutcome ;
    rdfs:label "Give an account for atom-atom interactions, molecule – molecule interactions and crystal structures and calculate material properties from information on the crystal structure,"@en, "Redogöra för atom-atom interaktioner, molekyl-molekyl interaktioner samt kristallstrukturer och beräkna materialegenskaper utifrån dessa,"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0005T-14 a et:LearningOutcome ;
    rdfs:label "Perform calculations on basic properties of propagating and standing waves,"@en, "Räkna på grundläggande egenskaper hos propagerande och stående vågor,"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-15 a et:LearningOutcome ;
    rdfs:label "Perform calculations on superposition in the complex plane,"@en, "Räkna på superposition i det komplexa talplanet,"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-16 a et:LearningOutcome ;
    rdfs:label "Perform calculations on beats and the doppler effect,"@en, "Räkna på svävning och dopplereffekten,"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-17 a et:LearningOutcome ;
    rdfs:label "Perform calculations on polarization and apply Fresnels equation for reflection of waves,"@en, "Räkna på polarisation och tillämpa Fresnels formler vid reflektion av vågor,"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-18 a et:LearningOutcome ;
    rdfs:label "Perform calculations on interference and diffraction,"@en, "Räkna på interferens och diffraktion,"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-19 a et:LearningOutcome ;
    rdfs:label "Perform calculations on Bohr’s hydrogen model and apply it on similar systems,"@en, "Räkna på Bohrs vätemodell och tillämpa den på liknande system,"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-20 a et:LearningOutcome ;
    rdfs:label "Perform calculations on blackbody radiation and x-ray radiation,"@en, "Räkna på svartkroppsstrålning och röntgenstrålning,"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-21 a et:LearningOutcome ;
    rdfs:label "Perform calculations on crystal structures,"@en, "Räkna på kristallstrukturer"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-22 a et:LearningOutcome ;
    rdfs:label "Apply the Schrödinger equation on basic potentials, solve it and relate the resulting wavefunction to physical quantities,"@en, "Applicera Schrödingerekvationen på enklare potentialer, lösa den och relatera den resulterande vågfunktionen till fysikaliska storheter,"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-23 a et:LearningOutcome ;
    rdfs:label "Plan, perform, analyse, and evaluate experiments from an open problem description,"@en, "Planera, genomföra, analysera och utvärdera experiment utifrån en öppen problembeskrivning,"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-24 a et:LearningOutcome ;
    rdfs:label "Prepare and perform an oral presentation of performed experiments, acquired results, and drawn conclusions,"@en, "Förbereda och genomföra en muntlig presentation av genomförda experiment, erhållna resultat och dragna slutsatser,"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0005T-25 a et:LearningOutcome ;
    rdfs:label "Justify his/her calculations and argue for the reasonableness of the acquired results."@en, "Värdering och förhållningssätt Rättfärdiga sina beräkningar och argumentera för rimligheten i sina svar."@sv ;
    et:outcomeCategory et:judgementAndApproach .

mod:F0005T-0004 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0004" ;
    et:credits 6.0 ;
    et:gradeScale "G U 3 4 5" .

mod:F0005T-0005 a et:Assessment ;
    rdfs:label "Laboratory work/ Oral presentation"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0005" ;
    et:credits 1.5 ;
    et:gradeScale "U G" .


# --- F0006T Physics 3 ---

c:F0006T a et:Course ;
    schema:courseCode "F0006T" ;
    schema:name "Physics 3"@en, "Fysik 3"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and You are expected to have knowledge in statics and simple dynamics as well as differentiation and derivation. This can, for example, be obtained in F0004T Physics 1, 7,5 hp, and M0047M Calculus, 7,5 hp."@en, "Grundläggande behörighet samt kunskaper i mekanik såsom statik och enkel dynamik exempelvis i F0004T, Fysik 1, 7,5 hp samt kunskaper om differentiering och integrering exempelvis i M0047M, Differentialkalkyl, 7,5 hp."@sv ;
    et:entryRequirementNames c:F0004T, c:M0047M ;
    et:hasOutcome lo:F0006T-1, lo:F0006T-2, lo:F0006T-3, lo:F0006T-4, lo:F0006T-5, lo:F0006T-6, lo:F0006T-7, lo:F0006T-8, lo:F0006T-9, lo:F0006T-10, lo:F0006T-11, lo:F0006T-12, lo:F0006T-13 ;
    et:hasAssessment mod:F0006T-0007, mod:F0006T-0008, mod:F0006T-0009, mod:F0006T-0010 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F0006T> ;
    et:syllabusDecisionDate "2025-02-13"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0006T&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0006T&lasPeriod=226> .

lo:F0006T-1 a et:LearningOutcome ;
    rdfs:label "After completing the course, you can"@en, "Efter avklarad kurs kan du"@sv .

lo:F0006T-2 a et:LearningOutcome ;
    rdfs:label "explain and illustrate, for simple, two-dimensional, rotating bodies, the concepts: work, energy, momentum, angular momentum, moment of inertia and center of mass and the corresponding; dynamics"@en, "förklara, exemplifiera och illustrera, för enkla tvådimensionella roterande kroppar, begreppen: arbete, energi, rörelsemängd, rörelsemängdsmoment, masströghetsmoment, masscentrum och dess rörelse"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0006T-3 a et:LearningOutcome ;
    rdfs:label "explain and illustrate the concepts: time dilation, length contraction, relativistic Doppler shift, radioactive radiation and nuclear decay."@en, "förklara, exemplifiera och illustrera begreppen: tidsdilatation, längdkontraktion, relativistisk dopplereffekt samt radioaktiv strålning och kärnsönderfall"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0006T-4 a et:LearningOutcome ;
    rdfs:label "make free-body diagrams and solve 2D dynamical problems for particles and simple rigid bodies in"@en, "frilägga och räkna på tvådimensionella dynamiska förlopp för partiklar och enkla stela kroppar vid enkel rotation, fysisk pendelsvängning, satellitrörelse och icke-konstant acceleration"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0006T-5 a et:LearningOutcome ;
    rdfs:label "simple rotation,1. physical pendulum motion,2. satellite movement,3. and non-constant acceleration4. calculate the position of the center of mass for arbitrary 2D bodies"@en, "beräkna masscentrums läge för godtyckliga tvådimensionella kroppar"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0006T-6 a et:LearningOutcome ;
    rdfs:label "apply the law of conservation of mechanical energy on systems with rotating parts"@en, "tillämpa mekaniska energisatsen på system med roterande delar"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0006T-7 a et:LearningOutcome ;
    rdfs:label "solve simple problems in special relativity"@en, "räkna på enkel speciell relativitetsteori"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0006T-8 a et:LearningOutcome ;
    rdfs:label "calculate the energies in radioactive decay and nuclear reactions"@en, "genomföra energiberäkningar för radioaktiva sönderfall och kärnreaktioner"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0006T-9 a et:LearningOutcome ;
    rdfs:label "present scientific results in a structured way"@en, "utarbeta en strukturerad rapport med vetenskapliga resultat"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0006T-10 a et:LearningOutcome ;
    rdfs:label "present your solutions in a comprehensible way"@en, "redovisa dina beräkningar på ett begripligt sätt"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0006T-11 a et:LearningOutcome ;
    rdfs:label "make simple group work in a group with different composition"@en, "göra ett enkelt grupparbete i en grupp med olika sammansättning"@sv ;
    et:outcomeCategory et:judgementAndApproach .

lo:F0006T-12 a et:LearningOutcome ;
    rdfs:label "discuss the nuclear question with regards to the technology, sustainability and environment"@en, "diskutera kärnkraftsfrågan såväl med hänsyn till teknik som hållbarhet och miljö"@sv ;
    et:outcomeCategory et:judgementAndApproach .

lo:F0006T-13 a et:LearningOutcome ;
    rdfs:label "superficially discuss and illustrate gender equality"@en, "översiktligt diskutera och illustrera jämställdhet"@sv ;
    et:outcomeCategory et:judgementAndApproach .

mod:F0006T-0007 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0007" ;
    et:credits 3.0 ;
    et:gradeScale "G U 3 4 5" .

mod:F0006T-0008 a et:Assessment ;
    rdfs:label "Assignment report"@en ;
    et:assessmentType et:assignment ;
    et:moduleCode "0008" ;
    et:credits 3.0 ;
    et:gradeScale "U G" .

mod:F0006T-0009 a et:Assessment ;
    rdfs:label "Laboratory, Mechanics"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0009" ;
    et:credits 0.5 ;
    et:gradeScale "U G" .

mod:F0006T-0010 a et:Assessment ;
    rdfs:label "Laboratory, Modern Physics"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0010" ;
    et:credits 1.0 ;
    et:gradeScale "U G" .


# --- F0007T Electromagnetic field theory ---

c:F0007T a et:Course ;
    schema:courseCode "F0007T" ;
    schema:name "Electromagnetic field theory"@en, "Elektromagnetisk fältteori"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and M0029M Calculus, M0030M Linear Algebra and Calculus, M0031M Linear Algebra and Differential Equations M0031M M0032M Functions of Several Variables and Computer Tools, M0018M Linear Analysis or equivalent courses where there mathematical analysis in several dimensions, and vector analysis are included."@en, "Grundläggande behörighet samt M0029M Differentialkalkyl, M0030M Linjär algebra och integralkalkyl, M0031M Linjär algebra och differentialekvationer, M0032M Flervariabelanalys och datorverktyg, M0018M Linjär analys. Andra matematikkurser där matematisk analys i flera dimensioner och vektoranalys ingår kan ersätta dessa kurser."@sv ;
    et:entryRequirementNames c:M0018M, c:M0029M, c:M0030M, c:M0031M, c:M0032M ;
    et:hasOutcome lo:F0007T-1, lo:F0007T-2, lo:F0007T-3, lo:F0007T-4, lo:F0007T-5, lo:F0007T-6, lo:F0007T-7, lo:F0007T-8, lo:F0007T-9, lo:F0007T-10, lo:F0007T-11, lo:F0007T-12 ;
    et:hasAssessment mod:F0007T-0004, mod:F0007T-0005 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F0007T> ;
    et:syllabusDecisionDate "2021-02-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0007T&lasPeriod=226&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0007T&lasPeriod=226> .

lo:F0007T-1 a et:LearningOutcome ;
    rdfs:label "Understand how electrostatic fields are generated and how the fields are affected by dielectric materials."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-2 a et:LearningOutcome ;
    rdfs:label "Understand how magnetostatic fields are generated and how the fields are affected by magnetic materials."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-3 a et:LearningOutcome ;
    rdfs:label "Understand the interaction between electric and magnetic fields: electromagnetism."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-4 a et:LearningOutcome ;
    rdfs:label "Describe and exemplify the limitations of the possibility of solving electromagnetic problems analytically."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-5 a et:LearningOutcome ;
    rdfs:label "Have insight into ongoing research and development work where electromagnetism is central."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-6 a et:LearningOutcome ;
    rdfs:label "2. Skill and ability Use vector analysis to solve electromagnetic problems."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-7 a et:LearningOutcome ;
    rdfs:label "Determine when electromagnetic problems can be solved using symmetry."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-8 a et:LearningOutcome ;
    rdfs:label "Apply electromagnetic problems in more complex geometry in a form suitable for numerical calculation."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-9 a et:LearningOutcome ;
    rdfs:label "Make appropriate approximations and assumptions with regard to the physics of the problems described."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-10 a et:LearningOutcome ;
    rdfs:label "3. Approach and ability to estimate Have trained the ability for practical problem solving."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-11 a et:LearningOutcome ;
    rdfs:label "Developed the ability to assess the reasonableness of achieved results linked to the electromagnetic theory."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0007T-12 a et:LearningOutcome ;
    rdfs:label "Knowledge of the need for knowledge in electromagnetism within one's own future professional discipline, and science and engineering in general."@en ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

mod:F0007T-0004 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0004" ;
    et:credits 6.0 ;
    et:gradeScale "G U 3 4 5" .

mod:F0007T-0005 a et:Assessment ;
    rdfs:label "Laboratory work/Written report"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0005" ;
    et:credits 1.5 ;
    et:gradeScale "U G" .


# --- F0008T Mechanics II ---

c:F0008T a et:Course ;
    schema:courseCode "F0008T" ;
    schema:name "Mechanics II"@en, "Mekanik II"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and and basic mechanics corresponding to the courses Physics 1 and 3 (F0004T and F0006T). Basic courses in calculus, algebra, analysis and ordinary differential equations corresponding to the courses M0047T, M0048M, M0049T, M0055M. Alternatively for the master programme in secondary education, teaching in the upper-secondary school."@en, "Grundläggande behörighet samt mekanik motsvarande innehållet i kurserna F0004T och F0006T. Grundläggande kurser i differentialkalkyl, linjär algebra och integralkalkyl, linjär algebra och differentialekvationer samt flervariabelanalys (M0047M ,M0048M, M0049M). Alternativt motsvarande matematik för ämneslärare matematik/fysik med inriktning mot gymnasieskolan."@sv ;
    et:entryRequirementNames c:F0004T, c:F0006T, c:M0047T, c:M0048M, c:M0049T, c:M0055M ;
    et:hasOutcome lo:F0008T-1, lo:F0008T-2, lo:F0008T-3, lo:F0008T-4, lo:F0008T-5, lo:F0008T-6, lo:F0008T-7, lo:F0008T-8, lo:F0008T-9, lo:F0008T-10, lo:F0008T-11, lo:F0008T-12, lo:F0008T-13, lo:F0008T-14, lo:F0008T-15 ;
    et:hasAssessment mod:F0008T-0004, mod:F0008T-0006 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F0008T> ;
    et:syllabusDecisionDate "2025-06-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0008T&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0008T&lasPeriod=227> .

lo:F0008T-1 a et:LearningOutcome ;
    rdfs:label "The content of the course is a continuation of the basic courses in mechanics and aims for students to further broaden and deepen their knowledge of classical mechanics, which also becomes a base for further studies in physics. It also includes alternative methods within classical mechanics. After passing this course the student can:"@en, "Innehållet i kursen är en direkt fortsättning på tidigare mekanik och syftar till att studenten ytterligare ska bredda och fördjupa sina kunskaper i klassisk mekanik, vilket också blir en bas för vidare studier i fysik. Kursen har stort fokus på problemlösning. Den behandlar även alternativa metoder inom den klassiska mekaniken. Efter genomgången kurs kan studenten:"@sv .

lo:F0008T-2 a et:LearningOutcome ;
    rdfs:label "describe and express the conditions for body equilibrium in three dimensions."@en, "beskriva och formulera villkoren för kroppars jämvikt i tre dimensioner."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0008T-3 a et:LearningOutcome ;
    rdfs:label "account for concepts and explain basic concepts and laws within three-dimensional classical particle and rigid dynamics."@en, "redogöra för begrepp samt förklara och illustrera lagar inom tredimensionell klassisk partikel- och stelkroppsdynamik."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0008T-4 a et:LearningOutcome ;
    rdfs:label "explain inertial forces and describe when they occur."@en, "förklara vad tröghetskrafter är och redogöra för när sådana uppkommer."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0008T-5 a et:LearningOutcome ;
    rdfs:label "account for systems undergoing damped and forced vibrations, explain resonance and exemplify its consequences."@en, "redogöra för dämpade, tvungna och kopplade svängningar samt förklara vad resonans innebär och ge exempel på konsekvenser det kan få."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0008T-6 a et:LearningOutcome ;
    rdfs:label "describe analytical mechanics as an alternative method to Newton's laws, can elucidate basic concepts and account for Lagrange's and Hamilton's equations."@en, "beskriva analytisk mekanik som en alternativ metod till Newtons lagar och förklara grundläggande begrepp samt redogöra för Lagranges och Hamiltons ekvationer."@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0008T-7 a et:LearningOutcome ;
    rdfs:label "determine the conditions for force equilibrium of bodies in three dimensions."@en, "bestämma villkoren på krafter för kroppars jämvikt i tre dimensioner."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0008T-8 a et:LearningOutcome ;
    rdfs:label "solve problems with movement of bodies in three dimensions i.e. make calculations based on translating, accelerating and rotating coordinate systems, use Newton's laws, central-force motion, energy methods, momentum, inertial matrix, Euler's equations for gyroscopic motion and analyze damped, forced and coupled oscillations."@en, "lösa problemställningar för kroppars rörelse i tre dimensioner d.v.s. beräkna rörelse och göra beräkningar utifrån translaterande, accelererande och roterande koordinatsystem; använda Newtons lagar; centralkraftsrörelse; energimetoder; rörelsemängdsmoment; tröghetsmatrisen; Eulers ekvationer för gyroskopisk rörelse samt analysera dämpade, tvungna och kopplade svängningar."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0008T-9 a et:LearningOutcome ;
    rdfs:label "calculate dynamic forces in rotating mechanical systems due to dynamic imbalance and determine how these can be reduced by balancing."@en, "beräkna krafter som uppstår i enkla roterande mekaniska system p.g.a. dynamisk obalans och bestämma hur dessa kan minskas genom balansering."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0008T-10 a et:LearningOutcome ;
    rdfs:label "solve dynamic problems for particles and rigid bodies using analytical mechanics:"@en, "lösa dynamikproblem för partiklar och stela kroppar med användande av analytisk mekanik:"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0008T-11 a et:LearningOutcome ;
    rdfs:label "a) formulate Lagrange and Hamilton's functions for different physical situations; b) formulate theoretical models with the Lagrange function and the Hamilton function; c) derive the equations of motion and solve Euler-Lagrange's equations for mechanical systems with one or more generalized coordinates. solve somewhat more complicated technical dynamics problems, analytically and numerically."@en, "a) formulera Lagrange och Hamiltons funktioner för olika fysikaliska situationer; b) formulera teoretiska modeller med lagrangefunktionen och hamiltonfunktionen; c) ställa upp rörelseekvationerna och lösa Euler-Lagranges ekvationer för mekaniska system med en eller flera generaliserade koordinater. lösa mer avancerade dynamikproblem analytiskt och numeriskt."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0008T-12 a et:LearningOutcome ;
    rdfs:label "summarize, present and communicate calculations and conclusions in writing and/or orally in a clear and easily understandable manner."@en, "sammanfatta, presentera och kommunicera beräkningar och slutsatser skriftligt och/eller muntligt så det är lätt att följa."@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0008T-13 a et:LearningOutcome ;
    rdfs:label "clarify restraints in analytical models of real mechanical systems and decide when numerical methods need to be used."@en, "klargöra begränsningar i analytiska modeller av verkliga mekaniska system och avgöra när numeriska metoder behöver användas."@sv ;
    et:outcomeCategory et:judgementAndApproach .

lo:F0008T-14 a et:LearningOutcome ;
    rdfs:label "critically review calculations and simulations of dynamics problems, interpret results, draw conclusions on plausibility and compare methods."@en, "kritiskt granska beräkningar och simuleringar av dynamikproblem, tolka resultat, dra slutsatser om rimlighet och jämföra metoder."@sv ;
    et:outcomeCategory et:judgementAndApproach .

lo:F0008T-15 a et:LearningOutcome ;
    rdfs:label "use a scientific approach to argue on calculations and results, relate to engineering applications as well."@en, "med ett naturvetenskapligt förhållningssätt, argumentera om resultat och beräkningar är rimliga och kan anknyta till ingenjörsmässiga tillämpningar."@sv ;
    et:outcomeCategory et:judgementAndApproach .

mod:F0008T-0004 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0004" ;
    et:credits 6.0 ;
    et:gradeScale "G U 3 4 5" .

mod:F0008T-0006 a et:Assessment ;
    rdfs:label "Laboratory work and course assignment"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0006" ;
    et:credits 1.5 ;
    et:gradeScale "U G" .


# --- F0030T Continuum Mechanics ---

c:F0030T a et:Course ;
    schema:courseCode "F0030T" ;
    schema:name "Continuum Mechanics"@en, "Kontinuumsmekanik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:engineering-mechanics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and M0029M Calculus,M0030M Linear Algebra and Calculus, M0031M Linear Algebra and Differential Equations. Vector calculus from M0032M Functions of Several Variables and Computer Tools , Mechanics from F0004T Physics 1 and F0006T Physics 3 or equivalent."@en, "Grundläggande behörighet samt Grundläggande kunskaper i matematik: M0029M Differentialkalkyl, M0030M Linjär algebra och integralkalkyl samt M0031M Linjär algebra och differentialekvationer. Vektoranalys i M0032M Flervariabelanalys och datorverktyg, Mekanik i F0004T Fysik 1 och F0006T Fysik 3 eller motsvarande"@sv ;
    et:entryRequirementNames c:F0004T, c:F0006T, c:M0029M, c:M0030M, c:M0031M, c:M0032M ;
    et:hasOutcome lo:F0030T-1, lo:F0030T-2, lo:F0030T-3, lo:F0030T-4, lo:F0030T-5, lo:F0030T-6, lo:F0030T-7 ;
    et:hasAssessment mod:F0030T-0003, mod:F0030T-0004 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F0030T> ;
    et:syllabusDecisionDate "2021-02-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0030T&lasPeriod=227&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0030T&lasPeriod=227> .

lo:F0030T-1 a et:LearningOutcome ;
    rdfs:label "describe basic physical concepts in continuum mechanics"@en, "Efter avslutad kurs ska studenten kunna 1. Kunskap och förmåga beskriva grundläggande fysikaliska begrepp inom kontinuumsmekanik"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0030T-2 a et:LearningOutcome ;
    rdfs:label "account for derivations of e.g. continuity and momentum equations as well as constitutive relationships"@en, "redogöra för härledningar av ex. kontinuitets- och rörelsemängdsekvationer samt konstitutiva samband"@sv ;
    et:outcomeCategory et:knowledgeAndUnderstanding .

lo:F0030T-3 a et:LearningOutcome ;
    rdfs:label "use basic theoretical methods for analysis in solid and fluid mechanics"@en, "2. Färdighet och förståelse använda grundläggande teoretiska metoder för analys inom solid- och fluidmekanik"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0030T-4 a et:LearningOutcome ;
    rdfs:label "apply these methods to technically important cases such as bending of beams and pipe flow"@en, "tillämpa dessa metoder på tekniskt viktiga fall såsom balkböjning och rörströmning"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0030T-5 a et:LearningOutcome ;
    rdfs:label "carry out measurements with the aim of 1) investigating the relationship between strain and tension with the aid of strain sensors; 2) connect phenomena in pipe flow to measurable quantities such as pressure drop and flow"@en, "genomföra mätningar med syfte att att 1) undersöka samband mellan töjning och spänning med hjälp av töjningsgivare; 2) koppla fenomen inom rörströmning till mätbara storheter såsom tryckfall och flöde"@sv ;
    et:outcomeCategory et:skillsAndAbilities .

lo:F0030T-6 a et:LearningOutcome ;
    rdfs:label "identify relevant phenomena, boundary conditions, methods and limitations for calculations in continuum mechanics and, based on given conditions, evaluate and interpret the result."@en, "identifiera fenomen, randvillkor, metoder och begränsningar för beräkningar inom kontinuumsmekanik samt utifrån givna förutsättningar utvärdera och tolka resultat."@sv ;
    et:outcomeCategory et:judgementAndApproach .

lo:F0030T-7 a et:LearningOutcome ;
    rdfs:label "The purpose of the learning objectives is to prepare the student with basic theoretical knowledge for future studies and work linked to analytical methods, numerical methods (eg FEM and CFD) and experimental analysis in solid and fluid mechanics."@en, "Syftet med lärandemålen är att genom grundläggande teoretisk kunskap förbereda studenten inför framtida studier och arbete kopplat till analytiska metoder, numeriska metoder (ex. FEM och CFD) och experimentell analys inom hållfasthetslära och strömningsmekanik."@sv ;
    et:outcomeCategory et:judgementAndApproach .

mod:F0030T-0003 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0003" ;
    et:credits 6.9 ;
    et:gradeScale "G U 3 4 5" .

mod:F0030T-0004 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0004" ;
    et:credits 0.6 ;
    et:gradeScale "U G" .


# --- F0047T Quantum Physics ---

c:F0047T a et:Course ;
    schema:courseCode "F0047T" ;
    schema:name "Quantum Physics"@en, "Kvantfysik"@sv ;
    et:credits 7.5 ;
    schema:provider ltu:org-ltu ;
    et:cycle et:firstCycle ;
    et:subject subj:physics ;
    schema:coursePrerequisites "In order to meet the general entry requirements for first cycle studies you must have successfully completed upper secondary education and documented skills in English language and Basic course in Modern physics, mechanics (oscillatory and angular momentum in three dimensions) , linear algebra, analysis and ordinary and partiall differential equations (separable) and beeing able to write simple computer program in matlab or c. Courses that provide this are: D0009E, F0008T, F0007T, M0032M, M0018M, M0014M."@en, "Grundläggande behörighet samt Grundkurser i modern fysik, mekanik (svängningsrörelse och rörelsemängdsmoment i 3 dimensioner) F0008T, lineär algebra, analys, ordinära och partiella differentialekvationer (separabla) samt kunna skriva enklare datorprogram i tex matlab eller c. Kurser som ger detta är: D0009E, F0008T, F0007T, M0032M, M0018M, M0014M."@sv ;
    et:entryRequirementNames c:D0009E, c:F0007T, c:F0008T, c:M0014M, c:M0018M, c:M0032M ;
    et:hasOutcome lo:F0047T-1, lo:F0047T-2, lo:F0047T-3, lo:F0047T-4, lo:F0047T-5, lo:F0047T-6, lo:F0047T-7, lo:F0047T-8, lo:F0047T-9 ;
    et:hasAssessment mod:F0047T-0002, mod:F0047T-0003 ;
    schema:url <https://www.ltu.se/utbildning/utbildningsplan-och-kursplan/kursplan?id=F0047T> ;
    et:syllabusDecisionDate "2021-02-17"^^xsd:date ;
    prov:wasDerivedFrom <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0047T&lasPeriod=224&locale=en>, <https://epok.ltu.se/epok/dynpdf/public/kursplan/downloadPublicKursplan.pdf?kursKod=F0047T&lasPeriod=224> .

lo:F0047T-1 a et:LearningOutcome ;
    rdfs:label "After the course, the student should be able to understand and apply: The motivation for quantum mechanics in modern physics."@en .

lo:F0047T-2 a et:LearningOutcome ;
    rdfs:label "The foundations of quantum mechanics."@en .

lo:F0047T-3 a et:LearningOutcome ;
    rdfs:label "Wave-particle dualism, wave packet, probability interpretation, Heisenberg uncertanty relations."@en .

lo:F0047T-4 a et:LearningOutcome ;
    rdfs:label "Operators, eigenvalues and expectationvalues."@en .

lo:F0047T-5 a et:LearningOutcome ;
    rdfs:label "Understand and calculate properties of quantum mechanical systems and processes."@en .

lo:F0047T-6 a et:LearningOutcome ;
    rdfs:label "Angular momentum and central motion."@en .

lo:F0047T-7 a et:LearningOutcome ;
    rdfs:label "Hydrogen atom and spin."@en .

lo:F0047T-8 a et:LearningOutcome ;
    rdfs:label "Perturbation calculations."@en .

lo:F0047T-9 a et:LearningOutcome ;
    rdfs:label "Spectra of atoms and molecules."@en .

mod:F0047T-0002 a et:Assessment ;
    rdfs:label "Laboratory work"@en ;
    et:assessmentType et:labWork ;
    et:moduleCode "0002" ;
    et:credits 1.0 ;
    et:gradeScale "U G#" .

mod:F0047T-0003 a et:Assessment ;
    rdfs:label "Written exam"@en ;
    et:assessmentType et:writtenExam ;
    et:moduleCode "0003" ;
    et:credits 6.5 ;
    et:gradeScale "G U 3 4 5" .


